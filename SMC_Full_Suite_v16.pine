//@version=5
indicator("SMC v16.4 — Tiered Signals + Chop Filter + Dashboard + ★★★ Quality", overlay=true, max_boxes_count=500, max_lines_count=200, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
//  v16.2 — Tiered signal system. Every quality combination is independently
//          toggleable so you choose what gets shown.
//
//  ★★★ PREMIUM   : zone reaction + EMA trend aligned + fresh + body
//                  (rare, highest-quality A+ setups)
//  ★★  REVERSAL  : zone reaction + recent liquidity sweep + body
//                  (counter-trend SMC liquidity grabs)
//  ★   LOOSE     : zone reaction + body only
//                  (frequent, no trend/freshness/sweep filter — for scalping)
//
//  Each tier renders with a distinct marker style. Per-zone (OB/BB/RB/FVG/IFVG)
//  and per-direction (longs/shorts) toggles act on top of tier selection.
// ══════════════════════════════════════════════════════════════════════════════

// ── INPUTS ────────────────────────────────────────────────────────────────────

grpOB = "🟦 Order Blocks"
showOB      = input.bool(true,  "Show Order Blocks",      group=grpOB)
obLookback  = input.int(5,      "Swing Lookback",         group=grpOB, minval=3, maxval=30)
obMaxBoxes  = input.int(4,      "Max OBs per side",       group=grpOB, minval=1, maxval=10)
obHideMitig = input.bool(true,  "Hide Mitigated OBs",     group=grpOB)
obMitigMode = input.string("Close", "Mitigation by", group=grpOB, options=["Wick","Close"])
obBullColor = input.color(color.new(#2962FF, 75), "Bull OB", group=grpOB)
obBearColor = input.color(color.new(#F23645, 75), "Bear OB", group=grpOB)

grpBB = "🔴 Breaker Blocks"
showBB      = input.bool(true,  "Show Breaker Blocks",    group=grpBB)
bbMaxBoxes  = input.int(3,      "Max BBs per side",       group=grpBB, minval=1, maxval=10)
bbBullColor = input.color(color.new(#26A69A, 70), "Bull BB", group=grpBB)
bbBearColor = input.color(color.new(#EF5350, 70), "Bear BB", group=grpBB)

grpRB = "🟣 Rejection Blocks"
showRB      = input.bool(true,  "Show Rejection Blocks",  group=grpRB)
rbWickRatio = input.float(0.6,  "Min Wick/Range Ratio",   group=grpRB, minval=0.4, maxval=0.9, step=0.05)
rbMaxBoxes  = input.int(3,      "Max RBs per side",       group=grpRB, minval=1, maxval=10)
rbHideMitig = input.bool(true,  "Hide Mitigated RBs",     group=grpRB)
rbBullColor = input.color(color.new(#00BCD4, 70), "Bull RB", group=grpRB)
rbBearColor = input.color(color.new(#FF6D00, 70), "Bear RB", group=grpRB)

grpFVG = "🟩 Fair Value Gaps"
showFVG     = input.bool(true,  "Show FVGs",              group=grpFVG)
fvgMinSize  = input.float(0.05, "Min Gap % (0=any)",      group=grpFVG, minval=0.0, maxval=2.0, step=0.01)
fvgMaxBoxes = input.int(4,      "Max FVGs per side",      group=grpFVG, minval=1, maxval=10)
showFVGMid  = input.bool(false, "Show Midline",           group=grpFVG)
fvgBullColor= input.color(color.new(#00C853, 80), "Bull FVG", group=grpFVG)
fvgBearColor= input.color(color.new(#FF1744, 80), "Bear FVG", group=grpFVG)

grpIFVG = "🟧 Inverse FVGs"
showIFVG     = input.bool(true,  "Show IFVGs",            group=grpIFVG)
ifvgStrict   = input.bool(true,  "Require Close Inside",  group=grpIFVG)
ifvgMaxBoxes = input.int(3,      "Max IFVGs per side",    group=grpIFVG, minval=1, maxval=10)
ifvgBullColor= input.color(color.new(#FF6D00, 80), "Bull IFVG", group=grpIFVG)
ifvgBearColor= input.color(color.new(#AA00FF, 80), "Bear IFVG", group=grpIFVG)

grpEMA = "📉 EMA"
showEMA     = input.bool(true,  "Show EMA",               group=grpEMA)
emaLength   = input.int(200,    "EMA Length",             group=grpEMA, minval=10, maxval=500)
emaColor    = input.color(color.new(color.yellow, 30), "EMA Color", group=grpEMA)
emaWidth    = input.int(2,      "EMA Width",              group=grpEMA, minval=1, maxval=4)

grpDisp = "⚙️ Display"
extendBoxes = input.bool(true,  "Extend Boxes to Right",  group=grpDisp)
proxEnable  = input.bool(true,  "Hide Distant Zones",     group=grpDisp)
proxPct     = input.float(2.0,  "Max Distance from Price (%)", group=grpDisp, minval=0.5, maxval=10.0, step=0.5)

grpLbl = "🏷️ Labels (per type)"
showOBLabels   = input.bool(true,  "Show OB labels",   group=grpLbl)
showBBLabels   = input.bool(true,  "Show BB labels",   group=grpLbl)
showRBLabels   = input.bool(true,  "Show RB labels",   group=grpLbl)
showFVGLabels  = input.bool(false, "Show FVG labels",  group=grpLbl)
showIFVGLabels = input.bool(false, "Show IFVG labels", group=grpLbl)

// ── HELPERS ───────────────────────────────────────────────────────────────────

extRight    = extendBoxes ? extend.right : extend.none
candleRange = high - low
bodyHigh    = math.max(open, close)
bodyLow     = math.min(open, close)
upperWick   = high - bodyHigh
lowerWick   = bodyLow - low

zoneNear(zH, zL) =>
    if not proxEnable
        true
    else
        midZ = math.avg(zH, zL)
        math.abs(close - midZ) / close * 100.0 <= proxPct

// ── EMA ───────────────────────────────────────────────────────────────────────

ema = ta.ema(close, emaLength)
plot(showEMA ? ema : na, "EMA", color=emaColor, linewidth=emaWidth)

// ── BOS DETECTION (needed for OB/BB) ──────────────────────────────────────────

ph = ta.pivothigh(high, obLookback, obLookback)
pl = ta.pivotlow(low,   obLookback, obLookback)

var float lastPH = na
var float lastPL = na

if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl

bullBOS = not na(lastPH) and close > lastPH and close[1] <= lastPH
bearBOS = not na(lastPL) and close < lastPL and close[1] >= lastPL

if bullBOS
    lastPH := na
if bearBOS
    lastPL := na

// Track when each side's BOS most recently fired (used by ★★★ quality filter)
var int lastBullBOSBar = -9999
var int lastBearBOSBar = -9999
if bullBOS
    lastBullBOSBar := bar_index
if bearBOS
    lastBearBOSBar := bar_index

// ══════════════════════════════════════════════════════════════════════════════
//  ORDER BLOCKS
// ══════════════════════════════════════════════════════════════════════════════

var obBullBoxes = array.new_box()
var obBullMitig = array.new_bool()
var obBullHi    = array.new_float()
var obBullLo    = array.new_float()

var obBearBoxes = array.new_box()
var obBearMitig = array.new_bool()
var obBearHi    = array.new_float()
var obBearLo    = array.new_float()

if showOB and bullBOS
    obIdx = 1
    for k = 1 to math.min(obLookback * 2, 50)
        if close[k] < open[k]
            obIdx := k
            break
    oH = high[obIdx]
    oL = low[obIdx]
    oB = bar_index - obIdx
    while array.size(obBullBoxes) >= obMaxBoxes
        box.delete(array.shift(obBullBoxes))
        array.shift(obBullMitig)
        array.shift(obBullHi)
        array.shift(obBullLo)
    b = box.new(oB, oH, bar_index, oL, bgcolor=obBullColor, border_color=obBullColor, extend=extRight)
    array.push(obBullBoxes, b)
    array.push(obBullMitig, false)
    array.push(obBullHi, oH)
    array.push(obBullLo, oL)
    if showOBLabels
        label.new(oB, oH, "OB", style=label.style_label_down, color=obBullColor, textcolor=color.white, size=size.tiny)

if showOB and bearBOS
    obIdx = 1
    for k = 1 to math.min(obLookback * 2, 50)
        if close[k] > open[k]
            obIdx := k
            break
    oH = high[obIdx]
    oL = low[obIdx]
    oB = bar_index - obIdx
    while array.size(obBearBoxes) >= obMaxBoxes
        box.delete(array.shift(obBearBoxes))
        array.shift(obBearMitig)
        array.shift(obBearHi)
        array.shift(obBearLo)
    b = box.new(oB, oH, bar_index, oL, bgcolor=obBearColor, border_color=obBearColor, extend=extRight)
    array.push(obBearBoxes, b)
    array.push(obBearMitig, false)
    array.push(obBearHi, oH)
    array.push(obBearLo, oL)
    if showOBLabels
        label.new(oB, oL, "OB", style=label.style_label_up, color=obBearColor, textcolor=color.white, size=size.tiny)

// OB Mitigation
if showOB and array.size(obBullBoxes) > 0
    for i = 0 to array.size(obBullBoxes) - 1
        if not array.get(obBullMitig, i)
            mp = obMitigMode == "Wick" ? low : close
            if mp < array.get(obBullLo, i)
                if obHideMitig
                    box.delete(array.get(obBullBoxes, i))
                array.set(obBullMitig, i, true)

if showOB and array.size(obBearBoxes) > 0
    for i = 0 to array.size(obBearBoxes) - 1
        if not array.get(obBearMitig, i)
            mp = obMitigMode == "Wick" ? high : close
            if mp > array.get(obBearHi, i)
                if obHideMitig
                    box.delete(array.get(obBearBoxes, i))
                array.set(obBearMitig, i, true)

// ══════════════════════════════════════════════════════════════════════════════
//  BREAKER BLOCKS (from mitigated OBs)
// ══════════════════════════════════════════════════════════════════════════════

var bbBullBoxes = array.new_box()
var bbBullHi    = array.new_float()
var bbBullLo    = array.new_float()
var bbBullMitig = array.new_bool()
var bbBearBoxes = array.new_box()
var bbBearHi    = array.new_float()
var bbBearLo    = array.new_float()
var bbBearMitig = array.new_bool()

var bbBearSpawnedH = array.new_float()
var bbBullSpawnedH = array.new_float()

_alreadySpawned(arr, oH) =>
    found = false
    if array.size(arr) > 0
        for k = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, k) - oH) / oH < 0.0005
                found := true
                break
    found

if showBB and showOB
    if array.size(obBullBoxes) > 0
        for i = 0 to array.size(obBullBoxes) - 1
            if array.get(obBullMitig, i)
                oH = array.get(obBullHi, i)
                oL = array.get(obBullLo, i)
                if not _alreadySpawned(bbBearSpawnedH, oH)
                    while array.size(bbBearBoxes) >= bbMaxBoxes
                        box.delete(array.shift(bbBearBoxes))
                        array.shift(bbBearHi)
                        array.shift(bbBearLo)
                        array.shift(bbBearMitig)
                    bx = box.new(bar_index - 1, oH, bar_index, oL, bgcolor=bbBearColor, border_color=bbBearColor, extend=extRight)
                    array.push(bbBearBoxes, bx)
                    array.push(bbBearHi, oH)
                    array.push(bbBearLo, oL)
                    array.push(bbBearMitig, false)
                    array.push(bbBearSpawnedH, oH)
                    if showBBLabels
                        label.new(bar_index, oH, "BB", style=label.style_label_down, color=bbBearColor, textcolor=color.white, size=size.tiny)

    if array.size(obBearBoxes) > 0
        for i = 0 to array.size(obBearBoxes) - 1
            if array.get(obBearMitig, i)
                oH = array.get(obBearHi, i)
                oL = array.get(obBearLo, i)
                if not _alreadySpawned(bbBullSpawnedH, oH)
                    while array.size(bbBullBoxes) >= bbMaxBoxes
                        box.delete(array.shift(bbBullBoxes))
                        array.shift(bbBullHi)
                        array.shift(bbBullLo)
                        array.shift(bbBullMitig)
                    bx = box.new(bar_index - 1, oH, bar_index, oL, bgcolor=bbBullColor, border_color=bbBullColor, extend=extRight)
                    array.push(bbBullBoxes, bx)
                    array.push(bbBullHi, oH)
                    array.push(bbBullLo, oL)
                    array.push(bbBullMitig, false)
                    array.push(bbBullSpawnedH, oH)
                    if showBBLabels
                        label.new(bar_index, oL, "BB", style=label.style_label_up, color=bbBullColor, textcolor=color.white, size=size.tiny)

// BB Mitigation
if showBB and array.size(bbBullBoxes) > 0
    for i = 0 to array.size(bbBullBoxes) - 1
        if not array.get(bbBullMitig, i)
            if close < array.get(bbBullLo, i)
                box.delete(array.get(bbBullBoxes, i))
                array.set(bbBullMitig, i, true)

if showBB and array.size(bbBearBoxes) > 0
    for i = 0 to array.size(bbBearBoxes) - 1
        if not array.get(bbBearMitig, i)
            if close > array.get(bbBearHi, i)
                box.delete(array.get(bbBearBoxes, i))
                array.set(bbBearMitig, i, true)

// ══════════════════════════════════════════════════════════════════════════════
//  REJECTION BLOCKS (long-wick rejections at swing pivots)
// ══════════════════════════════════════════════════════════════════════════════

isBullRB = not na(lastPL) and low < lastPL and close > lastPL and candleRange > 0 and (lowerWick / candleRange >= rbWickRatio)
isBearRB = not na(lastPH) and high > lastPH and close < lastPH and candleRange > 0 and (upperWick / candleRange >= rbWickRatio)

var rbBullBoxes = array.new_box()
var rbBullMitig = array.new_bool()
var rbBullHi    = array.new_float()
var rbBullLo    = array.new_float()

var rbBearBoxes = array.new_box()
var rbBearMitig = array.new_bool()
var rbBearHi    = array.new_float()
var rbBearLo    = array.new_float()

if showRB and isBullRB
    while array.size(rbBullBoxes) >= rbMaxBoxes
        box.delete(array.shift(rbBullBoxes))
        array.shift(rbBullMitig)
        array.shift(rbBullHi)
        array.shift(rbBullLo)
    b = box.new(bar_index - 1, high, bar_index, low, bgcolor=rbBullColor, border_color=rbBullColor, extend=extRight)
    array.push(rbBullBoxes, b)
    array.push(rbBullMitig, false)
    array.push(rbBullHi, high)
    array.push(rbBullLo, low)
    if showRBLabels
        label.new(bar_index, low, "RB", style=label.style_label_up, color=rbBullColor, textcolor=color.white, size=size.tiny)

if showRB and isBearRB
    while array.size(rbBearBoxes) >= rbMaxBoxes
        box.delete(array.shift(rbBearBoxes))
        array.shift(rbBearMitig)
        array.shift(rbBearHi)
        array.shift(rbBearLo)
    b = box.new(bar_index - 1, high, bar_index, low, bgcolor=rbBearColor, border_color=rbBearColor, extend=extRight)
    array.push(rbBearBoxes, b)
    array.push(rbBearMitig, false)
    array.push(rbBearHi, high)
    array.push(rbBearLo, low)
    if showRBLabels
        label.new(bar_index, high, "RB", style=label.style_label_down, color=rbBearColor, textcolor=color.white, size=size.tiny)

if showRB and array.size(rbBullBoxes) > 0
    for i = 0 to array.size(rbBullBoxes) - 1
        if not array.get(rbBullMitig, i)
            if close < array.get(rbBullLo, i)
                if rbHideMitig
                    box.delete(array.get(rbBullBoxes, i))
                array.set(rbBullMitig, i, true)

if showRB and array.size(rbBearBoxes) > 0
    for i = 0 to array.size(rbBearBoxes) - 1
        if not array.get(rbBearMitig, i)
            if close > array.get(rbBearHi, i)
                if rbHideMitig
                    box.delete(array.get(rbBearBoxes, i))
                array.set(rbBearMitig, i, true)

// ══════════════════════════════════════════════════════════════════════════════
//  FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════════════════════

minGapVal = close * fvgMinSize / 100.0
isBullFVG = (low - high[2]) > minGapVal
isBearFVG = (low[2] - high) > minGapVal

var fvgBullBoxes = array.new_box()
var fvgBullLines = array.new_line()
var fvgBullTop   = array.new_float()
var fvgBullBot   = array.new_float()
var fvgBullDead  = array.new_bool()

var fvgBearBoxes = array.new_box()
var fvgBearLines = array.new_line()
var fvgBearTop   = array.new_float()
var fvgBearBot   = array.new_float()
var fvgBearDead  = array.new_bool()

if showFVG and isBullFVG
    while array.size(fvgBullBoxes) >= fvgMaxBoxes
        box.delete(array.shift(fvgBullBoxes))
        if array.size(fvgBullLines) > 0
            line.delete(array.shift(fvgBullLines))
        array.shift(fvgBullTop)
        array.shift(fvgBullBot)
        array.shift(fvgBullDead)
    gT = low
    gB = high[2]
    bx = box.new(bar_index[2], gT, bar_index, gB, bgcolor=fvgBullColor, border_color=fvgBullColor, extend=extRight)
    array.push(fvgBullBoxes, bx)
    array.push(fvgBullTop, gT)
    array.push(fvgBullBot, gB)
    array.push(fvgBullDead, false)
    if showFVGMid
        l = line.new(bar_index[2], math.avg(gT, gB), bar_index, math.avg(gT, gB), color=color.new(color.white, 60), style=line.style_dashed, extend=extRight)
        array.push(fvgBullLines, l)
    if showFVGLabels
        label.new(bar_index, gB, "FVG", style=label.style_label_up, color=fvgBullColor, textcolor=color.white, size=size.tiny)

if showFVG and isBearFVG
    while array.size(fvgBearBoxes) >= fvgMaxBoxes
        box.delete(array.shift(fvgBearBoxes))
        if array.size(fvgBearLines) > 0
            line.delete(array.shift(fvgBearLines))
        array.shift(fvgBearTop)
        array.shift(fvgBearBot)
        array.shift(fvgBearDead)
    gT = low[2]
    gB = high
    bx = box.new(bar_index[2], gT, bar_index, gB, bgcolor=fvgBearColor, border_color=fvgBearColor, extend=extRight)
    array.push(fvgBearBoxes, bx)
    array.push(fvgBearTop, gT)
    array.push(fvgBearBot, gB)
    array.push(fvgBearDead, false)
    if showFVGMid
        l = line.new(bar_index[2], math.avg(gT, gB), bar_index, math.avg(gT, gB), color=color.new(color.white, 60), style=line.style_dashed, extend=extRight)
        array.push(fvgBearLines, l)
    if showFVGLabels
        label.new(bar_index, gT, "FVG", style=label.style_label_down, color=fvgBearColor, textcolor=color.white, size=size.tiny)

// FVG mitigation
if showFVG and array.size(fvgBullBoxes) > 0
    idxR = array.size(fvgBullBoxes) - 1
    while idxR >= 0
        if not array.get(fvgBullDead, idxR)
            gB = array.get(fvgBullBot, idxR)
            if close < gB and open < gB
                box.delete(array.get(fvgBullBoxes, idxR))
                if idxR < array.size(fvgBullLines)
                    line.delete(array.get(fvgBullLines, idxR))
                array.set(fvgBullDead, idxR, true)
        idxR -= 1

if showFVG and array.size(fvgBearBoxes) > 0
    idxR = array.size(fvgBearBoxes) - 1
    while idxR >= 0
        if not array.get(fvgBearDead, idxR)
            gT = array.get(fvgBearTop, idxR)
            if close > gT and open > gT
                box.delete(array.get(fvgBearBoxes, idxR))
                if idxR < array.size(fvgBearLines)
                    line.delete(array.get(fvgBearLines, idxR))
                array.set(fvgBearDead, idxR, true)
        idxR -= 1

// ══════════════════════════════════════════════════════════════════════════════
//  INVERSE FVGs
// ══════════════════════════════════════════════════════════════════════════════

var pendBullTop = array.new_float()
var pendBullBot = array.new_float()
var pendBullBar = array.new_int()
var pendBearTop = array.new_float()
var pendBearBot = array.new_float()
var pendBearBar = array.new_int()
var ifvgBullBoxes = array.new_box()
var ifvgBullTop   = array.new_float()
var ifvgBullBot   = array.new_float()
var ifvgBearBoxes = array.new_box()
var ifvgBearTop   = array.new_float()
var ifvgBearBot   = array.new_float()

MAX_PEND = ifvgMaxBoxes * 2

if showIFVG
    if isBullFVG
        if array.size(pendBullTop) >= MAX_PEND
            array.shift(pendBullTop)
            array.shift(pendBullBot)
            array.shift(pendBullBar)
        array.push(pendBullTop, low)
        array.push(pendBullBot, high[2])
        array.push(pendBullBar, bar_index[2])

    if isBearFVG
        if array.size(pendBearTop) >= MAX_PEND
            array.shift(pendBearTop)
            array.shift(pendBearBot)
            array.shift(pendBearBar)
        array.push(pendBearTop, low[2])
        array.push(pendBearBot, high)
        array.push(pendBearBar, bar_index[2])

    idx = 0
    while idx < array.size(pendBullTop)
        t  = array.get(pendBullTop, idx)
        b2 = array.get(pendBullBot, idx)
        sB = array.get(pendBullBar, idx)
        hit = ifvgStrict ? (close <= t and close >= b2) : (low <= t and high >= b2)
        if hit
            while array.size(ifvgBullBoxes) >= ifvgMaxBoxes
                box.delete(array.shift(ifvgBullBoxes))
                array.shift(ifvgBullTop)
                array.shift(ifvgBullBot)
            array.push(ifvgBullBoxes, box.new(sB, t, bar_index, b2, bgcolor=ifvgBullColor, border_color=ifvgBullColor, extend=extRight))
            array.push(ifvgBullTop, t)
            array.push(ifvgBullBot, b2)
            if showIFVGLabels
                label.new(bar_index, b2, "IFVG", style=label.style_label_up, color=ifvgBullColor, textcolor=color.white, size=size.tiny)
            array.remove(pendBullTop, idx)
            array.remove(pendBullBot, idx)
            array.remove(pendBullBar, idx)
        else
            idx += 1

    idx2 = 0
    while idx2 < array.size(pendBearTop)
        t  = array.get(pendBearTop, idx2)
        b2 = array.get(pendBearBot, idx2)
        sB = array.get(pendBearBar, idx2)
        hit = ifvgStrict ? (close <= t and close >= b2) : (low <= t and high >= b2)
        if hit
            while array.size(ifvgBearBoxes) >= ifvgMaxBoxes
                box.delete(array.shift(ifvgBearBoxes))
                array.shift(ifvgBearTop)
                array.shift(ifvgBearBot)
            array.push(ifvgBearBoxes, box.new(sB, t, bar_index, b2, bgcolor=ifvgBearColor, border_color=ifvgBearColor, extend=extRight))
            array.push(ifvgBearTop, t)
            array.push(ifvgBearBot, b2)
            if showIFVGLabels
                label.new(bar_index, t, "IFVG", style=label.style_label_down, color=ifvgBearColor, textcolor=color.white, size=size.tiny)
            array.remove(pendBearTop, idx2)
            array.remove(pendBearBot, idx2)
            array.remove(pendBearBar, idx2)
        else
            idx2 += 1

// IFVG mitigation
if showIFVG and array.size(ifvgBullBoxes) > 0
    idxR = array.size(ifvgBullBoxes) - 1
    while idxR >= 0
        gB = array.get(ifvgBullBot, idxR)
        if close < gB and open < gB
            box.delete(array.get(ifvgBullBoxes, idxR))
            array.remove(ifvgBullBoxes, idxR)
            array.remove(ifvgBullTop, idxR)
            array.remove(ifvgBullBot, idxR)
        idxR -= 1

if showIFVG and array.size(ifvgBearBoxes) > 0
    idxR = array.size(ifvgBearBoxes) - 1
    while idxR >= 0
        gT = array.get(ifvgBearTop, idxR)
        if close > gT and open > gT
            box.delete(array.get(ifvgBearBoxes, idxR))
            array.remove(ifvgBearBoxes, idxR)
            array.remove(ifvgBearTop, idxR)
            array.remove(ifvgBearBot, idxR)
        idxR -= 1

// ══════════════════════════════════════════════════════════════════════════════
//  PROXIMITY VISIBILITY (hide far zones)
// ══════════════════════════════════════════════════════════════════════════════

if proxEnable and barstate.isconfirmed
    if showOB and array.size(obBullBoxes) > 0
        for i = 0 to array.size(obBullBoxes) - 1
            if not array.get(obBullMitig, i)
                near = zoneNear(array.get(obBullHi, i), array.get(obBullLo, i))
                box.set_bgcolor(array.get(obBullBoxes, i), near ? obBullColor : color.new(obBullColor, 100))
                box.set_border_color(array.get(obBullBoxes, i), near ? obBullColor : color.new(obBullColor, 100))
    if showOB and array.size(obBearBoxes) > 0
        for i = 0 to array.size(obBearBoxes) - 1
            if not array.get(obBearMitig, i)
                near = zoneNear(array.get(obBearHi, i), array.get(obBearLo, i))
                box.set_bgcolor(array.get(obBearBoxes, i), near ? obBearColor : color.new(obBearColor, 100))
                box.set_border_color(array.get(obBearBoxes, i), near ? obBearColor : color.new(obBearColor, 100))
    if showBB and array.size(bbBullBoxes) > 0
        for i = 0 to array.size(bbBullBoxes) - 1
            near = zoneNear(array.get(bbBullHi, i), array.get(bbBullLo, i))
            box.set_bgcolor(array.get(bbBullBoxes, i), near ? bbBullColor : color.new(bbBullColor, 100))
            box.set_border_color(array.get(bbBullBoxes, i), near ? bbBullColor : color.new(bbBullColor, 100))
    if showBB and array.size(bbBearBoxes) > 0
        for i = 0 to array.size(bbBearBoxes) - 1
            near = zoneNear(array.get(bbBearHi, i), array.get(bbBearLo, i))
            box.set_bgcolor(array.get(bbBearBoxes, i), near ? bbBearColor : color.new(bbBearColor, 100))
            box.set_border_color(array.get(bbBearBoxes, i), near ? bbBearColor : color.new(bbBearColor, 100))
    if showRB and array.size(rbBullBoxes) > 0
        for i = 0 to array.size(rbBullBoxes) - 1
            if not array.get(rbBullMitig, i)
                near = zoneNear(array.get(rbBullHi, i), array.get(rbBullLo, i))
                box.set_bgcolor(array.get(rbBullBoxes, i), near ? rbBullColor : color.new(rbBullColor, 100))
                box.set_border_color(array.get(rbBullBoxes, i), near ? rbBullColor : color.new(rbBullColor, 100))
    if showRB and array.size(rbBearBoxes) > 0
        for i = 0 to array.size(rbBearBoxes) - 1
            if not array.get(rbBearMitig, i)
                near = zoneNear(array.get(rbBearHi, i), array.get(rbBearLo, i))
                box.set_bgcolor(array.get(rbBearBoxes, i), near ? rbBearColor : color.new(rbBearColor, 100))
                box.set_border_color(array.get(rbBearBoxes, i), near ? rbBearColor : color.new(rbBearColor, 100))
    if showFVG and array.size(fvgBullBoxes) > 0
        for i = 0 to array.size(fvgBullBoxes) - 1
            if not array.get(fvgBullDead, i)
                near = zoneNear(array.get(fvgBullTop, i), array.get(fvgBullBot, i))
                box.set_bgcolor(array.get(fvgBullBoxes, i), near ? fvgBullColor : color.new(fvgBullColor, 100))
                box.set_border_color(array.get(fvgBullBoxes, i), near ? fvgBullColor : color.new(fvgBullColor, 100))
    if showFVG and array.size(fvgBearBoxes) > 0
        for i = 0 to array.size(fvgBearBoxes) - 1
            if not array.get(fvgBearDead, i)
                near = zoneNear(array.get(fvgBearTop, i), array.get(fvgBearBot, i))
                box.set_bgcolor(array.get(fvgBearBoxes, i), near ? fvgBearColor : color.new(fvgBearColor, 100))
                box.set_border_color(array.get(fvgBearBoxes, i), near ? fvgBearColor : color.new(fvgBearColor, 100))
    if showIFVG and array.size(ifvgBullBoxes) > 0
        for i = 0 to array.size(ifvgBullBoxes) - 1
            near = zoneNear(array.get(ifvgBullTop, i), array.get(ifvgBullBot, i))
            box.set_bgcolor(array.get(ifvgBullBoxes, i), near ? ifvgBullColor : color.new(ifvgBullColor, 100))
            box.set_border_color(array.get(ifvgBullBoxes, i), near ? ifvgBullColor : color.new(ifvgBullColor, 100))
    if showIFVG and array.size(ifvgBearBoxes) > 0
        for i = 0 to array.size(ifvgBearBoxes) - 1
            near = zoneNear(array.get(ifvgBearTop, i), array.get(ifvgBearBot, i))
            box.set_bgcolor(array.get(ifvgBearBoxes, i), near ? ifvgBearColor : color.new(ifvgBearColor, 100))
            box.set_border_color(array.get(ifvgBearBoxes, i), near ? ifvgBearColor : color.new(ifvgBearColor, 100))

// ══════════════════════════════════════════════════════════════════════════════
//  EQH / EQL (Equal Highs / Equal Lows — Liquidity)
//  Tighter defaults to cut wick noise: longer pivot lookback, lower tolerance.
// ══════════════════════════════════════════════════════════════════════════════

grpLIQ = "💧 EQH / EQL"
showLIQ      = input.bool(true,  "Show EQH/EQL",            group=grpLIQ)
liqLookback  = input.int(10,     "Swing Lookback",          group=grpLIQ, minval=3, maxval=50)
liqTolerance = input.float(0.05, "Equal Level Tolerance %", group=grpLIQ, minval=0.01, maxval=1.0, step=0.01)
liqMinTouch  = input.int(2,      "Min Pivots to Confirm",   group=grpLIQ, minval=2, maxval=5,
     tooltip="Need at least this many pivots clustered within tolerance before a line is drawn. 2 = pair, 3 = triple-tap.")
liqMaxLines  = input.int(4,      "Max Levels per side",     group=grpLIQ, minval=1, maxval=10)
liqEQHColor  = input.color(color.new(#FF5252, 50), "EQH Color", group=grpLIQ)
liqEQLColor  = input.color(color.new(#69F0AE, 50), "EQL Color", group=grpLIQ)
liqSweptHide = input.bool(true,  "Hide When Swept",         group=grpLIQ)
showEQHLabels = input.bool(true, "Show EQH/EQL labels",     group=grpLIQ)

liqPH = ta.pivothigh(high, liqLookback, liqLookback)
liqPL = ta.pivotlow(low,   liqLookback, liqLookback)

// Pending pivot pools (raw pivots awaiting cluster confirmation)
var pendHighLvl = array.new_float()
var pendHighBar = array.new_int()
var pendLowLvl  = array.new_float()
var pendLowBar  = array.new_int()

// Confirmed EQH/EQL lines
var liqHighLines  = array.new_line()
var liqHighLevels = array.new_float()
var liqHighSwept  = array.new_bool()
var liqLowLines   = array.new_line()
var liqLowLevels  = array.new_float()
var liqLowSwept   = array.new_bool()

PEND_KEEP = 12  // how many recent pivots to remember per side

if showLIQ and not na(liqPH)
    // store this pivot
    if array.size(pendHighLvl) >= PEND_KEEP
        array.shift(pendHighLvl)
        array.shift(pendHighBar)
    array.push(pendHighLvl, liqPH)
    array.push(pendHighBar, bar_index - liqLookback)

    tolVal = liqPH * liqTolerance / 100.0

    // is this pivot already part of an existing confirmed level?
    matched = false
    if array.size(liqHighLevels) > 0
        for i = 0 to array.size(liqHighLevels) - 1
            if not array.get(liqHighSwept, i)
                if math.abs(array.get(liqHighLevels, i) - liqPH) <= tolVal
                    matched := true
                    break

    // count how many recent pivots cluster around this one (including itself)
    cluster = 0
    earliestBar = bar_index
    if array.size(pendHighLvl) > 0
        for i = 0 to array.size(pendHighLvl) - 1
            if math.abs(array.get(pendHighLvl, i) - liqPH) <= tolVal
                cluster += 1
                pb = array.get(pendHighBar, i)
                if pb < earliestBar
                    earliestBar := pb

    if not matched and cluster >= liqMinTouch
        while array.size(liqHighLevels) >= liqMaxLines
            line.delete(array.shift(liqHighLines))
            array.shift(liqHighLevels)
            array.shift(liqHighSwept)
        l = line.new(earliestBar, liqPH, bar_index, liqPH,
             color=liqEQHColor, style=line.style_dashed, width=1, extend=extend.right)
        array.push(liqHighLines, l)
        array.push(liqHighLevels, liqPH)
        array.push(liqHighSwept, false)
        if showEQHLabels
            label.new(bar_index - liqLookback, liqPH, "EQH",
                 style=label.style_label_down, color=liqEQHColor,
                 textcolor=color.white, size=size.tiny)

if showLIQ and not na(liqPL)
    if array.size(pendLowLvl) >= PEND_KEEP
        array.shift(pendLowLvl)
        array.shift(pendLowBar)
    array.push(pendLowLvl, liqPL)
    array.push(pendLowBar, bar_index - liqLookback)

    tolVal = liqPL * liqTolerance / 100.0

    matched = false
    if array.size(liqLowLevels) > 0
        for i = 0 to array.size(liqLowLevels) - 1
            if not array.get(liqLowSwept, i)
                if math.abs(array.get(liqLowLevels, i) - liqPL) <= tolVal
                    matched := true
                    break

    cluster = 0
    earliestBar = bar_index
    if array.size(pendLowLvl) > 0
        for i = 0 to array.size(pendLowLvl) - 1
            if math.abs(array.get(pendLowLvl, i) - liqPL) <= tolVal
                cluster += 1
                pb = array.get(pendLowBar, i)
                if pb < earliestBar
                    earliestBar := pb

    if not matched and cluster >= liqMinTouch
        while array.size(liqLowLevels) >= liqMaxLines
            line.delete(array.shift(liqLowLines))
            array.shift(liqLowLevels)
            array.shift(liqLowSwept)
        l = line.new(earliestBar, liqPL, bar_index, liqPL,
             color=liqEQLColor, style=line.style_dashed, width=1, extend=extend.right)
        array.push(liqLowLines, l)
        array.push(liqLowLevels, liqPL)
        array.push(liqLowSwept, false)
        if showEQHLabels
            label.new(bar_index - liqLookback, liqPL, "EQL",
                 style=label.style_label_up, color=liqEQLColor,
                 textcolor=color.white, size=size.tiny)

// Sweep detection (close-based, ignores transient wicks)
// Track sweep events with timestamp so the signal engine can grant
// counter-trend permission after a recent liquidity grab (SMC reversal).
var int lastEQLSweepBar = -9999  // sell-side liquidity taken (low broken) → potential bullish reversal
var int lastEQHSweepBar = -9999  // buy-side  liquidity taken (high broken) → potential bearish reversal

if showLIQ and array.size(liqHighLevels) > 0
    for i = 0 to array.size(liqHighLevels) - 1
        if not array.get(liqHighSwept, i)
            if close > array.get(liqHighLevels, i)
                if liqSweptHide
                    line.delete(array.get(liqHighLines, i))
                else
                    line.set_color(array.get(liqHighLines, i), color.new(liqEQHColor, 85))
                array.set(liqHighSwept, i, true)
                lastEQHSweepBar := bar_index

if showLIQ and array.size(liqLowLevels) > 0
    for i = 0 to array.size(liqLowLevels) - 1
        if not array.get(liqLowSwept, i)
            if close < array.get(liqLowLevels, i)
                if liqSweptHide
                    line.delete(array.get(liqLowLines, i))
                else
                    line.set_color(array.get(liqLowLines, i), color.new(liqEQLColor, 85))
                array.set(liqLowSwept, i, true)
                lastEQLSweepBar := bar_index

// Wick-based liquidity grab: bar pierces level but closes back through it.
// This is the classic SMC sweep — the line itself isn't marked "swept" since
// price returned, but reversal permission is granted.
if showLIQ and array.size(liqLowLevels) > 0
    for i = 0 to array.size(liqLowLevels) - 1
        lvl = array.get(liqLowLevels, i)
        if low < lvl and close > lvl
            lastEQLSweepBar := bar_index

if showLIQ and array.size(liqHighLevels) > 0
    for i = 0 to array.size(liqHighLevels) - 1
        lvl = array.get(liqHighLevels, i)
        if high > lvl and close < lvl
            lastEQHSweepBar := bar_index

// Near EQH/EQL detection (for signal label confluence tag)
nearEQH = false
nearEQL = false
if showLIQ and array.size(liqHighLevels) > 0
    for i = 0 to array.size(liqHighLevels) - 1
        if not array.get(liqHighSwept, i)
            if math.abs(close - array.get(liqHighLevels, i)) / close * 100.0 <= proxPct
                nearEQH := true
                break
if showLIQ and array.size(liqLowLevels) > 0
    for i = 0 to array.size(liqLowLevels) - 1
        if not array.get(liqLowSwept, i)
            if math.abs(close - array.get(liqLowLevels, i)) / close * 100.0 <= proxPct
                nearEQL := true
                break

// ══════════════════════════════════════════════════════════════════════════════
//  CHOP FILTER — block signals when market is range-bound / no trend
//  Two independent detectors (each toggleable):
//    • Choppiness Index (Dreiss)  > threshold  → choppy
//    • ADX                        < threshold  → no trend
//  Either firing flips the global isChoppy flag. The signal engine then
//  refuses to fire BUY/SELL while isChoppy is true.
// ══════════════════════════════════════════════════════════════════════════════

grpCHOP = "🌊 Chop Filter"
chopEnable    = input.bool(true,  "Block signals in chop", group=grpCHOP,
     tooltip="When ON, BUY/SELL signals are suppressed while either chop detector is active. Zones, EQH/EQL and other drawings still render normally.")
chopUseCI     = input.bool(true,  "Use Choppiness Index",  group=grpCHOP)
ciLength      = input.int(14,     "CI Length",             group=grpCHOP, minval=2, maxval=50)
ciThreshold   = input.float(61.8, "CI choppy threshold",   group=grpCHOP, minval=30, maxval=80, step=0.5,
     tooltip=">= this value = choppy. 61.8 is the classic Dreiss Fibonacci threshold. Higher = stricter (only flags very tight ranges).")
chopUseADX    = input.bool(true,  "Use ADX (weak trend)",  group=grpCHOP)
adxLengthIn   = input.int(14,     "ADX Length",            group=grpCHOP, minval=2, maxval=50)
adxThresholdIn= input.float(18.0, "ADX choppy threshold",  group=grpCHOP, minval=10, maxval=40, step=0.5,
     tooltip="<= this value = no trend. ADX < 20 typically means range-bound. Set lower (e.g. 14) to allow more signals in weak trends.")

// Choppiness Index: 100 * log10( sum(TR, n) / (highest(High,n) - lowest(Low,n)) ) / log10(n)
ciHL = ta.highest(high, ciLength) - ta.lowest(low, ciLength)
ciVal = ciHL > 0 ? 100 * math.log10(math.sum(ta.tr, ciLength) / ciHL) / math.log10(ciLength) : 50.0

// ADX from built-in DMI
[diPlus, diMinus, adxVal] = ta.dmi(adxLengthIn, adxLengthIn)

choppyByCI  = chopUseCI  and ciVal  >= ciThreshold
choppyByADX = chopUseADX and adxVal <= adxThresholdIn
isChoppy    = chopEnable and (choppyByCI or choppyByADX)

// ══════════════════════════════════════════════════════════════════════════════
//  ★★★ QUALITY FILTERS — extra strictness applied ONLY to Tier 1 signals.
//  ★★ and ★ are unaffected. Use these when ★★★ has been firing but the
//  setups don't follow through — they tighten ★★★ to the strongest setups
//  by requiring real momentum, decisive candles, and structural alignment.
// ══════════════════════════════════════════════════════════════════════════════

grpT1Q = "📊 Signals — ★★★ Quality Filters"
sigT1Strict     = input.bool(true,  "Apply ★★★ quality filters", group=grpT1Q,
     tooltip="Master switch. When OFF, ★★★ uses only the base criteria (zone reaction + trend + fresh + body). When ON, the additional filters below tighten ★★★ further. ★★ and ★ are never affected.")
sigT1ADXStrong  = input.bool(true,  "Require strong ADX",        group=grpT1Q,
     tooltip="Default ON. ADX must be ≥ the threshold below. Filters out weak/sluggish trends where ★★★ setups often fail. The chop filter (separate group) blocks signals when ADX < 18; this filter raises the bar specifically for ★★★.")
sigT1ADXMin     = input.float(25.0, "Min ADX for ★★★",           group=grpT1Q, minval=15.0, maxval=50.0, step=0.5)
sigT1BigCandle  = input.bool(false, "Require decisive candle (range ≥ ATR)", group=grpT1Q,
     tooltip="The reaction candle's full range must be at least N × ATR(14). Filters out tiny indecisive bars that look pretty on the chart but lack momentum. Turn ON if you see ★★★ firing on small dojis.")
sigT1RangeMult  = input.float(1.0,  "Min candle range × ATR",    group=grpT1Q, minval=0.3, maxval=3.0, step=0.1)
sigT1RecentBOS  = input.bool(false, "Require recent BOS in same direction", group=grpT1Q,
     tooltip="Bull ★★★ requires a bullish Break of Structure within N bars (mirror for bear). Confirms the higher-timeframe structural direction matches the entry. Useful in choppy backgrounds where you only want continuation trades.")
sigT1BOSWindow  = input.int(20,     "BOS window (bars)",         group=grpT1Q, minval=5, maxval=100)

atrSig = ta.atr(14)

bullT1QualOK = (not sigT1Strict) or (((not sigT1ADXStrong) or adxVal >= sigT1ADXMin) and ((not sigT1BigCandle) or (atrSig > 0 and candleRange >= atrSig * sigT1RangeMult)) and ((not sigT1RecentBOS) or (bar_index - lastBullBOSBar) <= sigT1BOSWindow))
bearT1QualOK = (not sigT1Strict) or (((not sigT1ADXStrong) or adxVal >= sigT1ADXMin) and ((not sigT1BigCandle) or (atrSig > 0 and candleRange >= atrSig * sigT1RangeMult)) and ((not sigT1RecentBOS) or (bar_index - lastBearBOSBar) <= sigT1BOSWindow))

// ══════════════════════════════════════════════════════════════════════════════
//  SIGNAL ENGINE — Tiered system. Toggle each combination independently.
//
//  Tier ★★★ PREMIUM  : zone reaction + EMA trend + fresh + body
//  Tier ★★  REVERSAL : zone reaction + recent liquidity sweep + body
//  Tier ★   LOOSE    : zone reaction + body (any trend, any freshness)
//
//  All three tiers share the base requirement that price WICKED into the zone
//  and CLOSED back out. Each tier has its own marker style and label so you
//  can visually separate quality levels.
//
//  Per-zone toggles (OB/BB/RB/FVG/IFVG) and per-direction toggles
//  (longs/shorts) act on top of the tier filters.
// ══════════════════════════════════════════════════════════════════════════════

grpSIG = "📊 Signals"
showSigLabels   = input.bool(true,  "Show Signal labels",         group=grpSIG)
sigCooldown     = input.int(5,      "Bars between signals (per direction)", group=grpSIG, minval=0, maxval=50,
     tooltip="Once any tier fires, no further signals fire in that direction for N bars.")

// ── Quality Tiers (each independently toggleable) ─────────────────────────────
grpTIER = "📊 Signals — Quality Tiers"
sigT1Enable = input.bool(true,  "Tier ★★★ PREMIUM (zone + trend + fresh + body)", group=grpTIER,
     tooltip="Strictest: price reacts off a zone WITH the trend (close above EMA200 for longs, below for shorts), the touch is fresh (prior bar not in zone), and the candle has a bull/bear body or strong rejection wick.")
sigT2Enable = input.bool(true,  "Tier ★★  REVERSAL (zone + sweep + body)",       group=grpTIER,
     tooltip="SMC liquidity-grab reversal: a recent EQL sweep grants long permission counter-trend (mirror for shorts after EQH sweep). Body required, trend NOT required.")
sigT3Enable = input.bool(false, "Tier ★   LOOSE (zone + body only)",              group=grpTIER,
     tooltip="Most permissive: any zone reaction with a confirming body. No trend filter, no freshness, no sweep needed. Will fire frequently.")
sigSweepWindow = input.int(15, "Sweep window for Tier ★★ (bars)", group=grpTIER, minval=1, maxval=50,
     tooltip="How many bars after a sweep the Tier ★★ override stays active.")

// ── Direction toggles ─────────────────────────────────────────────────────────
grpDIR = "📊 Signals — Direction"
sigShowLongs  = input.bool(true,  "Show LONG signals",  group=grpDIR)
sigShowShorts = input.bool(true,  "Show SHORT signals", group=grpDIR)
sigNoSameDir  = input.bool(false, "Block same-direction repeats", group=grpDIR,
     tooltip="When ON, after a BUY fires no further BUY signals fire until a SELL fires (and vice versa). Prevents stacking entries in the same direction — useful for swing trading where you want one position at a time.")

// ── Zone source toggles ───────────────────────────────────────────────────────
grpSRC = "📊 Signals — Zone Sources"
sigSourceOB     = input.bool(true,  "Trigger from OB",            group=grpSRC)
sigSourceBB     = input.bool(true,  "Trigger from BB",            group=grpSRC)
sigSourceRB     = input.bool(true,  "Trigger from RB",            group=grpSRC)
sigSourceFVG    = input.bool(true,  "Trigger from FVG",           group=grpSRC)
sigSourceIFVG   = input.bool(true,  "Trigger from IFVG",          group=grpSRC)

trendBull = close > ema
trendBear = close < ema

// Sweep override windows
recentEQLSweep = (bar_index - lastEQLSweepBar) <= sigSweepWindow
recentEQHSweep = (bar_index - lastEQHSweepBar) <= sigSweepWindow

// ── Base reaction primitives ──────────────────────────────────────────────────
// "pierced" = wick entered the zone
// "rejected" = close came back outside the zone
// "body"   = bullish/bearish candle OR dominant rejection wick
// "fresh"  = prior bar not inside the zone (allowing 2-bar formations)

bullPierced(zHi, zLo) => low  <= zHi and low  >= zLo - (zHi - zLo)
bullRejected(zHi)     => close > zHi
bullFresh(zHi, zLo)   => (low[1] > zHi) or (low[2] > zHi and close[1] >= zLo)
bullBody              = close > open or (candleRange > 0 and (lowerWick / candleRange) >= 0.5)

bearPierced(zHi, zLo) => high >= zLo and high <= zHi + (zHi - zLo)
bearRejected(zLo)     => close < zLo
bearFresh(zHi, zLo)   => (high[1] < zLo) or (high[2] < zLo and close[1] <= zHi)
bearBody              = close < open or (candleRange > 0 and (upperWick / candleRange) >= 0.5)

// ── Tier predicates per zone ──────────────────────────────────────────────────
bullT1(zHi, zLo) => bullPierced(zHi, zLo) and bullRejected(zHi) and bullFresh(zHi, zLo) and bullBody and trendBull and bullT1QualOK
bullT2(zHi, zLo) => bullPierced(zHi, zLo) and bullRejected(zHi) and bullBody and recentEQLSweep
bullT3(zHi, zLo) => bullPierced(zHi, zLo) and bullRejected(zHi) and bullBody

bearT1(zHi, zLo) => bearPierced(zHi, zLo) and bearRejected(zLo) and bearFresh(zHi, zLo) and bearBody and trendBear and bearT1QualOK
bearT2(zHi, zLo) => bearPierced(zHi, zLo) and bearRejected(zLo) and bearBody and recentEQHSweep
bearT3(zHi, zLo) => bearPierced(zHi, zLo) and bearRejected(zLo) and bearBody

// ── Scan zones, collect highest tier that fires per direction ─────────────────
// 1 = T1 (premium), 2 = T2 (reversal), 3 = T3 (loose), 0 = none
buyTier   = 0
buySource = ""
checkBullZone(zHi, zLo, src) =>
    t = 0
    if sigT1Enable and bullT1(zHi, zLo)
        t := 1
    else if sigT2Enable and bullT2(zHi, zLo)
        t := 2
    else if sigT3Enable and bullT3(zHi, zLo)
        t := 3
    [t, src]

if sigSourceOB and array.size(obBullBoxes) > 0
    for i = 0 to array.size(obBullBoxes) - 1
        if not array.get(obBullMitig, i)
            [t, _s] = checkBullZone(array.get(obBullHi, i), array.get(obBullLo, i), "OB")
            if t != 0 and (buyTier == 0 or t < buyTier)
                buyTier := t
                buySource := "OB"
if sigSourceBB and array.size(bbBullBoxes) > 0
    for i = 0 to array.size(bbBullBoxes) - 1
        if not array.get(bbBullMitig, i)
            [t, _s] = checkBullZone(array.get(bbBullHi, i), array.get(bbBullLo, i), "BB")
            if t != 0 and (buyTier == 0 or t < buyTier)
                buyTier := t
                buySource := "BB"
if sigSourceRB and array.size(rbBullBoxes) > 0
    for i = 0 to array.size(rbBullBoxes) - 1
        if not array.get(rbBullMitig, i)
            [t, _s] = checkBullZone(array.get(rbBullHi, i), array.get(rbBullLo, i), "RB")
            if t != 0 and (buyTier == 0 or t < buyTier)
                buyTier := t
                buySource := "RB"
if sigSourceFVG and array.size(fvgBullBoxes) > 0
    for i = 0 to array.size(fvgBullBoxes) - 1
        if not array.get(fvgBullDead, i)
            [t, _s] = checkBullZone(array.get(fvgBullTop, i), array.get(fvgBullBot, i), "FVG")
            if t != 0 and (buyTier == 0 or t < buyTier)
                buyTier := t
                buySource := "FVG"
if sigSourceIFVG and array.size(ifvgBullBoxes) > 0
    for i = 0 to array.size(ifvgBullBoxes) - 1
        [t, _s] = checkBullZone(array.get(ifvgBullTop, i), array.get(ifvgBullBot, i), "IFVG")
        if t != 0 and (buyTier == 0 or t < buyTier)
            buyTier := t
            buySource := "IFVG"

sellTier   = 0
sellSource = ""
checkBearZone(zHi, zLo, src) =>
    t = 0
    if sigT1Enable and bearT1(zHi, zLo)
        t := 1
    else if sigT2Enable and bearT2(zHi, zLo)
        t := 2
    else if sigT3Enable and bearT3(zHi, zLo)
        t := 3
    [t, src]

if sigSourceOB and array.size(obBearBoxes) > 0
    for i = 0 to array.size(obBearBoxes) - 1
        if not array.get(obBearMitig, i)
            [t, _s] = checkBearZone(array.get(obBearHi, i), array.get(obBearLo, i), "OB")
            if t != 0 and (sellTier == 0 or t < sellTier)
                sellTier := t
                sellSource := "OB"
if sigSourceBB and array.size(bbBearBoxes) > 0
    for i = 0 to array.size(bbBearBoxes) - 1
        if not array.get(bbBearMitig, i)
            [t, _s] = checkBearZone(array.get(bbBearHi, i), array.get(bbBearLo, i), "BB")
            if t != 0 and (sellTier == 0 or t < sellTier)
                sellTier := t
                sellSource := "BB"
if sigSourceRB and array.size(rbBearBoxes) > 0
    for i = 0 to array.size(rbBearBoxes) - 1
        if not array.get(rbBearMitig, i)
            [t, _s] = checkBearZone(array.get(rbBearHi, i), array.get(rbBearLo, i), "RB")
            if t != 0 and (sellTier == 0 or t < sellTier)
                sellTier := t
                sellSource := "RB"
if sigSourceFVG and array.size(fvgBearBoxes) > 0
    for i = 0 to array.size(fvgBearBoxes) - 1
        if not array.get(fvgBearDead, i)
            [t, _s] = checkBearZone(array.get(fvgBearTop, i), array.get(fvgBearBot, i), "FVG")
            if t != 0 and (sellTier == 0 or t < sellTier)
                sellTier := t
                sellSource := "FVG"
if sigSourceIFVG and array.size(ifvgBearBoxes) > 0
    for i = 0 to array.size(ifvgBearBoxes) - 1
        [t, _s] = checkBearZone(array.get(ifvgBearTop, i), array.get(ifvgBearBot, i), "IFVG")
        if t != 0 and (sellTier == 0 or t < sellTier)
            sellTier := t
            sellSource := "IFVG"

// ── Cooldown gate ─────────────────────────────────────────────────────────────
var int lastBuyBar  = -9999
var int lastSellBar = -9999
var int lastFireDir = 0  // +1 = last fire was BUY, -1 = SELL, 0 = none

// Same-direction lockout: when sigNoSameDir is ON, a BUY can only fire after
// a SELL has fired since the last BUY (and vice versa). First signal of either
// direction is always allowed.
buyDirOK  = (not sigNoSameDir) or lastFireDir != 1
sellDirOK = (not sigNoSameDir) or lastFireDir != -1

buyReady  = sigShowLongs  and barstate.isconfirmed and buyTier  != 0 and (bar_index - lastBuyBar)  >= sigCooldown and not isChoppy and buyDirOK
sellReady = sigShowShorts and barstate.isconfirmed and sellTier != 0 and (bar_index - lastSellBar) >= sigCooldown and not isChoppy and sellDirOK

if buyReady
    lastBuyBar  := bar_index
    lastFireDir := 1
if sellReady
    lastSellBar := bar_index
    lastFireDir := -1

// Per-tier, per-direction triggers (used for plotshape & alerts)
buyT1Fire = buyReady and buyTier == 1
buyT2Fire = buyReady and buyTier == 2
buyT3Fire = buyReady and buyTier == 3

sellT1Fire = sellReady and sellTier == 1
sellT2Fire = sellReady and sellTier == 2
sellT3Fire = sellReady and sellTier == 3

// ── Labels (one per signal, tier-tagged) ──────────────────────────────────────
tierStars(t) =>
    t == 1 ? "★★★" : t == 2 ? "★★" : t == 3 ? "★" : ""

if showSigLabels and buyReady
    starStr = tierStars(buyTier)
    txt = "BUY " + buySource + " " + starStr + "\n" + str.tostring(close, format.mintick)
    if buyTier == 2
        txt := txt + "\n💧 SWEEP"
    label.new(bar_index, low - candleRange * 0.5, txt,
         style=label.style_label_up,
         color=buyTier == 1 ? color.new(#00C853, 10) : buyTier == 2 ? color.new(#00BCD4, 15) : color.new(#9E9E9E, 25),
         textcolor=color.white,
         size=buyTier == 1 ? size.small : size.tiny)

if showSigLabels and sellReady
    starStr = tierStars(sellTier)
    txt = "SELL " + sellSource + " " + starStr + "\n" + str.tostring(close, format.mintick)
    if sellTier == 2
        txt := txt + "\n💧 SWEEP"
    label.new(bar_index, high + candleRange * 0.5, txt,
         style=label.style_label_down,
         color=sellTier == 1 ? color.new(#F23645, 10) : sellTier == 2 ? color.new(#FF6D00, 15) : color.new(#9E9E9E, 25),
         textcolor=color.white,
         size=sellTier == 1 ? size.small : size.tiny)

// ── Plotshape (backtest-visible markers, distinct per tier) ───────────────────
plotshape(buyT1Fire,  title="BUY ★★★ Premium",  location=location.belowbar, style=shape.triangleup,   color=color.new(#00C853, 0),  size=size.normal)
plotshape(buyT2Fire,  title="BUY ★★ Reversal",  location=location.belowbar, style=shape.triangleup,   color=color.new(#00BCD4, 0),  size=size.small)
plotshape(buyT3Fire,  title="BUY ★ Loose",      location=location.belowbar, style=shape.circle,       color=color.new(#9E9E9E, 20), size=size.tiny)

plotshape(sellT1Fire, title="SELL ★★★ Premium", location=location.abovebar, style=shape.triangledown, color=color.new(#F23645, 0),  size=size.normal)
plotshape(sellT2Fire, title="SELL ★★ Reversal", location=location.abovebar, style=shape.triangledown, color=color.new(#FF6D00, 0),  size=size.small)
plotshape(sellT3Fire, title="SELL ★ Loose",     location=location.abovebar, style=shape.circle,       color=color.new(#9E9E9E, 20), size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
//  ALERTS — separate alert per tier so you can subscribe to only what matters
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(bullBOS,     "Bull BOS",     "Bullish Break of Structure")
alertcondition(bearBOS,     "Bear BOS",     "Bearish Break of Structure")
alertcondition(isBullFVG,   "Bull FVG",     "Bullish Fair Value Gap")
alertcondition(isBearFVG,   "Bear FVG",     "Bearish Fair Value Gap")
alertcondition(isBullRB,    "Bull RB",      "Bullish Rejection Block")
alertcondition(isBearRB,    "Bear RB",      "Bearish Rejection Block")

alertcondition(buyT1Fire,   "BUY ★★★ Premium",  "▲ BUY Premium — Trend + fresh + body reaction")
alertcondition(buyT2Fire,   "BUY ★★ Reversal",  "▲ BUY Reversal — Sweep + body reaction")
alertcondition(buyT3Fire,   "BUY ★ Loose",      "▲ BUY Loose — Body reaction")

alertcondition(sellT1Fire,  "SELL ★★★ Premium", "▼ SELL Premium — Trend + fresh + body reaction")
alertcondition(sellT2Fire,  "SELL ★★ Reversal", "▼ SELL Reversal — Sweep + body reaction")
alertcondition(sellT3Fire,  "SELL ★ Loose",     "▼ SELL Loose — Body reaction")


// ══════════════════════════════════════════════════════════════════════════════
//  DASHBOARD — market condition status panel
// ══════════════════════════════════════════════════════════════════════════════

grpDASH = "📊 Dashboard"
showDashboard  = input.bool(true,  "Show Dashboard",   group=grpDASH)
dashPositionIn = input.string("top_right", "Position", group=grpDASH,
     options=["top_right","top_left","middle_right","middle_left","bottom_right","bottom_left"])
dashSizeIn     = input.string("small", "Text Size",    group=grpDASH,
     options=["tiny","small","normal","large"])

dashPos = dashPositionIn == "top_right"     ? position.top_right     :
          dashPositionIn == "top_left"      ? position.top_left      :
          dashPositionIn == "middle_right"  ? position.middle_right  :
          dashPositionIn == "middle_left"   ? position.middle_left   :
          dashPositionIn == "bottom_right"  ? position.bottom_right  :
          position.bottom_left

dashSz  = dashSizeIn == "tiny"   ? size.tiny   :
          dashSizeIn == "small"  ? size.small  :
          dashSizeIn == "large"  ? size.large  :
          size.normal

// Track last fired signal for display
var string lastSigText  = "—"
var color  lastSigColor = color.gray

if buyReady
    lastSigText  := "BUY " + buySource + " " + tierStars(buyTier)
    lastSigColor := buyTier == 1 ? color.new(#00C853, 0) : buyTier == 2 ? color.new(#00BCD4, 0) : color.new(#9E9E9E, 0)
if sellReady
    lastSigText  := "SELL " + sellSource + " " + tierStars(sellTier)
    lastSigColor := sellTier == 1 ? color.new(#F23645, 0) : sellTier == 2 ? color.new(#FF6D00, 0) : color.new(#9E9E9E, 0)

var table dashTable = table.new(dashPos, 2, 9,
     bgcolor=color.new(#0A0A0A, 10),
     border_width=1, frame_color=color.new(color.gray, 50), frame_width=1,
     border_color=color.new(color.gray, 70))

if showDashboard and barstate.islast
    headerBg = color.new(#1A1A2E, 0)

    // Row 0 — header
    table.cell(dashTable, 0, 0, "SMC v16.3",     text_color=color.white, bgcolor=headerBg, text_size=dashSz)
    table.cell(dashTable, 1, 0, "Tiered Signals", text_color=color.new(color.gray, 0), bgcolor=headerBg, text_size=size.tiny)

    // Row 1 — Status (the headline)
    statusTxt = isChoppy ? "🔴 CHOP — NO TRADE" : "🟢 TRADING OK"
    statusBg  = isChoppy ? color.new(#F23645, 60) : color.new(#00C853, 60)
    table.cell(dashTable, 0, 1, "Status",   text_color=color.white, text_size=dashSz)
    table.cell(dashTable, 1, 1, statusTxt,  text_color=color.white, bgcolor=statusBg, text_size=dashSz)

    // Row 2 — Trend
    trendTxt = trendBull ? "▲ BULL" : trendBear ? "▼ BEAR" : "—"
    trendCol = trendBull ? color.new(#00C853, 0) : trendBear ? color.new(#F23645, 0) : color.gray
    table.cell(dashTable, 0, 2, "Trend (EMA200)", text_color=color.white, text_size=dashSz)
    table.cell(dashTable, 1, 2, trendTxt,         text_color=trendCol,    text_size=dashSz)

    // Row 3 — Choppiness Index
    ciStr = str.tostring(ciVal, "#.0") + (choppyByCI ? "  ⚠ chop" : "  ✓")
    ciCol = choppyByCI ? color.new(#FF6D00, 0) : color.new(#00C853, 0)
    table.cell(dashTable, 0, 3, "Chop Idx (>" + str.tostring(ciThreshold, "#.0") + ")", text_color=color.white, text_size=dashSz)
    table.cell(dashTable, 1, 3, ciStr, text_color=ciCol, text_size=dashSz)

    // Row 4 — ADX
    adxStr = str.tostring(adxVal, "#.0") + (choppyByADX ? "  ⚠ no trend" : "  ✓")
    adxCol = choppyByADX ? color.new(#FF6D00, 0) : color.new(#00C853, 0)
    table.cell(dashTable, 0, 4, "ADX (<" + str.tostring(adxThresholdIn, "#.0") + ")", text_color=color.white, text_size=dashSz)
    table.cell(dashTable, 1, 4, adxStr, text_color=adxCol, text_size=dashSz)

    // Row 5 — Recent liquidity sweeps
    eqlAge = bar_index - lastEQLSweepBar
    eqhAge = bar_index - lastEQHSweepBar
    sweepTxt = ""
    if eqlAge <= sigSweepWindow
        sweepTxt := "💧EQL " + str.tostring(eqlAge) + "b ago"
    if eqhAge <= sigSweepWindow
        sweepTxt := sweepTxt == "" ? "💧EQH " + str.tostring(eqhAge) + "b ago" : sweepTxt + " | EQH " + str.tostring(eqhAge) + "b"
    if sweepTxt == ""
        sweepTxt := "—"
    table.cell(dashTable, 0, 5, "Recent Sweep", text_color=color.white, text_size=dashSz)
    table.cell(dashTable, 1, 5, sweepTxt, text_color=color.new(#00BCD4, 0), text_size=dashSz)

    // Row 6 — active tiers
    tierTxt = (sigT1Enable ? "★★★ " : "") + (sigT2Enable ? "★★ " : "") + (sigT3Enable ? "★" : "")
    if tierTxt == ""
        tierTxt := "—"
    table.cell(dashTable, 0, 6, "Active Tiers", text_color=color.white, text_size=dashSz)
    table.cell(dashTable, 1, 6, tierTxt, text_color=color.new(color.yellow, 0), text_size=dashSz)

    // Row 7 — cooldowns (per direction)
    longCD  = math.max(0, sigCooldown - (bar_index - lastBuyBar))
    shortCD = math.max(0, sigCooldown - (bar_index - lastSellBar))
    cdTxt = "L:" + (longCD == 0 ? "✓" : str.tostring(longCD)) + "  S:" + (shortCD == 0 ? "✓" : str.tostring(shortCD))
    table.cell(dashTable, 0, 7, "Cooldown",  text_color=color.white, text_size=dashSz)
    table.cell(dashTable, 1, 7, cdTxt,       text_color=color.new(color.gray, 0), text_size=dashSz)

    // Row 8 — last fired signal
    table.cell(dashTable, 0, 8, "Last Signal", text_color=color.white, text_size=dashSz)
    table.cell(dashTable, 1, 8, lastSigText,   text_color=lastSigColor, text_size=dashSz)
