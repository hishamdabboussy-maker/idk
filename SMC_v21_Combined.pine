//@version=5
indicator("SMC v21 Full Suite — Structure, Zones, Context & HTF", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
//  SMC v21 FULL SUITE  —  COMBINED (Part 1 + Part 2)
//
//  This is the single-file merge of the two companion indicators:
//    • Part 1 (v21.1) — Core Structure + Price-Action Zones
//    • Part 2 (v21)   — Context, Liquidity, HTF & Composite Signals
//
//  Everything from both indicators is included. Duplicated infrastructure
//  (indicator declaration, the global display block, and the market-structure
//  engine) was deduplicated; the Part-2 "slim" structure copy was removed and
//  its two extra trackers (lastExtPH_val / lastExtPL_val, used by Premium/
//  Discount/OTE) were folded into the full Part-1 structure engine.
//
//  Sessions / Killzones are now defined ONCE near the top (group "Sessions /
//  Killzones") and consumed by both halves — the duplicate Part-2 session block
//  was removed. The two dashboards still use distinct symbols so they coexist:
//    • Part 2 context dashboard symbols  (grpDASH/showDashboard/dashPos*/dashSz/
//      table dash)  ->  *C  variants, group string "Dashboard (Context)"
//  Two dashboards are drawn: P1 (structure) top-right, P2 (context) middle-right.
//
//  Added in this revision:
//    • Session Move Detector — fires once-per-direction-per-session when price
//      drifts a configurable distance from the Asia/NY/London session open
//      (catches slow grinds, not just single candles).
//    • Reliability fixes: unified session inputs, var-tracked periodic-level
//      labels (no realtime churn), batched request.security calls, and an
//      optional "wait for bar close" toggle on HTF zones to cut repaint.
//
//  CONTENTS
//   Part 1 : Market Structure (BOS/CHoCH), Order Blocks, Breaker Blocks,
//            Mitigation Blocks, Rejection Blocks, FVGs, Inverse FVGs,
//            Displacement, Entry-grade dashboard.
//   Part 2 : Volume Imbalances, Liquidity (EQH/EQL + sweeps), Premium/Discount/
//            OTE, Sessions/Killzones, Session Move Detector, Live Asian Range,
//            ICT Macros, Periodic Levels, Liquidity Levels (1D/7D/30D), HTF
//            Order Blocks (confluence scored), HTF FVGs, HTF Premium/Discount,
//            EMAs, Composite "A+" signals, structured JSON alert, context dash.
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
//  GLOBAL DISPLAY  (merged — serves both halves)
// ══════════════════════════════════════════════════════════════════════════════

grpDISP = "Display & Readability"
extendBoxes  = input.bool(true,  "Extend zones to right",      group=grpDISP)
proxEnable   = input.bool(true,  "Hide far zones (proximity)", group=grpDISP)
proxPct      = input.float(2.5,  "Max distance from price %",  group=grpDISP, minval=0.2, maxval=15.0, step=0.1)
farZoneAlpha = input.int(92,     "Far-zone fade alpha (0=solid, 100=invisible)", group=grpDISP, minval=70, maxval=100)
masterLabels = input.bool(true,  "Show zone labels",           group=grpDISP)
labelDensity = input.string("Important", "Label density", group=grpDISP, options=["All","Important","Minimal"])
labelStagger = input.int(8, "Right-edge label stagger (bars)", group=grpDISP, minval=0, maxval=50, tooltip="Spreads right-side labels horizontally so they stop stacking. 0 = legacy behavior (stacked).")

extRight    = extendBoxes ? extend.right : extend.none
candleRange = high - low
bodyHigh    = math.max(open, close)
bodyLow     = math.min(open, close)
upperWick   = high  - bodyHigh
lowerWick   = bodyLow - low
atr14       = ta.atr(14)

// Part 1 label gates
lblAllowOB     = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowBB     = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowBOS    = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowCHoCH  = masterLabels
lblAllowFVG    = masterLabels and labelDensity == "All"
lblAllowIFVG   = masterLabels and labelDensity == "All"
lblAllowRB     = masterLabels and labelDensity == "All"
lblAllowMB     = masterLabels and labelDensity == "All"
lblAllowSwing  = masterLabels and labelDensity == "All"

// Part 2 label gates
lblAllowSweep  = masterLabels
lblAllowVI     = masterLabels and labelDensity == "All"
lblAllowHTF    = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowPD     = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowLevels = masterLabels and (labelDensity == "All" or labelDensity == "Important")

zoneNear(zH, zL) =>
    if not proxEnable
        true
    else
        midZ = math.avg(zH, zL)
        close > 0 and math.abs(close - midZ) / close * 100.0 <= proxPct

fadeColor(c) => color.new(c, farZoneAlpha)

// Right-edge label x positions (staggered horizontally so they don't stack)
// Slot 0: liquidity-level labels (1D-H, 7D-H, 30D-H)
// Slot 1: AR labels
// Slot 2: PD / OTE labels
// Slot 3: HTF / level labels
labelX(slot) => bar_index + slot * labelStagger

// ══════════════════════════════════════════════════════════════════════════════
//  SESSIONS / KILLZONES  (UNIFIED — single source of truth for both halves)
//  Defines the timezone + Asia/London/NY windows used everywhere:
//    • OB / BB killzone grading (Part 1)
//    • Session highlights, Asian Range, composite alert context (Part 2)
//    • Session Move Detector (new)
//  Killzone == London window ∪ NY window (their times equal the session times).
// ══════════════════════════════════════════════════════════════════════════════

grpKZ = "Sessions / Killzones"
showKZ        = input.bool(true,  "Show session highlights",                group=grpKZ)
useKillzoneOB = input.bool(true,  "Tag OBs/BBs formed in killzones with ★",  group=grpKZ)
sessTZ        = input.string("America/New_York", "Session timezone", group=grpKZ, options=["UTC","America/New_York","Europe/London","Asia/Tokyo","exchange"])
asiaSess      = input.session("2000-0000", "Asia session",        group=grpKZ, tooltip="Default times are NY-time. Adjust if the timezone is changed.")
londonSess    = input.session("0200-0500", "London session / KZ", group=grpKZ)
nySess        = input.session("0930-1100", "New York session / KZ", group=grpKZ)
asiaColor     = input.color(color.new(#FFA726, 92), "Asia bg",   group=grpKZ)
londonColor   = input.color(color.new(#26A69A, 92), "London bg", group=grpKZ)
nyColor       = input.color(color.new(#42A5F5, 92), "NY bg",     group=grpKZ)

tz = sessTZ == "exchange" ? syminfo.timezone : sessTZ
inAsia   = not na(time(timeframe.period, asiaSess,   tz))
inLondon = not na(time(timeframe.period, londonSess, tz))
inNY     = not na(time(timeframe.period, nySess,     tz))

inLondonKZ = inLondon
inNYKZ     = inNY
inAnyKZ    = inLondon or inNY
inAnyKZ_p2 = inAnyKZ
sessTxt = inLondon and inNY ? "LDN+NY" : inLondon ? "LONDON" : inNY ? "NY" : inAsia ? "ASIA" : "OFF"

bgcolor(showKZ and inAsia   ? asiaColor   : na, title="Asia")
bgcolor(showKZ and inLondon ? londonColor : na, title="London")
bgcolor(showKZ and inNY     ? nyColor     : na, title="New York")

// ══════════════════════════════════════════════════════════════════════════════
//  SESSION MOVE DETECTOR  (catches gradual session pumps/dumps — Asia & NY)
//
//  Markets often expand directionally DURING the Asia or NY session without one
//  obvious candle. This tracks the move from each session's OPEN and fires once
//  per direction per session when the drift becomes significant — so it catches
//  slow grinds as well as fast moves.
//
//  Modes:
//    • Open displacement (ATR) : |close - sessionOpen| >= N x ATR(14)
//    • Open displacement (%)   : |close - sessionOpen| >= N% of sessionOpen
//    • Opening-range break     : close breaks the first `orBars` bars' H/L (+buffer)
// ══════════════════════════════════════════════════════════════════════════════

grpSM = "Session Move Detector"
showSessMove  = input.bool(true,  "Enable session move signals",        group=grpSM)
smAsia        = input.bool(true,  "Detect Asia session moves",          group=grpSM)
smNY          = input.bool(true,  "Detect New York session moves",      group=grpSM)
smLondon      = input.bool(false, "Detect London session moves",        group=grpSM)
smMode        = input.string("Open displacement (ATR)", "Trigger mode", group=grpSM, options=["Open displacement (ATR)","Open displacement (%)","Opening-range break"])
smATR         = input.float(1.5,  "Move size x ATR(14)",                group=grpSM, minval=0.2, maxval=10.0, step=0.1, tooltip="Threshold for the ATR displacement mode (and the OR-break buffer base).")
smPct         = input.float(0.5,  "Move size %",                        group=grpSM, minval=0.05, maxval=20.0, step=0.05, tooltip="Threshold for the % displacement mode.")
smORBars      = input.int(4,      "Opening-range length (bars)",        group=grpSM, minval=1, maxval=50, tooltip="Bars from session start that define the opening range (OR-break mode).")
smORBufATR    = input.float(0.1,  "OR-break buffer x ATR(14)",          group=grpSM, minval=0.0, maxval=2.0, step=0.05)
smShowMarks   = input.bool(true,  "Show markers",                       group=grpSM)
smAlerts      = input.bool(true,  "Fire alert() events",                group=grpSM)
smUpCol       = input.color(color.new(#00E676, 0), "Up move",   group=grpSM)
smDnCol       = input.color(color.new(#FF5252, 0), "Down move", group=grpSM)

// Returns [sigUp, sigDn, moveATRnow]
//   sigUp/sigDn : true on the bar the move first becomes significant
//                 (latched once per direction per session)
//   moveATRnow  : running (close - sessionOpen)/ATR while in session, else na
//   var state is per call-site, so Asia/NY/London keep independent state.
detectSessionMove(bool inSess, bool enabled) =>
    var float sOpen   = na
    var float orHi    = na
    var float orLo    = na
    var int   sBars   = 0
    var bool  firedUp = false
    var bool  firedDn = false
    sigUp = false
    sigDn = false
    newSess = inSess and not inSess[1]
    if newSess
        sOpen   := open
        orHi    := high
        orLo    := low
        sBars   := 1
        firedUp := false
        firedDn := false
    else if inSess
        sBars += 1
        if sBars <= smORBars
            orHi := math.max(orHi, high)
            orLo := math.min(orLo, low)
    moveATRnow = inSess and not na(sOpen) and not na(atr14) and atr14 > 0 ? (close - sOpen) / atr14 : na
    if enabled and inSess and not na(sOpen)
        if smMode == "Opening-range break"
            buf = smORBufATR * atr14
            if sBars > smORBars
                if not firedUp and close > orHi + buf
                    sigUp   := true
                    firedUp := true
                if not firedDn and close < orLo - buf
                    sigDn   := true
                    firedDn := true
        else
            thr = smMode == "Open displacement (%)" ? sOpen * smPct / 100.0 : smATR * atr14
            move = close - sOpen
            if not firedUp and move >= thr
                sigUp   := true
                firedUp := true
            if not firedDn and move <= -thr
                sigDn   := true
                firedDn := true
    [sigUp, sigDn, moveATRnow]

[asiaUp, asiaDn, asiaMoveATR] = detectSessionMove(inAsia,   showSessMove and smAsia)
[nyUp,   nyDn,   nyMoveATR]   = detectSessionMove(inNY,     showSessMove and smNY)
[lonUp,  lonDn,  lonMoveATR]  = detectSessionMove(inLondon, showSessMove and smLondon)

// Running displacement of whichever session is currently active (for dashboard)
sessMoveATRnow = inNY ? nyMoveATR : inAsia ? asiaMoveATR : inLondon ? lonMoveATR : na

plotshape(smShowMarks and asiaUp, title="Asia move up",     location=location.belowbar, style=shape.labelup,   color=smUpCol, textcolor=color.black, size=size.small, text="ASIA▲")
plotshape(smShowMarks and asiaDn, title="Asia move down",   location=location.abovebar, style=shape.labeldown, color=smDnCol, textcolor=color.white, size=size.small, text="ASIA▼")
plotshape(smShowMarks and nyUp,   title="NY move up",       location=location.belowbar, style=shape.labelup,   color=smUpCol, textcolor=color.black, size=size.small, text="NY▲")
plotshape(smShowMarks and nyDn,   title="NY move down",     location=location.abovebar, style=shape.labeldown, color=smDnCol, textcolor=color.white, size=size.small, text="NY▼")
plotshape(smShowMarks and lonUp,  title="London move up",   location=location.belowbar, style=shape.labelup,   color=smUpCol, textcolor=color.black, size=size.tiny,  text="LDN▲")
plotshape(smShowMarks and lonDn,  title="London move down", location=location.abovebar, style=shape.labeldown, color=smDnCol, textcolor=color.white, size=size.tiny,  text="LDN▼")

sessMoveFired = asiaUp or asiaDn or nyUp or nyDn or lonUp or lonDn
if smAlerts and sessMoveFired
    smDir = asiaUp ? "Asia UP" : asiaDn ? "Asia DOWN" : nyUp ? "NY UP" : nyDn ? "NY DOWN" : lonUp ? "London UP" : "London DOWN"
    alert("Session expansion: " + smDir + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)

// Session-move alerts fire via alert() above — subscribe with "Any alert() function call".

// ══════════════════════════════════════════════════════════════════════════════
//  MARKET STRUCTURE
// ══════════════════════════════════════════════════════════════════════════════

grpMS = "Market Structure"
showStruct      = input.bool(true,  "Show market structure",       group=grpMS)
useBodyBreak    = input.bool(false, "Body-break (else close-break)", group=grpMS)
bosATRFilter    = input.float(0.0,  "Min BOS distance x ATR (0=off)", group=grpMS, minval=0.0, maxval=3.0, step=0.05)
internalLen     = input.int(5,      "Internal swing lookback",     group=grpMS, minval=2, maxval=30)
externalLen     = input.int(25,     "External swing lookback",     group=grpMS, minval=10, maxval=100)
showInternal    = input.bool(true,  "Show internal BOS/CHoCH",     group=grpMS)
showExternal    = input.bool(true,  "Show external BOS/CHoCH",     group=grpMS)
showSwingPoints = input.bool(true,  "Show swing H/L labels",       group=grpMS)
strongWeakLbl   = input.bool(true,  "Tag strong/weak highs/lows",  group=grpMS)
bullStructColor = input.color(color.new(#26A69A, 0),  "Bullish structure", group=grpMS)
bearStructColor = input.color(color.new(#EF5350, 0),  "Bearish structure", group=grpMS)
minStructGap    = input.int(10, "Min bars between structure labels", group=grpMS, minval=0, maxval=50)

intPH = ta.pivothigh(high, internalLen, internalLen)
intPL = ta.pivotlow(low,   internalLen, internalLen)
extPH = ta.pivothigh(high, externalLen, externalLen)
extPL = ta.pivotlow(low,   externalLen, externalLen)

var float intLastPH    = na
var float intLastPL    = na
var int   intLastPHBar = na
var int   intLastPLBar = na
var float extLastPH    = na
var float extLastPL    = na
var int   extLastPHBar = na
var int   extLastPLBar = na

if not na(intPH)
    intLastPH    := intPH
    intLastPHBar := bar_index - internalLen
if not na(intPL)
    intLastPL    := intPL
    intLastPLBar := bar_index - internalLen
if not na(extPH)
    extLastPH    := extPH
    extLastPHBar := bar_index - externalLen
if not na(extPL)
    extLastPL    := extPL
    extLastPLBar := bar_index - externalLen

// Persistent last external pivot values (never nulled) — used by Premium/Discount/OTE
var float lastExtPH_val = na
var float lastExtPL_val = na
if not na(extPH)
    lastExtPH_val := extPH
if not na(extPL)
    lastExtPL_val := extPL

var int intTrend = 0
var int extTrend = 0

atrBuf = bosATRFilter > 0 and not na(atr14) ? bosATRFilter * atr14 : 0.0

intBullBOS_raw = useBodyBreak ?
   (not na(intLastPH) and bodyLow  > intLastPH + atrBuf and close[1] <= intLastPH) :
   (not na(intLastPH) and close > intLastPH + atrBuf and close[1] <= intLastPH)
intBearBOS_raw = useBodyBreak ?
   (not na(intLastPL) and bodyHigh < intLastPL - atrBuf and close[1] >= intLastPL) :
   (not na(intLastPL) and close < intLastPL - atrBuf and close[1] >= intLastPL)
extBullBOS_raw = useBodyBreak ?
   (not na(extLastPH) and bodyLow  > extLastPH + atrBuf and close[1] <= extLastPH) :
   (not na(extLastPH) and close > extLastPH + atrBuf and close[1] <= extLastPH)
extBearBOS_raw = useBodyBreak ?
   (not na(extLastPL) and bodyHigh < extLastPL - atrBuf and close[1] >= extLastPL) :
   (not na(extLastPL) and close < extLastPL - atrBuf and close[1] >= extLastPL)

intBullBOS = false
intBullCHoCH = false
intBearBOS = false
intBearCHoCH = false
if intBullBOS_raw
    if intTrend == -1
        intBullCHoCH := true
    else
        intBullBOS := true
    intTrend := 1
if intBearBOS_raw
    if intTrend == 1
        intBearCHoCH := true
    else
        intBearBOS := true
    intTrend := -1

extBullBOS = false
extBullCHoCH = false
extBearBOS = false
extBearCHoCH = false
if extBullBOS_raw
    if extTrend == -1
        extBullCHoCH := true
    else
        extBullBOS := true
    extTrend := 1
if extBearBOS_raw
    if extTrend == 1
        extBearCHoCH := true
    else
        extBearBOS := true
    extTrend := -1

// ── Entry dashboard: track recent event ages ─────────────────────────────────
var int lastBullCHoCHBar_e = -9999
var int lastBearCHoCHBar_e = -9999
var int lastBullBOSBar_e   = -9999
var int lastBearBOSBar_e   = -9999
var int lastDispBullBar_e  = -9999
var int lastDispBearBar_e  = -9999

if intBullCHoCH or extBullCHoCH
    lastBullCHoCHBar_e := bar_index
if intBearCHoCH or extBearCHoCH
    lastBearCHoCHBar_e := bar_index
if intBullBOS or extBullBOS
    lastBullBOSBar_e := bar_index
if intBearBOS or extBearBOS
    lastBearBOSBar_e := bar_index

var line[] structLines = array.new_line()
var int MAX_STRUCT_LINES = 50

addStructLine(brokenLevel, brokenBar, isInternal, isBull) =>
    col   = isBull ? bullStructColor : bearStructColor
    style = isInternal ? line.style_dotted : line.style_solid
    width = isInternal ? 1 : 2
    while array.size(structLines) >= MAX_STRUCT_LINES
        line.delete(array.shift(structLines))
    array.push(structLines, line.new(brokenBar, brokenLevel, bar_index, brokenLevel, color=col, style=style, width=width))

var int lastIntStructDir = 0
var int lastExtStructDir = 0
var int lastIntStructBar = -9999
var int lastExtStructBar = -9999

canDrawStructLabel(isBull, isInternal) =>
    dir = isBull ? 1 : -1
    if isInternal
        sameDir  = lastIntStructDir == dir
        tooClose = (bar_index - lastIntStructBar) < minStructGap
        not sameDir and not tooClose
    else
        sameDir  = lastExtStructDir == dir
        tooClose = (bar_index - lastExtStructBar) < minStructGap
        not sameDir and not tooClose

if showStruct and showInternal and intBullBOS
    addStructLine(intLastPH, intLastPHBar, true, true)
    if lblAllowBOS and canDrawStructLabel(true, true)
        label.new(int(math.avg(intLastPHBar, bar_index)), intLastPH, "BOS",
             style=label.style_label_down, color=color.new(bullStructColor, 70), textcolor=color.white, size=size.tiny)
    lastIntStructDir := 1
    lastIntStructBar := bar_index
    intLastPH := na
    intLastPHBar := na
if showStruct and showInternal and intBullCHoCH
    addStructLine(intLastPH, intLastPHBar, true, true)
    if lblAllowCHoCH
        label.new(int(math.avg(intLastPHBar, bar_index)), intLastPH, "CHoCH",
             style=label.style_label_down, color=color.new(bullStructColor, 70), textcolor=color.white, size=size.tiny)
    lastIntStructDir := 1
    lastIntStructBar := bar_index
    intLastPH := na
    intLastPHBar := na
if showStruct and showInternal and intBearBOS
    addStructLine(intLastPL, intLastPLBar, true, false)
    if lblAllowBOS and canDrawStructLabel(false, true)
        label.new(int(math.avg(intLastPLBar, bar_index)), intLastPL, "BOS",
             style=label.style_label_up, color=color.new(bearStructColor, 70), textcolor=color.white, size=size.tiny)
    lastIntStructDir := -1
    lastIntStructBar := bar_index
    intLastPL := na
    intLastPLBar := na
if showStruct and showInternal and intBearCHoCH
    addStructLine(intLastPL, intLastPLBar, true, false)
    if lblAllowCHoCH
        label.new(int(math.avg(intLastPLBar, bar_index)), intLastPL, "CHoCH",
             style=label.style_label_up, color=color.new(bearStructColor, 70), textcolor=color.white, size=size.tiny)
    lastIntStructDir := -1
    lastIntStructBar := bar_index
    intLastPL := na
    intLastPLBar := na
if showStruct and showExternal and extBullBOS
    addStructLine(extLastPH, extLastPHBar, false, true)
    if lblAllowBOS and canDrawStructLabel(true, false)
        label.new(int(math.avg(extLastPHBar, bar_index)), extLastPH, "BOS",
             style=label.style_label_down, color=color.new(bullStructColor, 70), textcolor=color.white, size=size.tiny)
    lastExtStructDir := 1
    lastExtStructBar := bar_index
    extLastPH := na
    extLastPHBar := na
if showStruct and showExternal and extBullCHoCH
    addStructLine(extLastPH, extLastPHBar, false, true)
    if lblAllowCHoCH
        label.new(int(math.avg(extLastPHBar, bar_index)), extLastPH, "CHoCH",
             style=label.style_label_down, color=color.new(bullStructColor, 70), textcolor=color.white, size=size.tiny)
    lastExtStructDir := 1
    lastExtStructBar := bar_index
    extLastPH := na
    extLastPHBar := na
if showStruct and showExternal and extBearBOS
    addStructLine(extLastPL, extLastPLBar, false, false)
    if lblAllowBOS and canDrawStructLabel(false, false)
        label.new(int(math.avg(extLastPLBar, bar_index)), extLastPL, "BOS",
             style=label.style_label_up, color=color.new(bearStructColor, 70), textcolor=color.white, size=size.tiny)
    lastExtStructDir := -1
    lastExtStructBar := bar_index
    extLastPL := na
    extLastPLBar := na
if showStruct and showExternal and extBearCHoCH
    addStructLine(extLastPL, extLastPLBar, false, false)
    if lblAllowCHoCH
        label.new(int(math.avg(extLastPLBar, bar_index)), extLastPL, "CHoCH",
             style=label.style_label_up, color=color.new(bearStructColor, 70), textcolor=color.white, size=size.tiny)
    lastExtStructDir := -1
    lastExtStructBar := bar_index
    extLastPL := na
    extLastPLBar := na

var label[] swingLbls    = array.new_label()
var float[] swingLevels  = array.new_float()
var bool[]  swingIsHi    = array.new_bool()
var bool[]  swingBroken  = array.new_bool()
var int MAX_SWING_LBLS = 30

addSwingLbl(price, isHi, atBar) =>
    if showSwingPoints and showStruct and lblAllowSwing
        while array.size(swingLbls) >= MAX_SWING_LBLS
            label.delete(array.shift(swingLbls))
            array.shift(swingLevels)
            array.shift(swingIsHi)
            array.shift(swingBroken)
        txt = strongWeakLbl ? (isHi ? "SH" : "SL") : (isHi ? "H" : "L")
        col = isHi ? bearStructColor : bullStructColor
        sty = isHi ? label.style_label_down : label.style_label_up
        lbl = label.new(atBar, price, txt, style=sty, color=color.new(col, 50), textcolor=color.white, size=size.tiny)
        array.push(swingLbls, lbl)
        array.push(swingLevels, price)
        array.push(swingIsHi, isHi)
        array.push(swingBroken, false)

if not na(extPH)
    addSwingLbl(extPH, true, bar_index - externalLen)
if not na(extPL)
    addSwingLbl(extPL, false, bar_index - externalLen)

if strongWeakLbl and array.size(swingLbls) > 0
    for i = 0 to array.size(swingLbls) - 1
        if not array.get(swingBroken, i)
            isHi = array.get(swingIsHi, i)
            lvl  = array.get(swingLevels, i)
            broken = isHi ? close > lvl : close < lvl
            if broken
                array.set(swingBroken, i, true)
                label.set_text(array.get(swingLbls, i), isHi ? "wH" : "wL")
                label.set_color(array.get(swingLbls, i), color.new(color.gray, 50))

ph = intPH
pl = intPL
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl
bullBOS = intBullBOS_raw
bearBOS = intBearBOS_raw
if bullBOS
    lastPH := na
if bearBOS
    lastPL := na


// ══════════════════════════════════════════════════════════════════════════════
//  ORDER BLOCKS  (with killzone-aware grading)
// ══════════════════════════════════════════════════════════════════════════════

grpOB = "Order Blocks"
showOB      = input.bool(true,  "Show Order Blocks",  group=grpOB)
obMaxBoxes  = input.int(5,      "Max OBs per side",   group=grpOB, minval=1, maxval=15)
obHideMitig = input.bool(true,  "Hide mitigated OBs", group=grpOB)
obMitigMode = input.string("Close", "Mitigation by",  group=grpOB, options=["Wick","Close"])
obBullColor = input.color(color.new(#2962FF, 75), "Bull OB", group=grpOB)
obBearColor = input.color(color.new(#F23645, 75), "Bear OB", group=grpOB)

var obBullBoxes = array.new_box()
var obBullMitig = array.new_bool()
var obBullHi    = array.new_float()
var obBullLo    = array.new_float()
var obBullLeft  = array.new_int()
var obBullKZ    = array.new_bool()
var obBearBoxes = array.new_box()
var obBearMitig = array.new_bool()
var obBearHi    = array.new_float()
var obBearLo    = array.new_float()
var obBearLeft  = array.new_int()
var obBearKZ    = array.new_bool()

if showOB and bullBOS
    obIdx = 0
    found = false
    for k = 1 to math.min(internalLen * 2, 50)
        if close[k] < open[k]
            obIdx := k
            found := true
            break
    if found
        oH = high[obIdx]
        oL = low[obIdx]
        oB = bar_index - obIdx
        oKZ = useKillzoneOB and inAnyKZ[obIdx]
        while array.size(obBullBoxes) >= obMaxBoxes
            box.delete(array.shift(obBullBoxes))
            array.shift(obBullMitig)
            array.shift(obBullHi)
            array.shift(obBullLo)
            array.shift(obBullLeft)
            array.shift(obBullKZ)
        bWidth = oKZ ? 2 : 1
        b = box.new(oB, oH, bar_index, oL, bgcolor=obBullColor, border_color=oKZ ? color.new(obBullColor, 30) : obBullColor, border_width=bWidth, extend=extRight)
        array.push(obBullBoxes, b)
        array.push(obBullMitig, false)
        array.push(obBullHi, oH)
        array.push(obBullLo, oL)
        array.push(obBullLeft, oB)
        array.push(obBullKZ, oKZ)
        obTxt = oKZ ? "★OB" : "OB"
        if oKZ or lblAllowOB
            label.new(oB, oH, obTxt, style=label.style_label_down, color=oKZ ? color.new(obBullColor, 30) : obBullColor, textcolor=color.white, size=size.tiny)

if showOB and bearBOS
    obIdx = 0
    found = false
    for k = 1 to math.min(internalLen * 2, 50)
        if close[k] > open[k]
            obIdx := k
            found := true
            break
    if found
        oH = high[obIdx]
        oL = low[obIdx]
        oB = bar_index - obIdx
        oKZ = useKillzoneOB and inAnyKZ[obIdx]
        while array.size(obBearBoxes) >= obMaxBoxes
            box.delete(array.shift(obBearBoxes))
            array.shift(obBearMitig)
            array.shift(obBearHi)
            array.shift(obBearLo)
            array.shift(obBearLeft)
            array.shift(obBearKZ)
        bWidth = oKZ ? 2 : 1
        b = box.new(oB, oH, bar_index, oL, bgcolor=obBearColor, border_color=oKZ ? color.new(obBearColor, 30) : obBearColor, border_width=bWidth, extend=extRight)
        array.push(obBearBoxes, b)
        array.push(obBearMitig, false)
        array.push(obBearHi, oH)
        array.push(obBearLo, oL)
        array.push(obBearLeft, oB)
        array.push(obBearKZ, oKZ)
        obTxt = oKZ ? "★OB" : "OB"
        if oKZ or lblAllowOB
            label.new(oB, oL, obTxt, style=label.style_label_up, color=oKZ ? color.new(obBearColor, 30) : obBearColor, textcolor=color.white, size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
//  BREAKER BLOCKS — INPUTS & STATE  (logic block lives further down)
//  Declared here so OB mitigation can queue BB candidates inline.
// ══════════════════════════════════════════════════════════════════════════════

grpBB = "Breaker Blocks"
showBB        = input.bool(true,  "Show Breaker Blocks",                   group=grpBB)
bbMaxBoxes    = input.int(4,      "Max BBs per side",                      group=grpBB, minval=1, maxval=15)
bbRequireBOS  = input.bool(true,  "Require confirming BOS (recommended)",  group=grpBB, tooltip="ON  = ICT-correct: an OB mitigation only becomes a BB once a real Break-of-Structure prints in the new direction within the confirmation window. Major noise reduction.\nOFF = legacy v21.0: every OB mitigation immediately spawns a BB (very noisy on chop).")
bbConfirmBars = input.int(30,     "BOS confirmation window (bars)",        group=grpBB, minval=3, maxval=200, tooltip="Max bars between OB mitigation and the confirming BOS. Larger = more BBs but lower quality. 30 ≈ several hours on 15m.")
bbDispATR     = input.float(0.5,  "Min BOS displacement x ATR (0=off)",    group=grpBB, minval=0.0, maxval=5.0, step=0.1, tooltip="Reject the BOS as confirmation unless that candle's range is at least N x ATR(14). Filters weak/lazy breaks.")
bbMinSizeATR  = input.float(0.0,  "Min BB size x ATR (0=off)",             group=grpBB, minval=0.0, maxval=5.0, step=0.05, tooltip="Reject the resulting BB if it's smaller than N x ATR(14). Filters tiny noisy zones.")
bbMitigMode   = input.string("Close", "Mitigation by",                     group=grpBB, options=["Wick","Close"])
bbHideMitig   = input.bool(true,  "Hide mitigated BBs",                    group=grpBB)
bbKZTag       = input.bool(true,  "Tag killzone-confirmed BBs with ★",     group=grpBB)
bbBullColor   = input.color(color.new(#26A69A, 70), "Bull BB",             group=grpBB)
bbBearColor   = input.color(color.new(#EF5350, 70), "Bear BB",             group=grpBB)

var bbBullBoxes    = array.new_box()
var bbBullHi       = array.new_float()
var bbBullLo       = array.new_float()
var bbBullMitig    = array.new_bool()
var bbBullKZ       = array.new_bool()
var bbBearBoxes    = array.new_box()
var bbBearHi       = array.new_float()
var bbBearLo       = array.new_float()
var bbBearMitig    = array.new_bool()
var bbBearKZ       = array.new_bool()

var pendBBBearHi   = array.new_float()
var pendBBBearLo   = array.new_float()
var pendBBBearAt   = array.new_int()
var pendBBBearLeft = array.new_int()
var pendBBBullHi   = array.new_float()
var pendBBBullLo   = array.new_float()
var pendBBBullAt   = array.new_int()
var pendBBBullLeft = array.new_int()

var int MAX_PEND_BB = 20

if showOB and array.size(obBullBoxes) > 0
    for i = 0 to array.size(obBullBoxes) - 1
        if not array.get(obBullMitig, i)
            mp = obMitigMode == "Wick" ? low : close
            if mp < array.get(obBullLo, i)
                if obHideMitig
                    box.delete(array.get(obBullBoxes, i))
                array.set(obBullMitig, i, true)
                // BB pipeline — inline queue (only fires once per OB transition)
                if showBB
                    while array.size(pendBBBearHi) >= MAX_PEND_BB
                        array.shift(pendBBBearHi)
                        array.shift(pendBBBearLo)
                        array.shift(pendBBBearAt)
                        array.shift(pendBBBearLeft)
                    array.push(pendBBBearHi,   array.get(obBullHi,   i))
                    array.push(pendBBBearLo,   array.get(obBullLo,   i))
                    array.push(pendBBBearAt,   bar_index)
                    array.push(pendBBBearLeft, array.get(obBullLeft, i))
if showOB and array.size(obBearBoxes) > 0
    for i = 0 to array.size(obBearBoxes) - 1
        if not array.get(obBearMitig, i)
            mp = obMitigMode == "Wick" ? high : close
            if mp > array.get(obBearHi, i)
                if obHideMitig
                    box.delete(array.get(obBearBoxes, i))
                array.set(obBearMitig, i, true)
                // BB pipeline — inline queue (only fires once per OB transition)
                if showBB
                    while array.size(pendBBBullHi) >= MAX_PEND_BB
                        array.shift(pendBBBullHi)
                        array.shift(pendBBBullLo)
                        array.shift(pendBBBullAt)
                        array.shift(pendBBBullLeft)
                    array.push(pendBBBullHi,   array.get(obBearHi,   i))
                    array.push(pendBBBullLo,   array.get(obBearLo,   i))
                    array.push(pendBBBullAt,   bar_index)
                    array.push(pendBBBullLeft, array.get(obBearLeft, i))

// ══════════════════════════════════════════════════════════════════════════════
//  BREAKER BLOCKS — PROCESSING  (v21.2 — perf fix)
//
//  v21.0 spawned a BB the bar an OB was mitigated → noisy.
//  v21.1 added BOS confirmation but a per-bar OB-scan loop blew the >500ms
//        Pine loop limit on busy charts.
//  v21.2 inlines BB queueing into OB mitigation (zero per-bar scan), and
//        only walks the pending queue when a BOS prints OR the head entry
//        is stale. Same ICT-correct result, cheap CPU.
// ══════════════════════════════════════════════════════════════════════════════

spawnBearBB(oH, oL, oLeft) =>
    sizeOK = bbMinSizeATR == 0.0 or (oH - oL) >= bbMinSizeATR * atr14
    if sizeOK
        isKZ = bbKZTag and inAnyKZ
        while array.size(bbBearBoxes) >= bbMaxBoxes
            box.delete(array.shift(bbBearBoxes))
            array.shift(bbBearHi)
            array.shift(bbBearLo)
            array.shift(bbBearMitig)
            array.shift(bbBearKZ)
        bWidth = isKZ ? 2 : 1
        bx = box.new(oLeft, oH, bar_index, oL, bgcolor=bbBearColor, border_color=isKZ ? color.new(bbBearColor, 30) : bbBearColor, border_width=bWidth, extend=extRight)
        array.push(bbBearBoxes, bx)
        array.push(bbBearHi, oH)
        array.push(bbBearLo, oL)
        array.push(bbBearMitig, false)
        array.push(bbBearKZ, isKZ)
        if isKZ or lblAllowBB
            label.new(bar_index, oH, isKZ ? "★BB" : "BB", style=label.style_label_down, color=isKZ ? color.new(bbBearColor, 30) : bbBearColor, textcolor=color.white, size=size.tiny)
    sizeOK

spawnBullBB(oH, oL, oLeft) =>
    sizeOK = bbMinSizeATR == 0.0 or (oH - oL) >= bbMinSizeATR * atr14
    if sizeOK
        isKZ = bbKZTag and inAnyKZ
        while array.size(bbBullBoxes) >= bbMaxBoxes
            box.delete(array.shift(bbBullBoxes))
            array.shift(bbBullHi)
            array.shift(bbBullLo)
            array.shift(bbBullMitig)
            array.shift(bbBullKZ)
        bWidth = isKZ ? 2 : 1
        bx = box.new(oLeft, oH, bar_index, oL, bgcolor=bbBullColor, border_color=isKZ ? color.new(bbBullColor, 30) : bbBullColor, border_width=bWidth, extend=extRight)
        array.push(bbBullBoxes, bx)
        array.push(bbBullHi, oH)
        array.push(bbBullLo, oL)
        array.push(bbBullMitig, false)
        array.push(bbBullKZ, isKZ)
        if isKZ or lblAllowBB
            label.new(bar_index, oL, isKZ ? "★BB" : "BB", style=label.style_label_up, color=isKZ ? color.new(bbBullColor, 30) : bbBullColor, textcolor=color.white, size=size.tiny)
    sizeOK

// Drain pending queue:
//  - bbRequireBOS=false: every queued candidate is promoted immediately
//  - bbRequireBOS=true : drain the queue when a BOS prints in the right
//                       direction; expire stale head entries every bar.
if showBB
    if not bbRequireBOS
        while array.size(pendBBBearHi) > 0
            spawnBearBB(array.get(pendBBBearHi, 0), array.get(pendBBBearLo, 0), array.get(pendBBBearLeft, 0))
            array.shift(pendBBBearHi)
            array.shift(pendBBBearLo)
            array.shift(pendBBBearAt)
            array.shift(pendBBBearLeft)
        while array.size(pendBBBullHi) > 0
            spawnBullBB(array.get(pendBBBullHi, 0), array.get(pendBBBullLo, 0), array.get(pendBBBullLeft, 0))
            array.shift(pendBBBullHi)
            array.shift(pendBBBullLo)
            array.shift(pendBBBullAt)
            array.shift(pendBBBullLeft)
    else
        bearBOSAny = intBearBOS_raw or extBearBOS_raw
        bullBOSAny = intBullBOS_raw or extBullBOS_raw
        bosOK      = bbDispATR == 0.0 or (not na(atr14) and candleRange >= bbDispATR * atr14)
        if bearBOSAny and bosOK and array.size(pendBBBearHi) > 0
            while array.size(pendBBBearHi) > 0
                spawnBearBB(array.get(pendBBBearHi, 0), array.get(pendBBBearLo, 0), array.get(pendBBBearLeft, 0))
                array.shift(pendBBBearHi)
                array.shift(pendBBBearLo)
                array.shift(pendBBBearAt)
                array.shift(pendBBBearLeft)
        if bullBOSAny and bosOK and array.size(pendBBBullHi) > 0
            while array.size(pendBBBullHi) > 0
                spawnBullBB(array.get(pendBBBullHi, 0), array.get(pendBBBullLo, 0), array.get(pendBBBullLeft, 0))
                array.shift(pendBBBullHi)
                array.shift(pendBBBullLo)
                array.shift(pendBBBullAt)
                array.shift(pendBBBullLeft)
        // Cheap stale-expiry: only check the head entry (oldest); pending list is FIFO.
        // Use an outer size guard + flag pattern: Pine v5 doesn't reliably
        // short-circuit a compound while-condition that contains array.get(),
        // so we keep the access strictly behind a size check.
        if array.size(pendBBBearHi) > 0
            keepBear = true
            while keepBear
                if bar_index - array.get(pendBBBearAt, 0) > bbConfirmBars
                    array.shift(pendBBBearHi)
                    array.shift(pendBBBearLo)
                    array.shift(pendBBBearAt)
                    array.shift(pendBBBearLeft)
                    keepBear := array.size(pendBBBearHi) > 0
                else
                    keepBear := false
        if array.size(pendBBBullHi) > 0
            keepBull = true
            while keepBull
                if bar_index - array.get(pendBBBullAt, 0) > bbConfirmBars
                    array.shift(pendBBBullHi)
                    array.shift(pendBBBullLo)
                    array.shift(pendBBBullAt)
                    array.shift(pendBBBullLeft)
                    keepBull := array.size(pendBBBullHi) > 0
                else
                    keepBull := false

// BB mitigation
if showBB and array.size(bbBullBoxes) > 0
    for i = 0 to array.size(bbBullBoxes) - 1
        if not array.get(bbBullMitig, i)
            mp = bbMitigMode == "Wick" ? low : close
            if mp < array.get(bbBullLo, i)
                if bbHideMitig
                    box.delete(array.get(bbBullBoxes, i))
                array.set(bbBullMitig, i, true)
if showBB and array.size(bbBearBoxes) > 0
    for i = 0 to array.size(bbBearBoxes) - 1
        if not array.get(bbBearMitig, i)
            mp = bbMitigMode == "Wick" ? high : close
            if mp > array.get(bbBearHi, i)
                if bbHideMitig
                    box.delete(array.get(bbBearBoxes, i))
                array.set(bbBearMitig, i, true)


// ══════════════════════════════════════════════════════════════════════════════
//  MITIGATION BLOCKS
// ══════════════════════════════════════════════════════════════════════════════

grpMB = "Mitigation Blocks"
showMB     = input.bool(true,  "Show Mitigation Blocks", group=grpMB)
mbDispATR  = input.float(1.5,  "Displacement x ATR",     group=grpMB, minval=0.5, maxval=5.0, step=0.1)
mbMaxBoxes = input.int(3,      "Max MBs per side",       group=grpMB, minval=1, maxval=10)
mbBullColor= input.color(color.new(#FFC107, 75), "Bull MB", group=grpMB)
mbBearColor= input.color(color.new(#9C27B0, 75), "Bear MB", group=grpMB)

var mbBullBoxes = array.new_box()
var mbBullMitig = array.new_bool()
var mbBullHi    = array.new_float()
var mbBullLo    = array.new_float()
var mbBearBoxes = array.new_box()
var mbBearMitig = array.new_bool()
var mbBearHi    = array.new_float()
var mbBearLo    = array.new_float()

dispBull  = showMB and candleRange[1] >= mbDispATR * atr14[1] and close[1] > open[1]
dispBear  = showMB and candleRange[1] >= mbDispATR * atr14[1] and close[1] < open[1]
oppBullMB = dispBull and close[2] < open[2]
oppBearMB = dispBear and close[2] > open[2]

if showMB and oppBullMB
    while array.size(mbBullBoxes) >= mbMaxBoxes
        box.delete(array.shift(mbBullBoxes))
        array.shift(mbBullMitig)
        array.shift(mbBullHi)
        array.shift(mbBullLo)
    b = box.new(bar_index - 2, high[2], bar_index, low[2], bgcolor=mbBullColor, border_color=mbBullColor, extend=extRight)
    array.push(mbBullBoxes, b)
    array.push(mbBullMitig, false)
    array.push(mbBullHi, high[2])
    array.push(mbBullLo, low[2])
    if lblAllowMB
        label.new(bar_index - 2, high[2], "MB", style=label.style_label_down, color=mbBullColor, textcolor=color.white, size=size.tiny)

if showMB and oppBearMB
    while array.size(mbBearBoxes) >= mbMaxBoxes
        box.delete(array.shift(mbBearBoxes))
        array.shift(mbBearMitig)
        array.shift(mbBearHi)
        array.shift(mbBearLo)
    b = box.new(bar_index - 2, high[2], bar_index, low[2], bgcolor=mbBearColor, border_color=mbBearColor, extend=extRight)
    array.push(mbBearBoxes, b)
    array.push(mbBearMitig, false)
    array.push(mbBearHi, high[2])
    array.push(mbBearLo, low[2])
    if lblAllowMB
        label.new(bar_index - 2, high[2], "MB", style=label.style_label_down, color=mbBearColor, textcolor=color.white, size=size.tiny)

if showMB and array.size(mbBullBoxes) > 0
    for i = 0 to array.size(mbBullBoxes) - 1
        if not array.get(mbBullMitig, i)
            if close < array.get(mbBullLo, i)
                box.delete(array.get(mbBullBoxes, i))
                array.set(mbBullMitig, i, true)
if showMB and array.size(mbBearBoxes) > 0
    for i = 0 to array.size(mbBearBoxes) - 1
        if not array.get(mbBearMitig, i)
            if close > array.get(mbBearHi, i)
                box.delete(array.get(mbBearBoxes, i))
                array.set(mbBearMitig, i, true)

// ══════════════════════════════════════════════════════════════════════════════
//  REJECTION BLOCKS
// ══════════════════════════════════════════════════════════════════════════════

grpRB = "Rejection Blocks"
showRB      = input.bool(true,  "Show Rejection Blocks", group=grpRB)
rbWickRatio = input.float(0.6,  "Min wick/range ratio",  group=grpRB, minval=0.4, maxval=0.9, step=0.05)
rbMaxBoxes  = input.int(3,      "Max RBs per side",      group=grpRB, minval=1, maxval=10)
rbHideMitig = input.bool(true,  "Hide mitigated RBs",    group=grpRB)
rbBullColor = input.color(color.new(#00BCD4, 70), "Bull RB", group=grpRB)
rbBearColor = input.color(color.new(#FF6D00, 70), "Bear RB", group=grpRB)

isBullRB = showRB and not na(lastPL) and low < lastPL and close > lastPL and candleRange > 0 and (lowerWick / candleRange >= rbWickRatio)
isBearRB = showRB and not na(lastPH) and high > lastPH and close < lastPH and candleRange > 0 and (upperWick / candleRange >= rbWickRatio)

var rbBullBoxes = array.new_box()
var rbBullMitig = array.new_bool()
var rbBullHi    = array.new_float()
var rbBullLo    = array.new_float()
var rbBearBoxes = array.new_box()
var rbBearMitig = array.new_bool()
var rbBearHi    = array.new_float()
var rbBearLo    = array.new_float()

if showRB and isBullRB
    while array.size(rbBullBoxes) >= rbMaxBoxes
        box.delete(array.shift(rbBullBoxes))
        array.shift(rbBullMitig)
        array.shift(rbBullHi)
        array.shift(rbBullLo)
    b = box.new(bar_index - 1, high, bar_index, low, bgcolor=rbBullColor, border_color=rbBullColor, extend=extRight)
    array.push(rbBullBoxes, b)
    array.push(rbBullMitig, false)
    array.push(rbBullHi, high)
    array.push(rbBullLo, low)
    if lblAllowRB
        label.new(bar_index, high, "RB", style=label.style_label_down, color=rbBullColor, textcolor=color.white, size=size.tiny)
if showRB and isBearRB
    while array.size(rbBearBoxes) >= rbMaxBoxes
        box.delete(array.shift(rbBearBoxes))
        array.shift(rbBearMitig)
        array.shift(rbBearHi)
        array.shift(rbBearLo)
    b = box.new(bar_index - 1, high, bar_index, low, bgcolor=rbBearColor, border_color=rbBearColor, extend=extRight)
    array.push(rbBearBoxes, b)
    array.push(rbBearMitig, false)
    array.push(rbBearHi, high)
    array.push(rbBearLo, low)
    if lblAllowRB
        label.new(bar_index, high, "RB", style=label.style_label_down, color=rbBearColor, textcolor=color.white, size=size.tiny)

if showRB and array.size(rbBullBoxes) > 0
    for i = 0 to array.size(rbBullBoxes) - 1
        if not array.get(rbBullMitig, i)
            if close < array.get(rbBullLo, i)
                if rbHideMitig
                    box.delete(array.get(rbBullBoxes, i))
                array.set(rbBullMitig, i, true)
if showRB and array.size(rbBearBoxes) > 0
    for i = 0 to array.size(rbBearBoxes) - 1
        if not array.get(rbBearMitig, i)
            if close > array.get(rbBearHi, i)
                if rbHideMitig
                    box.delete(array.get(rbBearBoxes, i))
                array.set(rbBearMitig, i, true)

// ══════════════════════════════════════════════════════════════════════════════
//  FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════════════════════

grpFVG = "Fair Value Gaps"
showFVG     = input.bool(true,  "Show FVGs",              group=grpFVG)
fvgMinSize  = input.float(0.1,  "Min gap % (0=any)",      group=grpFVG, minval=0.0, maxval=2.0, step=0.01)
fvgMinATR   = input.float(0.3,  "Min gap size (x ATR14)", group=grpFVG, minval=0.0, maxval=3.0, step=0.1)
fvgMaxBoxes = input.int(3,      "Max FVGs per side",      group=grpFVG, minval=1, maxval=15)
showFVGMid  = input.bool(true,  "Show midline (CE)",      group=grpFVG)
fvgBullColor= input.color(color.new(#00C853, 80), "Bull FVG", group=grpFVG)
fvgBearColor= input.color(color.new(#FF1744, 80), "Bear FVG", group=grpFVG)

minGapVal = close * fvgMinSize / 100.0
minGapATR = fvgMinATR > 0 and not na(atr14) ? fvgMinATR * atr14 : 0.0
isBullFVG = (low - high[2]) > math.max(minGapVal, minGapATR)
isBearFVG = (low[2] - high) > math.max(minGapVal, minGapATR)

var fvgBullBoxes = array.new_box()
var fvgBullLines = array.new_line()
var fvgBullTop   = array.new_float()
var fvgBullBot   = array.new_float()
var fvgBullDead  = array.new_bool()
var fvgBearBoxes = array.new_box()
var fvgBearLines = array.new_line()
var fvgBearTop   = array.new_float()
var fvgBearBot   = array.new_float()
var fvgBearDead  = array.new_bool()

if showFVG and isBullFVG
    while array.size(fvgBullBoxes) >= fvgMaxBoxes
        box.delete(array.shift(fvgBullBoxes))
        if array.size(fvgBullLines) > 0
            line.delete(array.shift(fvgBullLines))
        array.shift(fvgBullTop)
        array.shift(fvgBullBot)
        array.shift(fvgBullDead)
    gT = low
    gB = high[2]
    bx = box.new(bar_index[2], gT, bar_index, gB, bgcolor=fvgBullColor, border_color=fvgBullColor, extend=extRight)
    array.push(fvgBullBoxes, bx)
    array.push(fvgBullTop, gT)
    array.push(fvgBullBot, gB)
    array.push(fvgBullDead, false)
    if showFVGMid
        l = line.new(bar_index[2], math.avg(gT, gB), bar_index, math.avg(gT, gB), color=color.new(color.white, 50), style=line.style_dashed, extend=extRight)
        array.push(fvgBullLines, l)
    if lblAllowFVG
        label.new(bar_index, gT, "FVG", style=label.style_label_down, color=fvgBullColor, textcolor=color.white, size=size.tiny)

if showFVG and isBearFVG
    while array.size(fvgBearBoxes) >= fvgMaxBoxes
        box.delete(array.shift(fvgBearBoxes))
        if array.size(fvgBearLines) > 0
            line.delete(array.shift(fvgBearLines))
        array.shift(fvgBearTop)
        array.shift(fvgBearBot)
        array.shift(fvgBearDead)
    gT = low[2]
    gB = high
    bx = box.new(bar_index[2], gT, bar_index, gB, bgcolor=fvgBearColor, border_color=fvgBearColor, extend=extRight)
    array.push(fvgBearBoxes, bx)
    array.push(fvgBearTop, gT)
    array.push(fvgBearBot, gB)
    array.push(fvgBearDead, false)
    if showFVGMid
        l = line.new(bar_index[2], math.avg(gT, gB), bar_index, math.avg(gT, gB), color=color.new(color.white, 50), style=line.style_dashed, extend=extRight)
        array.push(fvgBearLines, l)
    if lblAllowFVG
        label.new(bar_index, gT, "FVG", style=label.style_label_down, color=fvgBearColor, textcolor=color.white, size=size.tiny)

if showFVG and array.size(fvgBullBoxes) > 0
    idxR = array.size(fvgBullBoxes) - 1
    while idxR >= 0
        if not array.get(fvgBullDead, idxR)
            gB = array.get(fvgBullBot, idxR)
            if close < gB
                box.delete(array.get(fvgBullBoxes, idxR))
                if idxR < array.size(fvgBullLines)
                    line.delete(array.get(fvgBullLines, idxR))
                array.set(fvgBullDead, idxR, true)
        idxR -= 1
if showFVG and array.size(fvgBearBoxes) > 0
    idxR = array.size(fvgBearBoxes) - 1
    while idxR >= 0
        if not array.get(fvgBearDead, idxR)
            gT = array.get(fvgBearTop, idxR)
            if close > gT
                box.delete(array.get(fvgBearBoxes, idxR))
                if idxR < array.size(fvgBearLines)
                    line.delete(array.get(fvgBearLines, idxR))
                array.set(fvgBearDead, idxR, true)
        idxR -= 1

// ══════════════════════════════════════════════════════════════════════════════
//  INVERSE FVGs
// ══════════════════════════════════════════════════════════════════════════════

grpIFVG = "Inverse FVGs"
showIFVG     = input.bool(true,  "Show IFVGs",            group=grpIFVG)
ifvgStrict   = input.bool(true,  "Require close inside",  group=grpIFVG)
ifvgMaxBoxes = input.int(2,      "Max IFVGs per side",    group=grpIFVG, minval=1, maxval=10)
ifvgBullColor= input.color(color.new(#FF6D00, 80), "Bull IFVG", group=grpIFVG)
ifvgBearColor= input.color(color.new(#AA00FF, 80), "Bear IFVG", group=grpIFVG)

var pendBullTop = array.new_float()
var pendBullBot = array.new_float()
var pendBullBar = array.new_int()
var pendBearTop = array.new_float()
var pendBearBot = array.new_float()
var pendBearBar = array.new_int()
var ifvgBullBoxes = array.new_box()
var ifvgBullTop   = array.new_float()
var ifvgBullBot   = array.new_float()
var ifvgBearBoxes = array.new_box()
var ifvgBearTop   = array.new_float()
var ifvgBearBot   = array.new_float()
var int MAX_PEND = 20

if showIFVG
    if isBullFVG
        if array.size(pendBullTop) >= MAX_PEND
            array.shift(pendBullTop)
            array.shift(pendBullBot)
            array.shift(pendBullBar)
        array.push(pendBullTop, low)
        array.push(pendBullBot, high[2])
        array.push(pendBullBar, bar_index[2])
    if isBearFVG
        if array.size(pendBearTop) >= MAX_PEND
            array.shift(pendBearTop)
            array.shift(pendBearBot)
            array.shift(pendBearBar)
        array.push(pendBearTop, low[2])
        array.push(pendBearBot, high)
        array.push(pendBearBar, bar_index[2])

    idx = 0
    while idx < array.size(pendBullTop)
        t  = array.get(pendBullTop, idx)
        b2 = array.get(pendBullBot, idx)
        sB = array.get(pendBullBar, idx)
        hit = ifvgStrict ? (close <= t and close >= b2) : (low <= t and high >= b2)
        if hit
            while array.size(ifvgBullBoxes) >= ifvgMaxBoxes
                box.delete(array.shift(ifvgBullBoxes))
                array.shift(ifvgBullTop)
                array.shift(ifvgBullBot)
            array.push(ifvgBullBoxes, box.new(sB, t, bar_index, b2, bgcolor=ifvgBullColor, border_color=ifvgBullColor, extend=extRight))
            array.push(ifvgBullTop, t)
            array.push(ifvgBullBot, b2)
            if lblAllowIFVG
                label.new(bar_index, t, "IFVG", style=label.style_label_down, color=ifvgBullColor, textcolor=color.white, size=size.tiny)
            array.remove(pendBullTop, idx)
            array.remove(pendBullBot, idx)
            array.remove(pendBullBar, idx)
        else
            idx += 1
    idx2 = 0
    while idx2 < array.size(pendBearTop)
        t  = array.get(pendBearTop, idx2)
        b2 = array.get(pendBearBot, idx2)
        sB = array.get(pendBearBar, idx2)
        hit = ifvgStrict ? (close <= t and close >= b2) : (low <= t and high >= b2)
        if hit
            while array.size(ifvgBearBoxes) >= ifvgMaxBoxes
                box.delete(array.shift(ifvgBearBoxes))
                array.shift(ifvgBearTop)
                array.shift(ifvgBearBot)
            array.push(ifvgBearBoxes, box.new(sB, t, bar_index, b2, bgcolor=ifvgBearColor, border_color=ifvgBearColor, extend=extRight))
            array.push(ifvgBearTop, t)
            array.push(ifvgBearBot, b2)
            if lblAllowIFVG
                label.new(bar_index, t, "IFVG", style=label.style_label_down, color=ifvgBearColor, textcolor=color.white, size=size.tiny)
            array.remove(pendBearTop, idx2)
            array.remove(pendBearBot, idx2)
            array.remove(pendBearBar, idx2)
        else
            idx2 += 1

if showIFVG and array.size(ifvgBullBoxes) > 0
    idxR = array.size(ifvgBullBoxes) - 1
    while idxR >= 0
        gB = array.get(ifvgBullBot, idxR)
        if close < gB
            box.delete(array.get(ifvgBullBoxes, idxR))
            array.remove(ifvgBullBoxes, idxR)
            array.remove(ifvgBullTop, idxR)
            array.remove(ifvgBullBot, idxR)
        idxR -= 1
if showIFVG and array.size(ifvgBearBoxes) > 0
    idxR = array.size(ifvgBearBoxes) - 1
    while idxR >= 0
        gT = array.get(ifvgBearTop, idxR)
        if close > gT
            box.delete(array.get(ifvgBearBoxes, idxR))
            array.remove(ifvgBearBoxes, idxR)
            array.remove(ifvgBearTop, idxR)
            array.remove(ifvgBearBot, idxR)
        idxR -= 1

// ══════════════════════════════════════════════════════════════════════════════
//  DISPLACEMENT
// ══════════════════════════════════════════════════════════════════════════════

grpDISP2 = "Displacement"
showDisp = input.bool(true,  "Highlight displacement candles", group=grpDISP2)
dispMul  = input.float(1.7,  "Min x ATR(14)",                  group=grpDISP2, minval=1.0, maxval=5.0, step=0.1)
dispBullCol = input.color(color.new(#69F0AE, 0), "Bull displacement", group=grpDISP2)
dispBearCol = input.color(color.new(#FF5252, 0), "Bear displacement", group=grpDISP2)

isDispBull = candleRange >= dispMul * atr14 and close > open
isDispBear = candleRange >= dispMul * atr14 and close < open

if isDispBull
    lastDispBullBar_e := bar_index
if isDispBear
    lastDispBearBar_e := bar_index

plotshape(showDisp and isDispBull, title="Displacement bull", location=location.belowbar, style=shape.arrowup,   color=dispBullCol, size=size.tiny)
plotshape(showDisp and isDispBear, title="Displacement bear", location=location.abovebar, style=shape.arrowdown, color=dispBearCol, size=size.tiny)
barcolor(showDisp and isDispBull ? color.new(dispBullCol, 50) : showDisp and isDispBear ? color.new(dispBearCol, 50) : na, title="Displacement bar color")

// ══════════════════════════════════════════════════════════════════════════════
//  PROXIMITY VISIBILITY
// ══════════════════════════════════════════════════════════════════════════════

if proxEnable and barstate.islast
    if showOB and array.size(obBullBoxes) > 0
        for i = 0 to array.size(obBullBoxes) - 1
            if not array.get(obBullMitig, i)
                near = zoneNear(array.get(obBullHi, i), array.get(obBullLo, i))
                box.set_bgcolor(array.get(obBullBoxes, i), near ? obBullColor : fadeColor(obBullColor))
                box.set_border_color(array.get(obBullBoxes, i), near ? obBullColor : fadeColor(obBullColor))
    if showOB and array.size(obBearBoxes) > 0
        for i = 0 to array.size(obBearBoxes) - 1
            if not array.get(obBearMitig, i)
                near = zoneNear(array.get(obBearHi, i), array.get(obBearLo, i))
                box.set_bgcolor(array.get(obBearBoxes, i), near ? obBearColor : fadeColor(obBearColor))
                box.set_border_color(array.get(obBearBoxes, i), near ? obBearColor : fadeColor(obBearColor))
    if showBB and array.size(bbBullBoxes) > 0
        for i = 0 to array.size(bbBullBoxes) - 1
            if not array.get(bbBullMitig, i)
                near = zoneNear(array.get(bbBullHi, i), array.get(bbBullLo, i))
                box.set_bgcolor(array.get(bbBullBoxes, i), near ? bbBullColor : fadeColor(bbBullColor))
                box.set_border_color(array.get(bbBullBoxes, i), near ? bbBullColor : fadeColor(bbBullColor))
    if showBB and array.size(bbBearBoxes) > 0
        for i = 0 to array.size(bbBearBoxes) - 1
            if not array.get(bbBearMitig, i)
                near = zoneNear(array.get(bbBearHi, i), array.get(bbBearLo, i))
                box.set_bgcolor(array.get(bbBearBoxes, i), near ? bbBearColor : fadeColor(bbBearColor))
                box.set_border_color(array.get(bbBearBoxes, i), near ? bbBearColor : fadeColor(bbBearColor))

    if showFVG and array.size(fvgBullBoxes) > 0
        for i = 0 to array.size(fvgBullBoxes) - 1
            if not array.get(fvgBullDead, i)
                near = zoneNear(array.get(fvgBullTop, i), array.get(fvgBullBot, i))
                box.set_bgcolor(array.get(fvgBullBoxes, i), near ? fvgBullColor : fadeColor(fvgBullColor))
                box.set_border_color(array.get(fvgBullBoxes, i), near ? fvgBullColor : fadeColor(fvgBullColor))
    if showFVG and array.size(fvgBearBoxes) > 0
        for i = 0 to array.size(fvgBearBoxes) - 1
            if not array.get(fvgBearDead, i)
                near = zoneNear(array.get(fvgBearTop, i), array.get(fvgBearBot, i))
                box.set_bgcolor(array.get(fvgBearBoxes, i), near ? fvgBearColor : fadeColor(fvgBearColor))
                box.set_border_color(array.get(fvgBearBoxes, i), near ? fvgBearColor : fadeColor(fvgBearColor))


// ══════════════════════════════════════════════════════════════════════════════
//  MINI DASHBOARD  (Part 1 — Structure & Zones)
// ══════════════════════════════════════════════════════════════════════════════

grpDASH = "Dashboard"
showDashboard = input.bool(true, "Show Dashboard", group=grpDASH)
dashPosIn     = input.string("top_right", "Position", group=grpDASH, options=["top_right","top_left","middle_right","middle_left","bottom_right","bottom_left"])
dashSizeIn    = input.string("small", "Text size", group=grpDASH, options=["tiny","small","normal","large"])

dashPos = dashPosIn == "top_right"     ? position.top_right     :
          dashPosIn == "top_left"      ? position.top_left      :
          dashPosIn == "middle_right"  ? position.middle_right  :
          dashPosIn == "middle_left"   ? position.middle_left   :
          dashPosIn == "bottom_right"  ? position.bottom_right  :
          position.bottom_left
dashSz = dashSizeIn == "tiny"   ? size.tiny   :
         dashSizeIn == "small"  ? size.small  :
         dashSizeIn == "large"  ? size.large  :
         size.normal

countOBBull   = 0
countOBBear   = 0
countOBKZBull = 0
countOBKZBear = 0
countFVGBull  = 0
countFVGBear  = 0
countBBBull   = 0
countBBBear   = 0
countBBKZBull = 0
countBBKZBear = 0
if array.size(obBullBoxes) > 0
    for i = 0 to array.size(obBullBoxes) - 1
        if not array.get(obBullMitig, i)
            countOBBull += 1
            if array.get(obBullKZ, i)
                countOBKZBull += 1
if array.size(obBearBoxes) > 0
    for i = 0 to array.size(obBearBoxes) - 1
        if not array.get(obBearMitig, i)
            countOBBear += 1
            if array.get(obBearKZ, i)
                countOBKZBear += 1
if array.size(fvgBullBoxes) > 0
    for i = 0 to array.size(fvgBullBoxes) - 1
        if not array.get(fvgBullDead, i)
            countFVGBull += 1
if array.size(fvgBearBoxes) > 0
    for i = 0 to array.size(fvgBearBoxes) - 1
        if not array.get(fvgBearDead, i)
            countFVGBear += 1
if array.size(bbBullBoxes) > 0
    for i = 0 to array.size(bbBullBoxes) - 1
        if not array.get(bbBullMitig, i)
            countBBBull += 1
            if array.get(bbBullKZ, i)
                countBBKZBull += 1
if array.size(bbBearBoxes) > 0
    for i = 0 to array.size(bbBearBoxes) - 1
        if not array.get(bbBearMitig, i)
            countBBBear += 1
            if array.get(bbBearKZ, i)
                countBBKZBear += 1

var table dash = table.new(dashPos, 2, 10, bgcolor=color.new(#0A0A0A, 10), border_width=1, frame_color=color.new(color.gray, 50), frame_width=1, border_color=color.new(color.gray, 70))

if showDashboard and barstate.islast
    headerBg = color.new(#1A1A2E, 0)
    table.cell(dash, 0, 0, "SMC v21 — P1", text_color=color.white, bgcolor=headerBg, text_size=dashSz)
    kzTxt = inAnyKZ ? (inLondonKZ ? "LDN KZ" : "NY KZ") : "—"
    table.cell(dash, 1, 0, kzTxt, text_color=inAnyKZ ? color.new(#FFD600, 0) : color.gray, bgcolor=headerBg, text_size=size.tiny)

    intTrTxt = intTrend == 1 ? "BULL" : intTrend == -1 ? "BEAR" : "-"
    intTrCol = intTrend == 1 ? bullStructColor : intTrend == -1 ? bearStructColor : color.gray
    table.cell(dash, 0, 1, "Internal trend", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 1, intTrTxt, text_color=intTrCol, text_size=dashSz)

    extTrTxt = extTrend == 1 ? "BULL" : extTrend == -1 ? "BEAR" : "-"
    extTrCol = extTrend == 1 ? bullStructColor : extTrend == -1 ? bearStructColor : color.gray
    table.cell(dash, 0, 2, "External trend", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 2, extTrTxt, text_color=extTrCol, text_size=dashSz)

    obTxt = "B" + str.tostring(countOBBull) + " S" + str.tostring(countOBBear)
    table.cell(dash, 0, 3, "Active OBs", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 3, obTxt, text_color=color.new(color.yellow, 0), text_size=dashSz)

    obKZTxt = "★B" + str.tostring(countOBKZBull) + " ★S" + str.tostring(countOBKZBear)
    table.cell(dash, 0, 4, "Killzone OBs", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 4, obKZTxt, text_color=color.new(#FFD600, 0), text_size=dashSz)

    fvgTxt = "B" + str.tostring(countFVGBull) + " S" + str.tostring(countFVGBear)
    table.cell(dash, 0, 5, "Active FVGs", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 5, fvgTxt, text_color=color.new(color.yellow, 0), text_size=dashSz)

    bbTxt = "B" + str.tostring(countBBBull) + " S" + str.tostring(countBBBear)
    table.cell(dash, 0, 6, "Active BBs", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 6, bbTxt, text_color=color.new(color.yellow, 0), text_size=dashSz)

    bbKZTxt = "★B" + str.tostring(countBBKZBull) + " ★S" + str.tostring(countBBKZBear)
    table.cell(dash, 0, 7, "Killzone BBs", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 7, bbKZTxt, text_color=color.new(#FFD600, 0), text_size=dashSz)

    dispTxt = isDispBull ? "BULL" : isDispBear ? "BEAR" : "-"
    dispCol = isDispBull ? color.new(#00E676, 0) : isDispBear ? color.new(#FF5252, 0) : color.gray
    table.cell(dash, 0, 8, "Displacement", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 8, dispTxt, text_color=color.new(dispCol, 0), text_size=dashSz)

    table.cell(dash, 0, 9, "ATR(14)", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 9, str.tostring(atr14, format.mintick), text_color=color.new(color.gray, 0), text_size=dashSz)

// ══════════════════════════════════════════════════════════════════════════════
//  ALERTS
//  NOTE: the legacy alertcondition() calls were removed — in Pine each one
//  counts toward the 64-"plot" limit (RE10140). Use the dynamic alert() events
//  instead: add ONE alert on this indicator with the condition
//  "Any alert() function call". Those events cover composite A+ setups,
//  reversals, liquidity sweeps, session-move expansions, and entry-grade
//  threshold crossings — everything the old named alerts did.
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
//  ENTRY DASHBOARD  (10-point setup grading)
//
//  Reads the events Part 1 already detects (trend, CHoCH, BOS, ★OB, ★BB,
//  killzone, displacement) and grades each side out of 10.
//
//   0–3   SKIP — almost no confluence
//   4–6   WAIT — wait for a trigger
//   7–8   READY — take it on retest with confirmation
//   9–10  A+ — multiple confluences aligned, take it bigger
// ══════════════════════════════════════════════════════════════════════════════

grpEntry = "Entry Dashboard"
showEntryDash = input.bool(true, "Show entry dashboard", group=grpEntry)
entryDashPos  = input.string("middle_left", "Position", group=grpEntry, options=["top_right","top_left","middle_right","middle_left","bottom_right","bottom_left"])
entryDashSz   = input.string("normal", "Size", group=grpEntry, options=["tiny","small","normal","large"])

chochWin_e = input.int(10, "CHoCH window (bars)",        group=grpEntry, minval=2, maxval=50, tooltip="A recent CHoCH within this many bars counts as a confluence.")
bosWin_e   = input.int(15, "BOS window (bars)",          group=grpEntry, minval=2, maxval=50)
dispWin_e  = input.int(5,  "Displacement window (bars)", group=grpEntry, minval=1, maxval=20)
readyThr_e = input.int(7,  "READY threshold",            group=grpEntry, minval=4, maxval=10)
aplusThr_e = input.int(9,  "A+ threshold",               group=grpEntry, minval=7, maxval=10)
fireEntryAlt = input.bool(true, "Fire alert on threshold cross", group=grpEntry)

// ── Confluence flags ─────────────────────────────────────────────────────────
bullTrend_e = extTrend ==  1
bearTrend_e = extTrend == -1
bullCHoCH_e = (bar_index - lastBullCHoCHBar_e) <= chochWin_e
bearCHoCH_e = (bar_index - lastBearCHoCHBar_e) <= chochWin_e
bullBOS_e   = (bar_index - lastBullBOSBar_e)   <= bosWin_e
bearBOS_e   = (bar_index - lastBearBOSBar_e)   <= bosWin_e
bullDisp_e  = (bar_index - lastDispBullBar_e)  <= dispWin_e
bearDisp_e  = (bar_index - lastDispBearBar_e)  <= dispWin_e
kz_e        = inAnyKZ
bullKZOB_e  = countOBKZBull > 0
bearKZOB_e  = countOBKZBear > 0
bullKZBB_e  = countBBKZBull > 0
bearKZBB_e  = countBBKZBear > 0

// ── Score (out of 10) ────────────────────────────────────────────────────────
bullScore_e = 0
if bullTrend_e
    bullScore_e += 2
if bullCHoCH_e
    bullScore_e += 2
if bullBOS_e
    bullScore_e += 1
if kz_e
    bullScore_e += 1
if bullKZOB_e
    bullScore_e += 2
if bullKZBB_e
    bullScore_e += 1
if bullDisp_e
    bullScore_e += 1

bearScore_e = 0
if bearTrend_e
    bearScore_e += 2
if bearCHoCH_e
    bearScore_e += 2
if bearBOS_e
    bearScore_e += 1
if kz_e
    bearScore_e += 1
if bearKZOB_e
    bearScore_e += 2
if bearKZBB_e
    bearScore_e += 1
if bearDisp_e
    bearScore_e += 1

bullStatus_e = bullScore_e >= aplusThr_e ? "A+" : bullScore_e >= readyThr_e ? "READY" : bullScore_e >= 4 ? "WAIT" : "SKIP"
bearStatus_e = bearScore_e >= aplusThr_e ? "A+" : bearScore_e >= readyThr_e ? "READY" : bearScore_e >= 4 ? "WAIT" : "SKIP"
bullCol_e = bullScore_e >= aplusThr_e ? color.new(#00E676, 0) : bullScore_e >= readyThr_e ? color.new(#26A69A, 0) : bullScore_e >= 4 ? color.new(#FFB300, 0) : color.gray
bearCol_e = bearScore_e >= aplusThr_e ? color.new(#FF5252, 0) : bearScore_e >= readyThr_e ? color.new(#EF5350, 0) : bearScore_e >= 4 ? color.new(#FFB300, 0) : color.gray

// ── Position helpers ─────────────────────────────────────────────────────────
entryPos_e = entryDashPos == "top_right"     ? position.top_right     :
             entryDashPos == "top_left"      ? position.top_left      :
             entryDashPos == "middle_right"  ? position.middle_right  :
             entryDashPos == "middle_left"   ? position.middle_left   :
             entryDashPos == "bottom_right"  ? position.bottom_right  :
             position.bottom_left
entrySz_e  = entryDashSz == "tiny" ? size.tiny : entryDashSz == "small" ? size.small : entryDashSz == "large" ? size.large : size.normal

ok_e(b)    => b ? "✓" : "✗"
okCol_e(b) => b ? color.new(#00E676, 0) : color.new(color.gray, 30)

var table dashEntry = table.new(entryPos_e, 3, 11, bgcolor=color.new(#0A0A0A, 5), border_width=1, frame_color=color.new(color.gray, 30), frame_width=1, border_color=color.new(color.gray, 60))

if showEntryDash and barstate.islast
    hb_e = color.new(#1A1A2E, 0)
    table.cell(dashEntry, 0, 0, "ENTRY GRADE", text_color=color.white, bgcolor=hb_e, text_size=entrySz_e)
    table.cell(dashEntry, 1, 0, "BULL",        text_color=color.new(#00E676, 0), bgcolor=hb_e, text_size=entrySz_e)
    table.cell(dashEntry, 2, 0, "BEAR",        text_color=color.new(#FF5252, 0), bgcolor=hb_e, text_size=entrySz_e)

    table.cell(dashEntry, 0, 1, "SCORE / 10", text_color=color.white, text_size=entrySz_e)
    table.cell(dashEntry, 1, 1, str.tostring(bullScore_e) + " " + bullStatus_e, text_color=bullCol_e, text_size=entrySz_e)
    table.cell(dashEntry, 2, 1, str.tostring(bearScore_e) + " " + bearStatus_e, text_color=bearCol_e, text_size=entrySz_e)

    table.cell(dashEntry, 0, 2, "Trend", text_color=color.white, text_size=entrySz_e)
    table.cell(dashEntry, 1, 2, ok_e(bullTrend_e), text_color=okCol_e(bullTrend_e), text_size=entrySz_e)
    table.cell(dashEntry, 2, 2, ok_e(bearTrend_e), text_color=okCol_e(bearTrend_e), text_size=entrySz_e)

    table.cell(dashEntry, 0, 3, "CHoCH <" + str.tostring(chochWin_e) + "b", text_color=color.white, text_size=entrySz_e)
    table.cell(dashEntry, 1, 3, ok_e(bullCHoCH_e), text_color=okCol_e(bullCHoCH_e), text_size=entrySz_e)
    table.cell(dashEntry, 2, 3, ok_e(bearCHoCH_e), text_color=okCol_e(bearCHoCH_e), text_size=entrySz_e)

    table.cell(dashEntry, 0, 4, "BOS <" + str.tostring(bosWin_e) + "b", text_color=color.white, text_size=entrySz_e)
    table.cell(dashEntry, 1, 4, ok_e(bullBOS_e), text_color=okCol_e(bullBOS_e), text_size=entrySz_e)
    table.cell(dashEntry, 2, 4, ok_e(bearBOS_e), text_color=okCol_e(bearBOS_e), text_size=entrySz_e)

    table.cell(dashEntry, 0, 5, "Killzone", text_color=color.white, text_size=entrySz_e)
    table.cell(dashEntry, 1, 5, ok_e(kz_e), text_color=okCol_e(kz_e), text_size=entrySz_e)
    table.cell(dashEntry, 2, 5, ok_e(kz_e), text_color=okCol_e(kz_e), text_size=entrySz_e)

    table.cell(dashEntry, 0, 6, "★OB", text_color=color.white, text_size=entrySz_e)
    table.cell(dashEntry, 1, 6, ok_e(bullKZOB_e), text_color=okCol_e(bullKZOB_e), text_size=entrySz_e)
    table.cell(dashEntry, 2, 6, ok_e(bearKZOB_e), text_color=okCol_e(bearKZOB_e), text_size=entrySz_e)

    table.cell(dashEntry, 0, 7, "★BB", text_color=color.white, text_size=entrySz_e)
    table.cell(dashEntry, 1, 7, ok_e(bullKZBB_e), text_color=okCol_e(bullKZBB_e), text_size=entrySz_e)
    table.cell(dashEntry, 2, 7, ok_e(bearKZBB_e), text_color=okCol_e(bearKZBB_e), text_size=entrySz_e)

    table.cell(dashEntry, 0, 8, "Disp <" + str.tostring(dispWin_e) + "b", text_color=color.white, text_size=entrySz_e)
    table.cell(dashEntry, 1, 8, ok_e(bullDisp_e), text_color=okCol_e(bullDisp_e), text_size=entrySz_e)
    table.cell(dashEntry, 2, 8, ok_e(bearDisp_e), text_color=okCol_e(bearDisp_e), text_size=entrySz_e)

    bullAct_e = bullScore_e >= aplusThr_e ? "TAKE BIG" : bullScore_e >= readyThr_e ? "RETEST OK" : bullScore_e >= 4 ? "WAIT" : "—"
    bearAct_e = bearScore_e >= aplusThr_e ? "TAKE BIG" : bearScore_e >= readyThr_e ? "RETEST OK" : bearScore_e >= 4 ? "WAIT" : "—"
    table.cell(dashEntry, 0, 9, "ACTION", text_color=color.white, bgcolor=hb_e, text_size=entrySz_e)
    table.cell(dashEntry, 1, 9, bullAct_e, text_color=bullCol_e, bgcolor=hb_e, text_size=entrySz_e)
    table.cell(dashEntry, 2, 9, bearAct_e, text_color=bearCol_e, bgcolor=hb_e, text_size=entrySz_e)

// ── Entry alerts (cross-up of threshold) ─────────────────────────────────────
bullReady_e = bullScore_e >= readyThr_e and (bullScore_e[1] < readyThr_e or na(bullScore_e[1]))
bearReady_e = bearScore_e >= readyThr_e and (bearScore_e[1] < readyThr_e or na(bearScore_e[1]))
bullAplus_e = bullScore_e >= aplusThr_e and (bullScore_e[1] < aplusThr_e or na(bullScore_e[1]))
bearAplus_e = bearScore_e >= aplusThr_e and (bearScore_e[1] < aplusThr_e or na(bearScore_e[1]))

sym_e = syminfo.ticker
tf_e  = timeframe.period
prc_e = str.tostring(close, format.mintick)

entryEvt = bullAplus_e ? "BULL A+" : bearAplus_e ? "BEAR A+" : bullReady_e ? "BULL READY" : bearReady_e ? "BEAR READY" : ""
entryScr = bullAplus_e or bullReady_e ? bullScore_e : bearScore_e
if fireEntryAlt and entryEvt != ""
    alert("[" + sym_e + " " + tf_e + "] " + entryEvt + " entry " + str.tostring(entryScr) + "/10 @ " + prc_e, alert.freq_once_per_bar_close)

plotshape(bullReady_e, title="Bull READY entry", location=location.belowbar, style=shape.flag, color=color.new(#00E676, 0), size=size.normal, text="ENTRY")
plotshape(bearReady_e, title="Bear READY entry", location=location.abovebar, style=shape.flag, color=color.new(#FF5252, 0), size=size.normal, text="ENTRY")

// Entry-grade alerts fire via alert() above — subscribe with "Any alert() function call".


// ╔══════════════════════════════════════════════════════════════════════════╗
// ║  PART 2  —  CONTEXT, LIQUIDITY, HTF & COMPOSITE SIGNALS                     ║
// ╚══════════════════════════════════════════════════════════════════════════╝

// ══════════════════════════════════════════════════════════════════════════════
//  VOLUME IMBALANCES  (boxes default OFF; booleans always exposed)
// ══════════════════════════════════════════════════════════════════════════════

grpVI = "Volume Imbalances"
showVIBox = input.bool(false, "Show VI boxes (cluttery)", group=grpVI)
viMaxBoxes= input.int(4,      "Max VIs per side",         group=grpVI, minval=1, maxval=12)
viBullColor= input.color(color.new(#80DEEA, 75), "Bull VI", group=grpVI)
viBearColor= input.color(color.new(#FFAB91, 75), "Bear VI", group=grpVI)

isBullVI = close[1] > open[1] and close > open and open > close[1] and (open - close[1]) > 0
isBearVI = close[1] < open[1] and close < open and open < close[1] and (close[1] - open) > 0

var viBullBoxes = array.new_box()
var viBullTop   = array.new_float()
var viBullBot   = array.new_float()
var viBullDead  = array.new_bool()
var viBearBoxes = array.new_box()
var viBearTop   = array.new_float()
var viBearBot   = array.new_float()
var viBearDead  = array.new_bool()

if showVIBox and isBullVI
    while array.size(viBullBoxes) >= viMaxBoxes
        box.delete(array.shift(viBullBoxes))
        array.shift(viBullTop)
        array.shift(viBullBot)
        array.shift(viBullDead)
    bx = box.new(bar_index - 1, open, bar_index, close[1], bgcolor=viBullColor, border_color=viBullColor, extend=extRight)
    array.push(viBullBoxes, bx)
    array.push(viBullTop, open)
    array.push(viBullBot, close[1])
    array.push(viBullDead, false)
if showVIBox and isBearVI
    while array.size(viBearBoxes) >= viMaxBoxes
        box.delete(array.shift(viBearBoxes))
        array.shift(viBearTop)
        array.shift(viBearBot)
        array.shift(viBearDead)
    bx = box.new(bar_index - 1, close[1], bar_index, open, bgcolor=viBearColor, border_color=viBearColor, extend=extRight)
    array.push(viBearBoxes, bx)
    array.push(viBearTop, close[1])
    array.push(viBearBot, open)
    array.push(viBearDead, false)

if showVIBox and array.size(viBullBoxes) > 0
    idxR = array.size(viBullBoxes) - 1
    while idxR >= 0
        if not array.get(viBullDead, idxR)
            if close < array.get(viBullBot, idxR)
                box.delete(array.get(viBullBoxes, idxR))
                array.set(viBullDead, idxR, true)
        idxR -= 1
if showVIBox and array.size(viBearBoxes) > 0
    idxR = array.size(viBearBoxes) - 1
    while idxR >= 0
        if not array.get(viBearDead, idxR)
            if close > array.get(viBearTop, idxR)
                box.delete(array.get(viBearBoxes, idxR))
                array.set(viBearDead, idxR, true)
        idxR -= 1

// ══════════════════════════════════════════════════════════════════════════════
//  LIQUIDITY  (EQH / EQL + sweeps)  — flexible tolerance (Percent / Ticks / ATR)
// ══════════════════════════════════════════════════════════════════════════════

grpLIQ = "Liquidity (EQH/EQL)"
showLIQ      = input.bool(true,  "Show EQH/EQL",            group=grpLIQ)
liqLookback  = input.int(10,     "Pivot lookback",          group=grpLIQ, minval=3, maxval=50)
liqTolMode   = input.string("Percent", "Tolerance mode", group=grpLIQ, options=["Percent","Ticks","ATR"], tooltip="Percent: % of price (suits FX/index)\nTicks: number of mintick units (suits any asset)\nATR: fraction of ATR(14)")
liqTolerance = input.float(0.05, "Tolerance (Percent mode)", group=grpLIQ, minval=0.001, maxval=2.0, step=0.005)
liqTolTicks  = input.int(50,     "Tolerance (Ticks mode)",  group=grpLIQ, minval=1, maxval=10000)
liqTolATR    = input.float(0.10, "Tolerance (ATR mode)",    group=grpLIQ, minval=0.01, maxval=2.0, step=0.01)
liqMinTouch  = input.int(2,      "Min pivots to confirm",   group=grpLIQ, minval=2, maxval=5)
liqMaxLines  = input.int(5,      "Max levels per side",     group=grpLIQ, minval=1, maxval=12)
liqEQHColor  = input.color(color.new(#FF5252, 50), "EQH (BSL)", group=grpLIQ)
liqEQLColor  = input.color(color.new(#69F0AE, 50), "EQL (SSL)", group=grpLIQ)
liqSweptHide = input.bool(false, "Hide swept lines",        group=grpLIQ)
showSweepLbl = input.bool(true,  "Show sweep markers",      group=grpLIQ)
showBSLSSLLbl= input.bool(true,  "Tag BSL / SSL",           group=grpLIQ)

// Resolve tolerance to absolute price units, asset-aware
liqTolAbs(price) =>
    switch liqTolMode
        "Ticks"   => liqTolTicks * syminfo.mintick
        "ATR"     => not na(atr14) ? liqTolATR * atr14 : price * liqTolerance / 100.0
        =>           price * liqTolerance / 100.0

liqPH = ta.pivothigh(high, liqLookback, liqLookback)
liqPL = ta.pivotlow(low,   liqLookback, liqLookback)

var pendHighLvl = array.new_float()
var pendHighBar = array.new_int()
var pendLowLvl  = array.new_float()
var pendLowBar  = array.new_int()
var liqHighLines  = array.new_line()
var liqHighLevels = array.new_float()
var liqHighSwept  = array.new_bool()
var liqLowLines   = array.new_line()
var liqLowLevels  = array.new_float()
var liqLowSwept   = array.new_bool()
var int PEND_KEEP = 12

if showLIQ and not na(liqPH)
    if array.size(pendHighLvl) >= PEND_KEEP
        array.shift(pendHighLvl)
        array.shift(pendHighBar)
    array.push(pendHighLvl, liqPH)
    array.push(pendHighBar, bar_index - liqLookback)
    tolVal = liqTolAbs(liqPH)
    matched = false
    if array.size(liqHighLevels) > 0
        for i = 0 to array.size(liqHighLevels) - 1
            if not array.get(liqHighSwept, i)
                if math.abs(array.get(liqHighLevels, i) - liqPH) <= tolVal
                    matched := true
                    break

    cluster = 0
    earliestBar = bar_index
    if array.size(pendHighLvl) > 0
        for i = 0 to array.size(pendHighLvl) - 1
            if math.abs(array.get(pendHighLvl, i) - liqPH) <= tolVal
                cluster += 1
                pb = array.get(pendHighBar, i)
                if pb < earliestBar
                    earliestBar := pb
    if not matched and cluster >= liqMinTouch
        while array.size(liqHighLevels) >= liqMaxLines
            line.delete(array.shift(liqHighLines))
            array.shift(liqHighLevels)
            array.shift(liqHighSwept)
        l = line.new(earliestBar, liqPH, bar_index, liqPH, color=liqEQHColor, style=line.style_dashed, width=1, extend=extend.right)
        array.push(liqHighLines, l)
        array.push(liqHighLevels, liqPH)
        array.push(liqHighSwept, false)
        if lblAllowPD
            tag = showBSLSSLLbl ? "BSL" : "EQH"
            label.new(bar_index - liqLookback, liqPH, tag, style=label.style_label_down, color=liqEQHColor, textcolor=color.white, size=size.tiny)

if showLIQ and not na(liqPL)
    if array.size(pendLowLvl) >= PEND_KEEP
        array.shift(pendLowLvl)
        array.shift(pendLowBar)
    array.push(pendLowLvl, liqPL)
    array.push(pendLowBar, bar_index - liqLookback)
    tolVal = liqTolAbs(liqPL)
    matched = false
    if array.size(liqLowLevels) > 0
        for i = 0 to array.size(liqLowLevels) - 1
            if not array.get(liqLowSwept, i)
                if math.abs(array.get(liqLowLevels, i) - liqPL) <= tolVal
                    matched := true
                    break
    cluster = 0
    earliestBar = bar_index
    if array.size(pendLowLvl) > 0
        for i = 0 to array.size(pendLowLvl) - 1
            if math.abs(array.get(pendLowLvl, i) - liqPL) <= tolVal
                cluster += 1
                pb = array.get(pendLowBar, i)
                if pb < earliestBar
                    earliestBar := pb

    if not matched and cluster >= liqMinTouch
        while array.size(liqLowLevels) >= liqMaxLines
            line.delete(array.shift(liqLowLines))
            array.shift(liqLowLevels)
            array.shift(liqLowSwept)
        l = line.new(earliestBar, liqPL, bar_index, liqPL, color=liqEQLColor, style=line.style_dashed, width=1, extend=extend.right)
        array.push(liqLowLines, l)
        array.push(liqLowLevels, liqPL)
        array.push(liqLowSwept, false)
        if lblAllowPD
            tag = showBSLSSLLbl ? "SSL" : "EQL"
            label.new(bar_index - liqLookback, liqPL, tag, style=label.style_label_up, color=liqEQLColor, textcolor=color.white, size=size.tiny)

var int lastEQLSweepBar = -9999
var int lastEQHSweepBar = -9999

if showLIQ and array.size(liqHighLevels) > 0
    for i = 0 to array.size(liqHighLevels) - 1
        if not array.get(liqHighSwept, i)
            if close > array.get(liqHighLevels, i)
                if liqSweptHide
                    line.delete(array.get(liqHighLines, i))
                else
                    line.set_color(array.get(liqHighLines, i), color.new(liqEQHColor, 85))
                array.set(liqHighSwept, i, true)
if showLIQ and array.size(liqLowLevels) > 0
    for i = 0 to array.size(liqLowLevels) - 1
        if not array.get(liqLowSwept, i)
            if close < array.get(liqLowLevels, i)
                if liqSweptHide
                    line.delete(array.get(liqLowLines, i))
                else
                    line.set_color(array.get(liqLowLines, i), color.new(liqEQLColor, 85))
                array.set(liqLowSwept, i, true)

sweepEQL = false
sweepEQH = false
if showLIQ and array.size(liqLowLevels) > 0
    for i = 0 to array.size(liqLowLevels) - 1
        if not array.get(liqLowSwept, i)
            lvl = array.get(liqLowLevels, i)
            if low < lvl and close > lvl
                lastEQLSweepBar := bar_index
                array.set(liqLowSwept, i, true)
                sweepEQL := true
                if liqSweptHide
                    line.delete(array.get(liqLowLines, i))
                else
                    line.set_color(array.get(liqLowLines, i), color.new(liqEQLColor, 75))

if showLIQ and array.size(liqHighLevels) > 0
    for i = 0 to array.size(liqHighLevels) - 1
        if not array.get(liqHighSwept, i)
            lvl = array.get(liqHighLevels, i)
            if high > lvl and close < lvl
                lastEQHSweepBar := bar_index
                array.set(liqHighSwept, i, true)
                sweepEQH := true
                if liqSweptHide
                    line.delete(array.get(liqHighLines, i))
                else
                    line.set_color(array.get(liqHighLines, i), color.new(liqEQHColor, 75))

plotshape(showSweepLbl and sweepEQL, title="EQL sweep", location=location.belowbar, style=shape.triangleup,   color=liqEQLColor, size=size.tiny, text="x")
plotshape(showSweepLbl and sweepEQH, title="EQH sweep", location=location.abovebar, style=shape.triangledown, color=liqEQHColor, size=size.tiny, text="x")

// ══════════════════════════════════════════════════════════════════════════════
//  PREMIUM / DISCOUNT / OTE  (lines, not fills — much lighter on the eye)
// ══════════════════════════════════════════════════════════════════════════════

grpPD = "Premium / Discount / OTE"
showPD       = input.bool(true,  "Show PD lines",      group=grpPD)
showOTE      = input.bool(true,  "Show OTE 62/79 lines", group=grpPD)
pdPremColor  = input.color(color.new(#F23645, 0),  "Premium edge", group=grpPD)
pdDiscColor  = input.color(color.new(#26A69A, 0),  "Discount edge", group=grpPD)
pdEqColor    = input.color(color.new(color.gray, 30), "Equilibrium", group=grpPD)
pdOTEColor   = input.color(color.new(#FFD600, 0),  "OTE", group=grpPD)
pdLineWidth  = input.int(2, "PD line width", group=grpPD, minval=1, maxval=4)

hasSwingPair = not na(lastExtPH_val) and not na(lastExtPL_val)
swingHi = hasSwingPair ? math.max(lastExtPH_val, lastExtPL_val) : ta.highest(high, 50)
swingLo = hasSwingPair ? math.min(lastExtPH_val, lastExtPL_val) : ta.lowest(low, 50)
swingMid = math.avg(swingHi, swingLo)
swingBars = hasSwingPair ? math.max(1, bar_index - math.min(nz(extLastPHBar, bar_index), nz(extLastPLBar, bar_index))) : 50

var line pdLineHi  = na
var line pdLineLo  = na
var line pdLineMid = na
var line oteLine62 = na
var line oteLine79 = na
var label pdLblPrem = na
var label pdLblDisc = na
var label pdLblEq   = na
var label oteLbl    = na

if showPD and barstate.islast
    if not na(pdLineHi)
        line.delete(pdLineHi)
    if not na(pdLineLo)
        line.delete(pdLineLo)
    if not na(pdLineMid)
        line.delete(pdLineMid)
    if not na(pdLblPrem)
        label.delete(pdLblPrem)
    if not na(pdLblDisc)
        label.delete(pdLblDisc)
    if not na(pdLblEq)
        label.delete(pdLblEq)

    leftBar = bar_index - swingBars
    pdLineHi  := line.new(leftBar, swingHi, bar_index, swingHi, color=pdPremColor, style=line.style_solid, width=pdLineWidth, extend=extend.right)
    pdLineLo  := line.new(leftBar, swingLo, bar_index, swingLo, color=pdDiscColor, style=line.style_solid, width=pdLineWidth, extend=extend.right)
    pdLineMid := line.new(leftBar, swingMid, bar_index, swingMid, color=pdEqColor, style=line.style_dashed, width=1, extend=extend.right)
    if lblAllowHTF
        // Slot 2 (PD/OTE)
        pdLblPrem := label.new(labelX(2), swingHi,  "PREM", style=label.style_label_left, color=color.new(pdPremColor, 60), textcolor=color.white, size=size.tiny)
        pdLblDisc := label.new(labelX(2), swingLo,  "DISC", style=label.style_label_left, color=color.new(pdDiscColor, 60), textcolor=color.white, size=size.tiny)
        pdLblEq   := label.new(labelX(2), swingMid, "EQ",   style=label.style_label_left, color=color.new(color.gray, 60),  textcolor=color.white, size=size.tiny)

var float oteHi = na
var float oteLo = na

oteHi := na
oteLo := na
if showPD and showOTE
    leg = swingHi - swingLo
    if extTrend == 1 and not na(extLastPL)
        oteHi := swingHi - leg * 0.62
        oteLo := swingHi - leg * 0.79
    else if extTrend == -1 and not na(extLastPH)
        oteLo := swingLo + leg * 0.62
        oteHi := swingLo + leg * 0.79

if showPD and showOTE and barstate.islast
    if not na(oteLine62)
        line.delete(oteLine62)
        oteLine62 := na
    if not na(oteLine79)
        line.delete(oteLine79)
        oteLine79 := na
    if not na(oteLbl)
        label.delete(oteLbl)
    if not na(oteHi) and not na(oteLo)
        leftBar2 = bar_index - swingBars
        oteLine62 := line.new(leftBar2, oteHi, bar_index, oteHi, color=pdOTEColor, style=line.style_dashed, width=1, extend=extend.right)
        oteLine79 := line.new(leftBar2, oteLo, bar_index, oteLo, color=pdOTEColor, style=line.style_dashed, width=1, extend=extend.right)
        if lblAllowHTF
            oteLbl := label.new(labelX(2), math.avg(oteHi, oteLo), "OTE", style=label.style_label_left, color=color.new(pdOTEColor, 30), textcolor=color.black, size=size.tiny)

isInOTE = not na(oteHi) and not na(oteLo) and close <= oteHi and close >= oteLo


// (Sessions / Killzones are now defined once near the top of the script.)

// ══════════════════════════════════════════════════════════════════════════════
//  ASIAN RANGE  (LIVE — updates every bar during session)
// ══════════════════════════════════════════════════════════════════════════════

grpAR = "Asian Range"
showAR     = input.bool(true,  "Show Asian Range",     group=grpAR)
arShowBox  = input.bool(false, "Draw filled box (else lines only)", group=grpAR, tooltip="Lines-only mode is much lighter on the chart.")
arColor    = input.color(color.new(#FFA726, 90), "Asian Range fill", group=grpAR)
arLineCol  = input.color(color.new(#FFA726, 30), "Asian Range edges", group=grpAR)

var float arHi = na
var float arLo = na
var int   arStart = na
var box   arBox  = na
var line  arHiLn = na
var line  arLoLn = na
var label arHiLbl = na
var label arLoLbl = na

newAsia = inAsia and not inAsia[1]

if showAR and newAsia
    arHi := high
    arLo := low
    arStart := bar_index
    if not na(arBox)
        box.delete(arBox)
    if not na(arHiLn)
        line.delete(arHiLn)
    if not na(arLoLn)
        line.delete(arLoLn)
    if not na(arHiLbl)
        label.delete(arHiLbl)
    if not na(arLoLbl)
        label.delete(arLoLbl)
if showAR and inAsia
    if na(arHi)
        arHi := high
        arLo := low
        arStart := bar_index
    arHi := math.max(arHi, high)
    arLo := math.min(arLo, low)

// LIVE redraw — every bar after Asia is initialized.  Box / lines extend
// to the right edge so they keep growing as price moves outside the session.
if showAR and not na(arHi) and not na(arStart)
    if not na(arBox)
        box.delete(arBox)
    if not na(arHiLn)
        line.delete(arHiLn)
    if not na(arLoLn)
        line.delete(arLoLn)
    if arShowBox
        arBox := box.new(arStart, arHi, bar_index, arLo, bgcolor=arColor, border_color=arLineCol, extend=extend.right)
    arHiLn := line.new(arStart, arHi, bar_index, arHi, color=arLineCol, style=line.style_solid, width=1, extend=extend.right)
    arLoLn := line.new(arStart, arLo, bar_index, arLo, color=arLineCol, style=line.style_solid, width=1, extend=extend.right)

if showAR and not na(arHi) and barstate.islast and lblAllowLevels
    if not na(arHiLbl)
        label.delete(arHiLbl)
    if not na(arLoLbl)
        label.delete(arLoLbl)
    // Slot 1 (AR labels)
    arHiLbl := label.new(labelX(1), arHi, "AR-H", style=label.style_label_left, color=color.new(arLineCol, 30), textcolor=color.white, size=size.tiny)
    arLoLbl := label.new(labelX(1), arLo, "AR-L", style=label.style_label_left, color=color.new(arLineCol, 30), textcolor=color.white, size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
//  ICT MACRO TIME WINDOWS  (vertical-line markers + optional bg)
// ══════════════════════════════════════════════════════════════════════════════

grpMACRO = "ICT Macros"
showMacro   = input.bool(true, "Show macro time windows", group=grpMACRO)
macroBgOn   = input.bool(false, "Background highlight (heavy)", group=grpMACRO)
macroLinesOn= input.bool(true,  "Vertical line at macro start", group=grpMACRO, tooltip="Recommended on 15m — bgcolor only covers 1–2 bars.")
macroCol    = input.color(color.new(#FFEB3B, 95), "Macro bg",         group=grpMACRO)
macroLineCol= input.color(color.new(#FFEB3B, 30), "Macro line color", group=grpMACRO)
macro1 = input.session("0950-1010", "Macro 1 (NY AM)",   group=grpMACRO)
macro2 = input.session("1050-1110", "Macro 2 (NY mid)",  group=grpMACRO)
macro3 = input.session("1450-1510", "Macro 3 (NY PM)",   group=grpMACRO)

inMacro1 = not na(time(timeframe.period, macro1, tz))
inMacro2 = not na(time(timeframe.period, macro2, tz))
inMacro3 = not na(time(timeframe.period, macro3, tz))
inMacro = showMacro and (inMacro1 or inMacro2 or inMacro3)

newMacro1 = inMacro1 and not inMacro1[1]
newMacro2 = inMacro2 and not inMacro2[1]
newMacro3 = inMacro3 and not inMacro3[1]

bgcolor(showMacro and macroBgOn and inMacro ? macroCol : na, title="ICT Macro bg")

if showMacro and macroLinesOn
    if newMacro1
        line.new(bar_index, low - 5 * syminfo.mintick, bar_index, high + 5 * syminfo.mintick, color=macroLineCol, style=line.style_dotted, width=1, extend=extend.both)
    if newMacro2
        line.new(bar_index, low - 5 * syminfo.mintick, bar_index, high + 5 * syminfo.mintick, color=macroLineCol, style=line.style_dotted, width=1, extend=extend.both)
    if newMacro3
        line.new(bar_index, low - 5 * syminfo.mintick, bar_index, high + 5 * syminfo.mintick, color=macroLineCol, style=line.style_dotted, width=1, extend=extend.both)


// ══════════════════════════════════════════════════════════════════════════════
//  PERIODIC LEVELS
// ══════════════════════════════════════════════════════════════════════════════

grpLVL = "Periodic Levels"
showOpens   = input.bool(true,  "Show D / W / M opens",       group=grpLVL)
showPrevHL  = input.bool(true,  "Show previous D / W / M H&L", group=grpLVL)
dOpenColor  = input.color(color.new(#FFEE58, 20), "Daily open",   group=grpLVL)
wOpenColor  = input.color(color.new(#FFA726, 20), "Weekly open",  group=grpLVL)
mOpenColor  = input.color(color.new(#EF5350, 20), "Monthly open", group=grpLVL)
prevDColor  = input.color(color.new(#90CAF9, 30), "Previous D H/L", group=grpLVL)
prevWColor  = input.color(color.new(#CE93D8, 30), "Previous W H/L", group=grpLVL)
prevMColor  = input.color(color.new(#FFAB91, 30), "Previous M H/L", group=grpLVL)

// Batched into one request.security per resolution (was 9 calls, now 3).
[dOpen, prevDH, prevDL] = request.security(syminfo.tickerid, "D", [open, high[1], low[1]], lookahead=barmerge.lookahead_off)
[wOpen, prevWH, prevWL] = request.security(syminfo.tickerid, "W", [open, high[1], low[1]], lookahead=barmerge.lookahead_off)
[mOpen, prevMH, prevML] = request.security(syminfo.tickerid, "M", [open, high[1], low[1]], lookahead=barmerge.lookahead_off)

plot(showOpens  ? dOpen  : na, "Daily open",   color=dOpenColor, style=plot.style_linebr, linewidth=1)
plot(showOpens  ? wOpen  : na, "Weekly open",  color=wOpenColor, style=plot.style_linebr, linewidth=1)
plot(showOpens  ? mOpen  : na, "Monthly open", color=mOpenColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevDH : na, "PDH", color=prevDColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevDL : na, "PDL", color=prevDColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevWH : na, "PWH", color=prevWColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevWL : na, "PWL", color=prevWColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevMH : na, "PMH", color=prevMColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevML : na, "PML", color=prevMColor, style=plot.style_linebr, linewidth=1)

// Level labels — var handles + delete-before-redraw so realtime ticks on the
// last bar don't churn label.new() (which evicts other labels via the 500 cap).
var label lvlDO  = na
var label lvlWO  = na
var label lvlMO  = na
var label lvlPDH = na
var label lvlPDL = na
var label lvlPWH = na
var label lvlPWL = na
var label lvlPMH = na
var label lvlPML = na

if barstate.islast and lblAllowLevels
    label.delete(lvlDO)
    label.delete(lvlWO)
    label.delete(lvlMO)
    label.delete(lvlPDH)
    label.delete(lvlPDL)
    label.delete(lvlPWH)
    label.delete(lvlPWL)
    label.delete(lvlPMH)
    label.delete(lvlPML)
    if showOpens
        // Slot 3
        lvlDO := label.new(labelX(3), dOpen, "dO", style=label.style_label_left, color=color.new(dOpenColor, 30), textcolor=color.black, size=size.tiny)
        lvlWO := label.new(labelX(3), wOpen, "wO", style=label.style_label_left, color=color.new(wOpenColor, 30), textcolor=color.black, size=size.tiny)
        lvlMO := label.new(labelX(3), mOpen, "mO", style=label.style_label_left, color=color.new(mOpenColor, 30), textcolor=color.white, size=size.tiny)
    if showPrevHL
        lvlPDH := label.new(labelX(3), prevDH, "PDH", style=label.style_label_left, color=color.new(prevDColor, 30), textcolor=color.black, size=size.tiny)
        lvlPDL := label.new(labelX(3), prevDL, "PDL", style=label.style_label_left, color=color.new(prevDColor, 30), textcolor=color.black, size=size.tiny)
        lvlPWH := label.new(labelX(3), prevWH, "PWH", style=label.style_label_left, color=color.new(prevWColor, 30), textcolor=color.white, size=size.tiny)
        lvlPWL := label.new(labelX(3), prevWL, "PWL", style=label.style_label_left, color=color.new(prevWColor, 30), textcolor=color.white, size=size.tiny)
        lvlPMH := label.new(labelX(3), prevMH, "PMH", style=label.style_label_left, color=color.new(prevMColor, 30), textcolor=color.white, size=size.tiny)
        lvlPML := label.new(labelX(3), prevML, "PML", style=label.style_label_left, color=color.new(prevMColor, 30), textcolor=color.white, size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
//  LIQUIDITY LEVELS  (1D / 7D / 30D rolling H/L) — redraw only on value change
// ══════════════════════════════════════════════════════════════════════════════

grpLIQL = "Liquidity Levels"
showDayLiq   = input.bool(true,  "Show 1-day liquidity (H+L)",  group=grpLIQL)
showWeekLiq  = input.bool(true,  "Show 7-day liquidity (H+L)",  group=grpLIQL)
showMonthLiq = input.bool(true,  "Show 30-day liquidity (H+L)", group=grpLIQL)
liqStyleIn   = input.string("Solid", "Line style", group=grpLIQL, options=["Solid","Dashed","Dotted"])
liqWidth     = input.int(2,      "Line width",  group=grpLIQL, minval=1, maxval=4)
liqExtend    = input.bool(true,  "Extend to right", group=grpLIQL)
liqLabels    = input.bool(true,  "Show price labels", group=grpLIQL, tooltip="ON by default — staggered to the right so they don't stack.")
liqShowMid   = input.bool(false, "Show midline of each range", group=grpLIQL)
dayHiCol     = input.color(color.new(#FFB300, 0), "1D High",  group=grpLIQL)
dayLoCol     = input.color(color.new(#FFB300, 0), "1D Low",   group=grpLIQL)
weekHiCol    = input.color(color.new(#1E88E5, 0), "7D High",  group=grpLIQL)
weekLoCol    = input.color(color.new(#1E88E5, 0), "7D Low",   group=grpLIQL)
monHiCol     = input.color(color.new(#8E24AA, 0), "30D High", group=grpLIQL)
monLoCol     = input.color(color.new(#8E24AA, 0), "30D Low",  group=grpLIQL)
liqMidCol    = input.color(color.new(color.gray, 50), "Midlines", group=grpLIQL)

liqStyle = liqStyleIn == "Dashed" ? line.style_dashed : liqStyleIn == "Dotted" ? line.style_dotted : line.style_solid
liqExt   = liqExtend ? extend.right : extend.none

// Batched into a single request.security on "D" (was 6 calls, now 1).
[liq1Hi, liq1Lo, liq7Hi, liq7Lo, liq30Hi, liq30Lo] = request.security(syminfo.tickerid, "D", [high[1], low[1], ta.highest(high[1], 7), ta.lowest(low[1], 7), ta.highest(high[1], 30), ta.lowest(low[1], 30)], lookahead=barmerge.lookahead_off)

var line ln1Hi  = na
var line ln1Lo  = na
var line ln1Mid = na
var line ln7Hi  = na
var line ln7Lo  = na
var line ln7Mid = na
var line ln30Hi = na
var line ln30Lo = na
var line ln30Mid= na
var label lb1Hi  = na
var label lb1Lo  = na
var label lb7Hi  = na
var label lb7Lo  = na
var label lb30Hi = na
var label lb30Lo = na

var float prv1Hi = na
var float prv1Lo = na
var float prv7Hi = na
var float prv7Lo = na
var float prv30Hi = na
var float prv30Lo = na

liq1Changed  = liq1Hi  != prv1Hi  or liq1Lo  != prv1Lo
liq7Changed  = liq7Hi  != prv7Hi  or liq7Lo  != prv7Lo
liq30Changed = liq30Hi != prv30Hi or liq30Lo != prv30Lo

var bool liqFirstDraw = true

if barstate.islast and (liqFirstDraw or liq1Changed or liq7Changed or liq30Changed)
    leftBar = math.max(0, bar_index - 500)

    if liqFirstDraw or liq1Changed
        if not na(ln1Hi)
            line.delete(ln1Hi)
        if not na(ln1Lo)
            line.delete(ln1Lo)
        if not na(ln1Mid)
            line.delete(ln1Mid)
        if not na(lb1Hi)
            label.delete(lb1Hi)
        if not na(lb1Lo)
            label.delete(lb1Lo)
        if showDayLiq and not na(liq1Hi) and not na(liq1Lo)
            ln1Hi := line.new(leftBar, liq1Hi, bar_index, liq1Hi, color=dayHiCol, style=liqStyle, width=liqWidth, extend=liqExt)
            ln1Lo := line.new(leftBar, liq1Lo, bar_index, liq1Lo, color=dayLoCol, style=liqStyle, width=liqWidth, extend=liqExt)
            if liqShowMid
                mid = math.avg(liq1Hi, liq1Lo)
                ln1Mid := line.new(leftBar, mid, bar_index, mid, color=liqMidCol, style=line.style_dotted, width=1, extend=liqExt)
            if liqLabels
                // Slot 0
                lb1Hi := label.new(labelX(0), liq1Hi, "1D-H " + str.tostring(liq1Hi, format.mintick), style=label.style_label_left, color=color.new(dayHiCol, 20), textcolor=color.white, size=size.small)
                lb1Lo := label.new(labelX(0), liq1Lo, "1D-L " + str.tostring(liq1Lo, format.mintick), style=label.style_label_left, color=color.new(dayLoCol, 20), textcolor=color.white, size=size.small)
        prv1Hi := liq1Hi
        prv1Lo := liq1Lo

    if liqFirstDraw or liq7Changed
        if not na(ln7Hi)
            line.delete(ln7Hi)
        if not na(ln7Lo)
            line.delete(ln7Lo)
        if not na(ln7Mid)
            line.delete(ln7Mid)
        if not na(lb7Hi)
            label.delete(lb7Hi)
        if not na(lb7Lo)
            label.delete(lb7Lo)
        if showWeekLiq and not na(liq7Hi) and not na(liq7Lo)
            ln7Hi := line.new(leftBar, liq7Hi, bar_index, liq7Hi, color=weekHiCol, style=liqStyle, width=liqWidth, extend=liqExt)
            ln7Lo := line.new(leftBar, liq7Lo, bar_index, liq7Lo, color=weekLoCol, style=liqStyle, width=liqWidth, extend=liqExt)
            if liqShowMid
                mid = math.avg(liq7Hi, liq7Lo)
                ln7Mid := line.new(leftBar, mid, bar_index, mid, color=liqMidCol, style=line.style_dotted, width=1, extend=liqExt)
            if liqLabels
                lb7Hi := label.new(labelX(0), liq7Hi, "7D-H " + str.tostring(liq7Hi, format.mintick), style=label.style_label_left, color=color.new(weekHiCol, 20), textcolor=color.white, size=size.small)
                lb7Lo := label.new(labelX(0), liq7Lo, "7D-L " + str.tostring(liq7Lo, format.mintick), style=label.style_label_left, color=color.new(weekLoCol, 20), textcolor=color.white, size=size.small)
        prv7Hi := liq7Hi
        prv7Lo := liq7Lo

    if liqFirstDraw or liq30Changed
        if not na(ln30Hi)
            line.delete(ln30Hi)
        if not na(ln30Lo)
            line.delete(ln30Lo)
        if not na(ln30Mid)
            line.delete(ln30Mid)
        if not na(lb30Hi)
            label.delete(lb30Hi)
        if not na(lb30Lo)
            label.delete(lb30Lo)
        if showMonthLiq and not na(liq30Hi) and not na(liq30Lo)
            ln30Hi := line.new(leftBar, liq30Hi, bar_index, liq30Hi, color=monHiCol, style=liqStyle, width=liqWidth, extend=liqExt)
            ln30Lo := line.new(leftBar, liq30Lo, bar_index, liq30Lo, color=monLoCol, style=liqStyle, width=liqWidth, extend=liqExt)
            if liqShowMid
                mid = math.avg(liq30Hi, liq30Lo)
                ln30Mid := line.new(leftBar, mid, bar_index, mid, color=liqMidCol, style=line.style_dotted, width=1, extend=liqExt)
            if liqLabels
                lb30Hi := label.new(labelX(0), liq30Hi, "30D-H " + str.tostring(liq30Hi, format.mintick), style=label.style_label_left, color=color.new(monHiCol, 20), textcolor=color.white, size=size.small)
                lb30Lo := label.new(labelX(0), liq30Lo, "30D-L " + str.tostring(liq30Lo, format.mintick), style=label.style_label_left, color=color.new(monLoCol, 20), textcolor=color.white, size=size.small)
        prv30Hi := liq30Hi
        prv30Lo := liq30Lo

    liqFirstDraw := false

// Liquidity sweep alerts
liqSweep1H  = showDayLiq   and not na(liq1Hi)  and high > liq1Hi  and close < liq1Hi
liqSweep1L  = showDayLiq   and not na(liq1Lo)  and low  < liq1Lo  and close > liq1Lo
liqSweep7H  = showWeekLiq  and not na(liq7Hi)  and high > liq7Hi  and close < liq7Hi
liqSweep7L  = showWeekLiq  and not na(liq7Lo)  and low  < liq7Lo  and close > liq7Lo
liqSweep30H = showMonthLiq and not na(liq30Hi) and high > liq30Hi and close < liq30Hi
liqSweep30L = showMonthLiq and not na(liq30Lo) and low  < liq30Lo and close > liq30Lo

if (liqSweep1H or liqSweep1L or liqSweep7H or liqSweep7L or liqSweep30H or liqSweep30L)
    sLbl = liqSweep1H ? "1D high" : liqSweep1L ? "1D low" : liqSweep7H ? "7D high" : liqSweep7L ? "7D low" : liqSweep30H ? "30D high" : "30D low"
    alert("Liquidity swept: " + sLbl + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)


// ══════════════════════════════════════════════════════════════════════════════
//  HTF ORDER BLOCKS  (with confluence scoring)
// ══════════════════════════════════════════════════════════════════════════════

grpHTFOB = "HTF Order Blocks"
showHTFOB    = input.bool(true,  "Show HTF OBs",        group=grpHTFOB)
htfOBTF      = input.timeframe("240", "HTF timeframe",  group=grpHTFOB)
htfOBLen     = input.int(5,      "HTF swing lookback",  group=grpHTFOB, minval=2, maxval=20)
htfOBMax     = input.int(2,      "Max HTF OBs / side",  group=grpHTFOB, minval=1, maxval=5)
htfOBBullCol = input.color(color.new(#1565C0, 60), "HTF Bull OB", group=grpHTFOB)
htfOBBearCol = input.color(color.new(#B71C1C, 60), "HTF Bear OB", group=grpHTFOB)
htfConfirm   = input.bool(true,  "Wait for bar close (reduce repaint)", group=grpHTFOB, tooltip="ON: HTF order-block boxes and HTF-FVG highlights are only committed when the current chart bar closes, removing intrabar flicker.\nNote: HTF data can still settle when the higher-timeframe candle itself closes — this removes chart-bar flicker, not 100% of MTF repaint.")

detectHTFOB(int len) =>
    pivH = ta.pivothigh(high, len, len)
    pivL = ta.pivotlow(low,   len, len)

    var float lastPHv = na
    var float lastPLv = na
    if not na(pivH)
        lastPHv := pivH
    if not na(pivL)
        lastPLv := pivL

    bullBOSf = not na(lastPHv) and close > lastPHv and close[1] <= lastPHv
    bearBOSf = not na(lastPLv) and close < lastPLv and close[1] >= lastPLv

    bullOBHi = float(na)
    bullOBLo = float(na)
    bullOBT  = int(na)
    bearOBHi = float(na)
    bearOBLo = float(na)
    bearOBT  = int(na)

    if bullBOSf
        for k = 1 to math.min(len * 2, 50)
            if close[k] < open[k]
                bullOBHi := high[k]
                bullOBLo := low[k]
                bullOBT  := time[k]
                break
        lastPHv := na
    if bearBOSf
        for k = 1 to math.min(len * 2, 50)
            if close[k] > open[k]
                bearOBHi := high[k]
                bearOBLo := low[k]
                bearOBT  := time[k]
                break
        lastPLv := na

    [bullBOSf, bullOBHi, bullOBLo, bullOBT, bearBOSf, bearOBHi, bearOBLo, bearOBT]

[htfBullBOS, htfBOBHi, htfBOBLo, htfBOBT, htfBearBOS, htfBeOBHi, htfBeOBLo, htfBeOBT] = request.security(syminfo.tickerid, htfOBTF, detectHTFOB(htfOBLen), lookahead=barmerge.lookahead_off)

var htfOBBullBoxes = array.new_box()
var htfOBBullHi    = array.new_float()
var htfOBBullLo    = array.new_float()
var htfOBBullMitig = array.new_bool()
var htfOBBullScore = array.new_int()
var htfOBBearBoxes = array.new_box()
var htfOBBearHi    = array.new_float()
var htfOBBearLo    = array.new_float()
var htfOBBearMitig = array.new_bool()
var htfOBBearScore = array.new_int()

chartBelowHTF = timeframe.in_seconds() < timeframe.in_seconds(htfOBTF)

// Commit gate: when htfConfirm is on, only draw/commit HTF zones on a closed
// chart bar (kills intrabar flicker). On history every bar is confirmed.
htfCommitOK = not htfConfirm or barstate.isconfirmed

newHTFBullBOS = htfBullBOS and not nz(htfBullBOS[1], false) and not na(htfBOBT)
newHTFBearBOS = htfBearBOS and not nz(htfBearBOS[1], false) and not na(htfBeOBT)

// Helper — count an OB's confluence score
//   +1 in OTE, +1 in current killzone, +1 near (≤0.25%) any EQH/EQL
htfOBNearLiquidity(price) =>
    found = false
    threshold = price * 0.0025
    if array.size(liqHighLevels) > 0
        for i = 0 to array.size(liqHighLevels) - 1
            if math.abs(array.get(liqHighLevels, i) - price) <= threshold
                found := true
                break
    if not found and array.size(liqLowLevels) > 0
        for i = 0 to array.size(liqLowLevels) - 1
            if math.abs(array.get(liqLowLevels, i) - price) <= threshold
                found := true
                break
    found

if showHTFOB and chartBelowHTF and newHTFBullBOS and htfCommitOK
    while array.size(htfOBBullBoxes) >= htfOBMax
        box.delete(array.shift(htfOBBullBoxes))
        array.shift(htfOBBullHi)
        array.shift(htfOBBullLo)
        array.shift(htfOBBullMitig)
        array.shift(htfOBBullScore)
    score = 0
    if isInOTE
        score += 1
    if inAnyKZ_p2
        score += 1
    if htfOBNearLiquidity(math.avg(htfBOBHi, htfBOBLo))
        score += 1
    b = box.new(htfBOBT, htfBOBHi, time, htfBOBLo, xloc=xloc.bar_time, bgcolor=htfOBBullCol, border_color=color.new(htfOBBullCol, 20), border_width=2, extend=extend.right)
    array.push(htfOBBullBoxes, b)
    array.push(htfOBBullHi, htfBOBHi)
    array.push(htfOBBullLo, htfBOBLo)
    array.push(htfOBBullMitig, false)
    array.push(htfOBBullScore, score)
    if lblAllowHTF
        scoreTxt = score > 0 ? " ★" + str.tostring(score) : ""
        label.new(time, htfBOBHi, htfOBTF + "OB" + scoreTxt, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(htfOBBullCol, 20), textcolor=color.white, size=size.tiny)

if showHTFOB and chartBelowHTF and newHTFBearBOS and htfCommitOK
    while array.size(htfOBBearBoxes) >= htfOBMax
        box.delete(array.shift(htfOBBearBoxes))
        array.shift(htfOBBearHi)
        array.shift(htfOBBearLo)
        array.shift(htfOBBearMitig)
        array.shift(htfOBBearScore)
    score = 0
    if isInOTE
        score += 1
    if inAnyKZ_p2
        score += 1
    if htfOBNearLiquidity(math.avg(htfBeOBHi, htfBeOBLo))
        score += 1
    b = box.new(htfBeOBT, htfBeOBHi, time, htfBeOBLo, xloc=xloc.bar_time, bgcolor=htfOBBearCol, border_color=color.new(htfOBBearCol, 20), border_width=2, extend=extend.right)
    array.push(htfOBBearBoxes, b)
    array.push(htfOBBearHi, htfBeOBHi)
    array.push(htfOBBearLo, htfBeOBLo)
    array.push(htfOBBearMitig, false)
    array.push(htfOBBearScore, score)
    if lblAllowHTF
        scoreTxt = score > 0 ? " ★" + str.tostring(score) : ""
        label.new(time, htfBeOBHi, htfOBTF + "OB" + scoreTxt, xloc=xloc.bar_time, style=label.style_label_down, color=color.new(htfOBBearCol, 20), textcolor=color.white, size=size.tiny)

if showHTFOB and chartBelowHTF
    if array.size(htfOBBullBoxes) > 0
        for i = 0 to array.size(htfOBBullBoxes) - 1
            if not array.get(htfOBBullMitig, i)
                if close < array.get(htfOBBullLo, i)
                    box.delete(array.get(htfOBBullBoxes, i))
                    array.set(htfOBBullMitig, i, true)
    if array.size(htfOBBearBoxes) > 0
        for i = 0 to array.size(htfOBBearBoxes) - 1
            if not array.get(htfOBBearMitig, i)
                if close > array.get(htfOBBearHi, i)
                    box.delete(array.get(htfOBBearBoxes, i))
                    array.set(htfOBBearMitig, i, true)

inHTFBullOB = false
inHTFBearOB = false
maxHTFBullScore = 0
maxHTFBearScore = 0
if showHTFOB and array.size(htfOBBullBoxes) > 0
    for i = 0 to array.size(htfOBBullBoxes) - 1
        if not array.get(htfOBBullMitig, i)
            if close >= array.get(htfOBBullLo, i) and close <= array.get(htfOBBullHi, i)
                inHTFBullOB := true
                s = array.get(htfOBBullScore, i)
                if s > maxHTFBullScore
                    maxHTFBullScore := s
if showHTFOB and array.size(htfOBBearBoxes) > 0
    for i = 0 to array.size(htfOBBearBoxes) - 1
        if not array.get(htfOBBearMitig, i)
            if close >= array.get(htfOBBearLo, i) and close <= array.get(htfOBBearHi, i)
                inHTFBearOB := true
                s = array.get(htfOBBearScore, i)
                if s > maxHTFBearScore
                    maxHTFBearScore := s

// ══════════════════════════════════════════════════════════════════════════════
//  HTF FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════════════════════

grpHTFFVG = "HTF FVG"
showHTFFVG = input.bool(true,  "Show HTF FVGs", group=grpHTFFVG)
htfFVGTF   = input.timeframe("240", "HTF FVG timeframe", group=grpHTFFVG)
htfFVGBull = input.color(color.new(#00C853, 75), "HTF Bull FVG", group=grpHTFFVG)
htfFVGBear = input.color(color.new(#FF1744, 75), "HTF Bear FVG", group=grpHTFFVG)

[htfH2, htfL2, htfH0, htfL0] = request.security(syminfo.tickerid, htfFVGTF, [high[2], low[2], high, low], lookahead=barmerge.lookahead_off)
htfBullFVG = not na(htfH2) and not na(htfL0) and (htfL0 - htfH2) > 0
htfBearFVG = not na(htfL2) and not na(htfH0) and (htfL2 - htfH0) > 0
inHTFBullFVG = showHTFFVG and htfBullFVG and close >= htfH2 and close <= htfL0
inHTFBearFVG = showHTFFVG and htfBearFVG and close >= htfH0 and close <= htfL2

bgcolor(showHTFFVG and inHTFBullFVG and htfCommitOK ? color.new(htfFVGBull, 92) : na, title="HTF Bull FVG bg")
bgcolor(showHTFFVG and inHTFBearFVG and htfCommitOK ? color.new(htfFVGBear, 92) : na, title="HTF Bear FVG bg")

// ══════════════════════════════════════════════════════════════════════════════
//  HTF PREMIUM / DISCOUNT  (proper HTF range, not LTF mid)
// ══════════════════════════════════════════════════════════════════════════════

// Batched into a single request.security (was 2 calls, now 1).
[htfRangeHi, htfRangeLo] = request.security(syminfo.tickerid, htfOBTF, [ta.highest(high[1], 20), ta.lowest(low[1], 20)], lookahead=barmerge.lookahead_off)
htfMid     = math.avg(htfRangeHi, htfRangeLo)
inHTFDiscount = not na(htfMid) and close < htfMid
inHTFPremium  = not na(htfMid) and close > htfMid

// ══════════════════════════════════════════════════════════════════════════════
//  EMAs
// ══════════════════════════════════════════════════════════════════════════════

grpEMA = "EMAs"
showEma1   = input.bool(true,  "Show EMA 1",      group=grpEMA)
ema1Len    = input.int(50,     "EMA 1 length",    group=grpEMA, minval=2, maxval=400)
ema1Col    = input.color(color.new(#42A5F5, 0), "EMA 1 color", group=grpEMA)
showEma2   = input.bool(true,  "Show EMA 2",      group=grpEMA)
ema2Len    = input.int(200,    "EMA 2 length",    group=grpEMA, minval=2, maxval=400)
ema2Col    = input.color(color.new(#FFB300, 0), "EMA 2 color", group=grpEMA)
showEma3   = input.bool(true,  "Show EMA 3",      group=grpEMA)
ema3Len    = input.int(21,     "EMA 3 length",    group=grpEMA, minval=2, maxval=400)
ema3Col    = input.color(color.new(#E040FB, 0), "EMA 3 color", group=grpEMA)
ema3Src    = input.source(close, "EMA 3 source",  group=grpEMA)
emaWidth   = input.int(2,      "Line width",      group=grpEMA, minval=1, maxval=4)
emaCrossLbl= input.bool(true,  "Mark EMA1/EMA2 crosses", group=grpEMA)

ema1Val = ta.ema(close, ema1Len)
ema2Val = ta.ema(close, ema2Len)
ema3Val = ta.ema(ema3Src, ema3Len)

plot(showEma1 ? ema1Val : na, "EMA 1", color=ema1Col, linewidth=emaWidth)
plot(showEma2 ? ema2Val : na, "EMA 2", color=ema2Col, linewidth=emaWidth)
plot(showEma3 ? ema3Val : na, "EMA 3", color=ema3Col, linewidth=emaWidth)

emaBullCross = showEma1 and showEma2 and ta.crossover(ema1Val, ema2Val)
emaBearCross = showEma1 and showEma2 and ta.crossunder(ema1Val, ema2Val)

plotshape(emaCrossLbl and emaBullCross, title="EMA bull cross", location=location.belowbar, style=shape.circle, color=color.new(#00C853, 0), size=size.tiny, text="X")
plotshape(emaCrossLbl and emaBearCross, title="EMA bear cross", location=location.abovebar, style=shape.circle, color=color.new(#F23645, 0), size=size.tiny, text="X")

if emaBullCross or emaBearCross
    alert("EMA cross (" + (emaBullCross ? "bull" : "bear") + ") @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)


// ══════════════════════════════════════════════════════════════════════════════
//  COMPOSITE SIGNALS
// ══════════════════════════════════════════════════════════════════════════════

grpSIG = "Composite Signals"
sigLookback = input.int(10, "Sweep -> CHoCH lookback (bars)", group=grpSIG, minval=2, maxval=50)
showRevMark = input.bool(true, "Show reversal markers", group=grpSIG)
useHTFForSetup = input.bool(true, "Use HTF discount/premium for A+ setup (recommended)", group=grpSIG)

recentEQLSweep = (bar_index - lastEQLSweepBar) <= sigLookback
recentEQHSweep = (bar_index - lastEQHSweepBar) <= sigLookback

bullReversal = recentEQLSweep and intBullCHoCH
bearReversal = recentEQHSweep and intBearCHoCH

plotshape(showRevMark and bullReversal, title="Bull reversal (sweep+CHoCH)", location=location.belowbar, style=shape.diamond, color=color.new(#00E676, 0), size=size.small, text="REV")
plotshape(showRevMark and bearReversal, title="Bear reversal (sweep+CHoCH)", location=location.abovebar, style=shape.diamond, color=color.new(#FF5252, 0), size=size.small, text="REV")

inLTFDiscount = close < swingMid
inLTFPremium  = close > swingMid

discountForSetup = useHTFForSetup ? inHTFDiscount : inLTFDiscount
premiumForSetup  = useHTFForSetup ? inHTFPremium  : inLTFPremium

bullSetupReady = bullReversal and discountForSetup and (inHTFBullOB or inHTFBullFVG or isInOTE)
bearSetupReady = bearReversal and premiumForSetup  and (inHTFBearOB or inHTFBearFVG or isInOTE)

plotshape(bullSetupReady, title="Bull setup ready", location=location.belowbar, style=shape.flag, color=color.new(#00C853, 0), size=size.normal, text="A+")
plotshape(bearSetupReady, title="Bear setup ready", location=location.abovebar, style=shape.flag, color=color.new(#F23645, 0), size=size.normal, text="A+")

// ══════════════════════════════════════════════════════════════════════════════
//  COMPOSITE STRUCTURED ALERT
//  One subscription, every event. Drop-in for webhook bots.
//  Payload is a JSON-ish string built per bar that fires.
// ══════════════════════════════════════════════════════════════════════════════

buildAlertMsg(eventName) =>
    '{"event":"' + eventName + '","symbol":"' + syminfo.ticker + '","tf":"' + timeframe.period + '","price":' + str.tostring(close, format.mintick) + ',"htf_pd":"' + (inHTFPremium ? "premium" : inHTFDiscount ? "discount" : "eq") + '","in_ote":' + (isInOTE ? "true" : "false") + ',"in_kz":"' + (inLondon ? "london" : inNY ? "ny" : inAsia ? "asia" : "off") + '","htf_score":' + str.tostring(math.max(maxHTFBullScore, maxHTFBearScore)) + '}'

compEvt = bullSetupReady ? "bull_setup" : bearSetupReady ? "bear_setup" : bullReversal ? "bull_reversal" : bearReversal ? "bear_reversal" : sweepEQH ? "eqh_sweep" : sweepEQL ? "eql_sweep" : ""
if compEvt != ""
    alert(buildAlertMsg(compEvt), alert.freq_once_per_bar_close)

// ══════════════════════════════════════════════════════════════════════════════
//  MINI DASHBOARD  (Part 2 — Context, HTF & Composite)
//  [renamed: grpDASH->grpDASHc, showDashboard->showDashboardC, dashPos*->*C,
//   dashSz->dashSzC, table dash->dashC — to coexist with the Part 1 dashboard]
// ══════════════════════════════════════════════════════════════════════════════

grpDASHc = "Dashboard (Context)"
showDashboardC = input.bool(true, "Show Dashboard", group=grpDASHc)
dashPosInC     = input.string("middle_right", "Position", group=grpDASHc, options=["top_right","top_left","middle_right","middle_left","bottom_right","bottom_left"])
dashSizeInC    = input.string("small", "Text size", group=grpDASHc, options=["tiny","small","normal","large"])

dashPosC = dashPosInC == "top_right"     ? position.top_right     :
          dashPosInC == "top_left"      ? position.top_left      :
          dashPosInC == "middle_right"  ? position.middle_right  :
          dashPosInC == "middle_left"   ? position.middle_left   :
          dashPosInC == "bottom_right"  ? position.bottom_right  :
          position.bottom_left
dashSzC = dashSizeInC == "tiny"   ? size.tiny   :
         dashSizeInC == "small"  ? size.small  :
         dashSizeInC == "large"  ? size.large  :
         size.normal

eqlAge = bar_index - lastEQLSweepBar
eqhAge = bar_index - lastEQHSweepBar

inPremium  = close > swingMid
inDiscount = close < swingMid
priceLoc   = swingHi != swingLo ? math.abs(close - swingMid) / (swingHi - swingLo) * 100.0 : 0.0

var table dashC = table.new(dashPosC, 2, 11, bgcolor=color.new(#0A0A0A, 10), border_width=1, frame_color=color.new(color.gray, 50), frame_width=1, border_color=color.new(color.gray, 70))

if showDashboardC and barstate.islast
    headerBg = color.new(#1A1A2E, 0)
    table.cell(dashC, 0, 0, "SMC v21 — P2", text_color=color.white, bgcolor=headerBg, text_size=dashSzC)
    table.cell(dashC, 1, 0, sessTxt + (inMacro ? " M" : ""), text_color=color.gray, bgcolor=headerBg, text_size=size.tiny)

    pdTxt = inPremium ? ("PREMIUM " + str.tostring(priceLoc, "#.0") + "%") : inDiscount ? ("DISCOUNT " + str.tostring(priceLoc, "#.0") + "%") : "EQ"
    pdCol = inPremium ? pdPremColor : inDiscount ? pdDiscColor : color.gray
    table.cell(dashC, 0, 1, "PD location", text_color=color.white, text_size=dashSzC)
    table.cell(dashC, 1, 1, pdTxt, text_color=color.new(pdCol, 0), text_size=dashSzC)

    sweepTxt = ""
    if eqlAge <= 30
        sweepTxt := "EQL " + str.tostring(eqlAge) + "b"
    if eqhAge <= 30
        sweepTxt := sweepTxt == "" ? "EQH " + str.tostring(eqhAge) + "b" : sweepTxt + " | EQH " + str.tostring(eqhAge) + "b"
    if sweepTxt == ""
        sweepTxt := "-"
    table.cell(dashC, 0, 2, "Recent sweep", text_color=color.white, text_size=dashSzC)
    table.cell(dashC, 1, 2, sweepTxt, text_color=color.new(#00BCD4, 0), text_size=dashSzC)

    htfTxt = inHTFBullOB ? "BULL OB" : inHTFBearOB ? "BEAR OB" : inHTFBullFVG ? "BULL FVG" : inHTFBearFVG ? "BEAR FVG" : "-"
    htfCol = inHTFBullOB or inHTFBullFVG ? color.new(#00C853, 0) : inHTFBearOB or inHTFBearFVG ? color.new(#F23645, 0) : color.gray
    table.cell(dashC, 0, 3, "HTF (" + htfOBTF + ")", text_color=color.white, text_size=dashSzC)
    table.cell(dashC, 1, 3, htfTxt, text_color=color.new(htfCol, 0), text_size=dashSzC)

    htfPDTxt = inHTFPremium ? "PREMIUM" : inHTFDiscount ? "DISCOUNT" : "-"
    htfPDCol = inHTFPremium ? pdPremColor : inHTFDiscount ? pdDiscColor : color.gray
    table.cell(dashC, 0, 4, "HTF PD", text_color=color.white, text_size=dashSzC)
    table.cell(dashC, 1, 4, htfPDTxt, text_color=color.new(htfPDCol, 0), text_size=dashSzC)

    oteTxt = isInOTE ? "IN OTE" : "-"
    oteCol = isInOTE ? color.new(pdOTEColor, 0) : color.gray
    table.cell(dashC, 0, 5, "OTE", text_color=color.white, text_size=dashSzC)
    table.cell(dashC, 1, 5, oteTxt, text_color=oteCol, text_size=dashSzC)

    confTxt = (maxHTFBullScore > 0 or maxHTFBearScore > 0) ? "★" + str.tostring(math.max(maxHTFBullScore, maxHTFBearScore)) + "/3" : "-"
    confCol = (maxHTFBullScore > 0 or maxHTFBearScore > 0) ? color.new(#FFD600, 0) : color.gray
    table.cell(dashC, 0, 6, "HTF confluence", text_color=color.white, text_size=dashSzC)
    table.cell(dashC, 1, 6, confTxt, text_color=confCol, text_size=dashSzC)

    setupTxt = bullSetupReady ? "BULL A+" : bearSetupReady ? "BEAR A+" : bullReversal ? "BULL REV" : bearReversal ? "BEAR REV" : "-"
    setupCol = bullSetupReady or bullReversal ? color.new(#00C853, 0) : bearSetupReady or bearReversal ? color.new(#F23645, 0) : color.gray
    table.cell(dashC, 0, 7, "Setup", text_color=color.white, text_size=dashSzC)
    table.cell(dashC, 1, 7, setupTxt, text_color=setupCol, text_size=dashSzC)

    table.cell(dashC, 0, 8, "Range", text_color=color.white, text_size=dashSzC)
    rngTxt = "H " + str.tostring(swingHi, format.mintick) + " L " + str.tostring(swingLo, format.mintick)
    table.cell(dashC, 1, 8, rngTxt, text_color=color.new(color.gray, 0), text_size=size.tiny)

    table.cell(dashC, 0, 9, "ATR(14)", text_color=color.white, text_size=dashSzC)
    table.cell(dashC, 1, 9, str.tostring(atr14, format.mintick), text_color=color.new(color.gray, 0), text_size=dashSzC)

    smActive = inNY ? "NY" : inAsia ? "ASIA" : inLondon ? "LDN" : ""
    smTxt = na(sessMoveATRnow) ? "-" : smActive + " " + (sessMoveATRnow >= 0 ? "+" : "") + str.tostring(sessMoveATRnow, "#.0") + "x"
    smCol = na(sessMoveATRnow) ? color.gray : sessMoveATRnow >= 0 ? smUpCol : smDnCol
    table.cell(dashC, 0, 10, "Session move", text_color=color.white, text_size=dashSzC)
    table.cell(dashC, 1, 10, smTxt, text_color=smCol, text_size=dashSzC)

// Part 2 events (EQH/EQL sweeps, reversals, A+ setups) fire via the structured
// alert() JSON above — subscribe with "Any alert() function call".
