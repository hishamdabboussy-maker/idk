//@version=5
indicator("SMC v18 — Complete Suite (no signals)", overlay=true, max_boxes_count=500, max_lines_count=500, max_labels_count=500)

// ══════════════════════════════════════════════════════════════════════════════
//  v18 — ALL-IN-ONE SMC VISUALISATION (no BUY/SELL signals)
//
//  Sections (each independently togglable):
//     A) MARKET STRUCTURE — Internal + External BOS/CHoCH, strong/weak swings
//     B) ORDER BLOCKS — Bull / Bear with mitigation tracking
//     C) BREAKER BLOCKS — Auto-spawned from mitigated OBs (role flip)
//     D) MITIGATION BLOCKS — Reactive blocks at the last opposing candle
//                            before a displacement that DOES NOT break structure
//     E) REJECTION BLOCKS — Long-wick rejections at swing pivots
//     F) FAIR VALUE GAPS — 3-candle imbalances + optional midline
//     G) INVERSE FVGs — FVGs that have been violated and now act opposite
//     H) VOLUME IMBALANCES — Open/close gaps between consecutive candles
//     I) LIQUIDITY (EQH / EQL) — Clustered equal highs/lows + sweep marking
//     J) PREMIUM / DISCOUNT / OTE — Range box with EQ midline + OTE 62%-79%
//     K) SESSIONS — Asia / London / NY killzone background
//     L) PERIODIC LEVELS — Daily/Weekly/Monthly opens + PDH/PDL/PWH/PWL/PMH/PML
//     M) HTF ORDER BLOCKS — Order Blocks from a higher timeframe
//     N) HTF FAIR VALUE GAPS — FVGs from a higher timeframe
//     O) DISPLACEMENT — Highlights candles with big range vs ATR (FVG creators)
//     P) PROXIMITY FILTER — Auto-fade zones far from current price
//     Q) DASHBOARD — Live market-context readout
// ══════════════════════════════════════════════════════════════════════════════

// ══════════════════════════════════════════════════════════════════════════════
//  GLOBAL DISPLAY SETTINGS
// ══════════════════════════════════════════════════════════════════════════════

grpDISP = "⚙️ Global Display"
extendBoxes  = input.bool(true,  "Extend zones to right",      group=grpDISP)
proxEnable   = input.bool(true,  "Hide far zones (proximity)", group=grpDISP)
proxPct      = input.float(2.5,  "Max distance from price %",  group=grpDISP, minval=0.2, maxval=15.0, step=0.1)
masterLabels = input.bool(true,  "Show zone labels",           group=grpDISP)
labelDensity = input.string("Important", "Label density", group=grpDISP,
     options=["All","Important","Minimal"],
     tooltip="All = every zone gets a label.\nImportant = only OB, BB, CHoCH, sweep markers (skips FVG, IFVG, VI, RB, MB, swing points).\nMinimal = only CHoCH + sweep markers.")

extRight    = extendBoxes ? extend.right : extend.none
candleRange = high - low
bodyHigh    = math.max(open, close)
bodyLow     = math.min(open, close)
upperWick   = high  - bodyHigh
lowerWick   = bodyLow - low
atr14       = ta.atr(14)

// Label density gates — which label types are allowed at each density level
lblAllowOB      = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowBB      = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowBOS     = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowCHoCH   = masterLabels  // CHoCH always shown (all levels)
lblAllowSweep   = masterLabels  // Sweep markers always shown
lblAllowFVG     = masterLabels and labelDensity == "All"
lblAllowIFVG    = masterLabels and labelDensity == "All"
lblAllowVI      = masterLabels and labelDensity == "All"
lblAllowRB      = masterLabels and labelDensity == "All"
lblAllowMB      = masterLabels and labelDensity == "All"
lblAllowSwing   = masterLabels and labelDensity == "All"
lblAllowHTF     = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowPD      = masterLabels and (labelDensity == "All" or labelDensity == "Important")
lblAllowLevels  = masterLabels and (labelDensity == "All" or labelDensity == "Important")

zoneNear(zH, zL) =>
    if not proxEnable
        true
    else
        midZ = math.avg(zH, zL)
        close > 0 and math.abs(close - midZ) / close * 100.0 <= proxPct

fadeColor(c) => color.new(c, 100)

// ══════════════════════════════════════════════════════════════════════════════
//  A) MARKET STRUCTURE (BOS / CHoCH, strong/weak swings, internal/external)
// ══════════════════════════════════════════════════════════════════════════════

grpMS = "🏗️ Market Structure"
showStruct      = input.bool(true,  "Show market structure",       group=grpMS)
internalLen     = input.int(5,      "Internal swing lookback",     group=grpMS, minval=2, maxval=30)
externalLen     = input.int(25,     "External (HTF) swing lookback", group=grpMS, minval=10, maxval=100)
showInternal    = input.bool(true,  "Show internal BOS/CHoCH",     group=grpMS)
showExternal    = input.bool(true,  "Show external BOS/CHoCH",     group=grpMS)
showSwingPoints = input.bool(true,  "Show swing H/L labels",       group=grpMS)
strongWeakLbl   = input.bool(true,  "Tag strong/weak highs/lows",  group=grpMS,
     tooltip="A swing high is 'strong' if the prior swing low got broken; 'weak' otherwise. Mirror for swing lows.")
bullStructColor = input.color(color.new(#26A69A, 0),  "Bullish structure", group=grpMS)
bearStructColor = input.color(color.new(#EF5350, 0),  "Bearish structure", group=grpMS)

// Internal swings
intPH = ta.pivothigh(high, internalLen, internalLen)
intPL = ta.pivotlow(low,   internalLen, internalLen)
extPH = ta.pivothigh(high, externalLen, externalLen)
extPL = ta.pivotlow(low,   externalLen, externalLen)

var float intLastPH    = na
var float intLastPL    = na
var int   intLastPHBar = na
var int   intLastPLBar = na
var float extLastPH    = na
var float extLastPL    = na
var int   extLastPHBar = na
var int   extLastPLBar = na

if not na(intPH)
    intLastPH    := intPH
    intLastPHBar := bar_index - internalLen
if not na(intPL)
    intLastPL    := intPL
    intLastPLBar := bar_index - internalLen
if not na(extPH)
    extLastPH    := extPH
    extLastPHBar := bar_index - externalLen
if not na(extPL)
    extLastPL    := extPL
    extLastPLBar := bar_index - externalLen

// Internal trend tracker for CHoCH detection
var int intTrend = 0     // +1 up, -1 down
// BODY-break filter: the candle body (not wick) must cross the level for it to be significant
intBullBOS_raw  = not na(intLastPH) and bodyLow > intLastPH and close[1] <= intLastPH
intBearBOS_raw  = not na(intLastPL) and bodyHigh < intLastPL and close[1] >= intLastPL

intBullBOS  = false
intBullCHoCH = false
intBearBOS  = false
intBearCHoCH = false

if intBullBOS_raw
    if intTrend == -1
        intBullCHoCH := true
    else
        intBullBOS := true
    intTrend := 1
if intBearBOS_raw
    if intTrend == 1
        intBearCHoCH := true
    else
        intBearBOS := true
    intTrend := -1

// External trend tracker
var int extTrend = 0
// BODY-break filter for external structure too
extBullBOS_raw  = not na(extLastPH) and bodyLow > extLastPH and close[1] <= extLastPH
extBearBOS_raw  = not na(extLastPL) and bodyHigh < extLastPL and close[1] >= extLastPL

extBullBOS  = false
extBullCHoCH = false
extBearBOS  = false
extBearCHoCH = false

if extBullBOS_raw
    if extTrend == -1
        extBullCHoCH := true
    else
        extBullBOS := true
    extTrend := 1
if extBearBOS_raw
    if extTrend == 1
        extBearCHoCH := true
    else
        extBearBOS := true
    extTrend := -1

// Draw structure breaks
// ── LABEL DEDUP: track last direction + bar to avoid spam ────────────────────
var int lastIntStructDir  = 0   // +1 bull, -1 bear (dedup same-direction BOS)
var int lastExtStructDir  = 0
var int lastIntStructBar  = -9999
var int lastExtStructBar  = -9999
minStructGap = input.int(10, "Min bars between structure labels", group=grpMS, minval=0, maxval=50,
     tooltip="Suppresses repeat BOS/CHoCH labels within this many bars of the previous one. Keeps the chart clean on choppy price action.")

drawStructLine(brokenLevel, brokenBar, isCHoCH, isBull, isInternal) =>
    col   = isBull ? bullStructColor : bearStructColor
    style = isInternal ? line.style_dotted : line.style_solid
    width = isInternal ? 1 : 2
    txt   = (isCHoCH ? "CHoCH" : "BOS") + (isInternal ? "" : "")
    if showStruct
        line.new(brokenBar, brokenLevel, bar_index, brokenLevel, color=col, style=style, width=width)

// Helper: should we draw a structure label? (dedup + spacing)
canDrawStructLabel(isBull, isInternal) =>
    dir = isBull ? 1 : -1
    if isInternal
        sameDir = (lastIntStructDir == dir) and not false  // BOS in same dir = skip
        tooClose = (bar_index - lastIntStructBar) < minStructGap
        not sameDir and not tooClose
    else
        sameDir = (lastExtStructDir == dir) and not false
        tooClose = (bar_index - lastExtStructBar) < minStructGap
        not sameDir and not tooClose

if showInternal and intBullBOS
    drawStructLine(intLastPH, intLastPHBar, false, true, true)
    if lblAllowBOS and canDrawStructLabel(true, true)
        label.new(int(math.avg(intLastPHBar, bar_index)), intLastPH, "BOS",
             style=label.style_label_down, color=color.new(bullStructColor, 70), textcolor=color.white, size=size.tiny)
    lastIntStructDir := 1
    lastIntStructBar := bar_index
    intLastPH := na
if showInternal and intBullCHoCH
    drawStructLine(intLastPH, intLastPHBar, true, true, true)
    if lblAllowCHoCH
        label.new(int(math.avg(intLastPHBar, bar_index)), intLastPH, "CHoCH",
             style=label.style_label_down, color=color.new(bullStructColor, 70), textcolor=color.white, size=size.tiny)
    lastIntStructDir := 1
    lastIntStructBar := bar_index
    intLastPH := na
if showInternal and intBearBOS
    drawStructLine(intLastPL, intLastPLBar, false, false, true)
    if lblAllowBOS and canDrawStructLabel(false, true)
        label.new(int(math.avg(intLastPLBar, bar_index)), intLastPL, "BOS",
             style=label.style_label_up, color=color.new(bearStructColor, 70), textcolor=color.white, size=size.tiny)
    lastIntStructDir := -1
    lastIntStructBar := bar_index
    intLastPL := na
if showInternal and intBearCHoCH
    drawStructLine(intLastPL, intLastPLBar, true, false, true)
    if lblAllowCHoCH
        label.new(int(math.avg(intLastPLBar, bar_index)), intLastPL, "CHoCH",
             style=label.style_label_up, color=color.new(bearStructColor, 70), textcolor=color.white, size=size.tiny)
    lastIntStructDir := -1
    lastIntStructBar := bar_index
    intLastPL := na

if showExternal and extBullBOS
    drawStructLine(extLastPH, extLastPHBar, false, true, false)
    if lblAllowBOS and canDrawStructLabel(true, false)
        label.new(int(math.avg(extLastPHBar, bar_index)), extLastPH, "BOS",
             style=label.style_label_down, color=color.new(bullStructColor, 70), textcolor=color.white, size=size.tiny)
    lastExtStructDir := 1
    lastExtStructBar := bar_index
    extLastPH := na
if showExternal and extBullCHoCH
    drawStructLine(extLastPH, extLastPHBar, true, true, false)
    if lblAllowCHoCH
        label.new(int(math.avg(extLastPHBar, bar_index)), extLastPH, "CHoCH",
             style=label.style_label_down, color=color.new(bullStructColor, 70), textcolor=color.white, size=size.tiny)
    lastExtStructDir := 1
    lastExtStructBar := bar_index
    extLastPH := na
if showExternal and extBearBOS
    drawStructLine(extLastPL, extLastPLBar, false, false, false)
    if lblAllowBOS and canDrawStructLabel(false, false)
        label.new(int(math.avg(extLastPLBar, bar_index)), extLastPL, "BOS",
             style=label.style_label_up, color=color.new(bearStructColor, 70), textcolor=color.white, size=size.tiny)
    lastExtStructDir := -1
    lastExtStructBar := bar_index
    extLastPL := na
if showExternal and extBearCHoCH
    drawStructLine(extLastPL, extLastPLBar, true, false, false)
    if lblAllowCHoCH
        label.new(int(math.avg(extLastPLBar, bar_index)), extLastPL, "CHoCH",
             style=label.style_label_up, color=color.new(bearStructColor, 70), textcolor=color.white, size=size.tiny)
    lastExtStructDir := -1
    lastExtStructBar := bar_index
    extLastPL := na

// Strong / weak swing labels (use external swings)
var float prevExtPH      = na
var float prevExtPL      = na
var bool  prevSwingLowBroken  = false  // means current swing high above is "strong"
var bool  prevSwingHighBroken = false  // means current swing low below is "strong"

if not na(extPH)
    if showSwingPoints and showStruct and lblAllowSwing
        if strongWeakLbl
            tag = prevSwingLowBroken ? "SH" : "wH"
            label.new(bar_index - externalLen, extPH, tag,
                 style=label.style_label_down,
                 color=color.new(prevSwingLowBroken ? bearStructColor : color.gray, 50),
                 textcolor=color.white, size=size.tiny)
        else
            label.new(bar_index - externalLen, extPH, "H",
                 style=label.style_label_down,
                 color=color.new(bearStructColor, 60),
                 textcolor=color.white, size=size.tiny)
    prevExtPH            := extPH
    prevSwingHighBroken  := false  // a new swing high resets the "high broken" tracker
if not na(extPL)
    if showSwingPoints and showStruct and lblAllowSwing
        if strongWeakLbl
            tag = prevSwingHighBroken ? "SL" : "wL"
            label.new(bar_index - externalLen, extPL, tag,
                 style=label.style_label_up,
                 color=color.new(prevSwingHighBroken ? bullStructColor : color.gray, 50),
                 textcolor=color.white, size=size.tiny)
        else
            label.new(bar_index - externalLen, extPL, "L",
                 style=label.style_label_up,
                 color=color.new(bullStructColor, 60),
                 textcolor=color.white, size=size.tiny)
    prevExtPL           := extPL
    prevSwingLowBroken  := false

if extBullBOS_raw or extBullCHoCH
    prevSwingHighBroken := true  // we broke above the previous high
if extBearBOS_raw or extBearCHoCH
    prevSwingLowBroken  := true

// We also need internal-swing memory for OB / RB detection further below.
// Use the internal swings for now.
ph = intPH
pl = intPL
var float lastPH = na
var float lastPL = na
if not na(ph)
    lastPH := ph
if not na(pl)
    lastPL := pl
bullBOS = intBullBOS_raw
bearBOS = intBearBOS_raw
if bullBOS
    lastPH := na
if bearBOS
    lastPL := na

// ══════════════════════════════════════════════════════════════════════════════
//  B) ORDER BLOCKS
// ══════════════════════════════════════════════════════════════════════════════

grpOB = "🟦 Order Blocks"
showOB      = input.bool(true,  "Show Order Blocks",      group=grpOB)
obMaxBoxes  = input.int(5,      "Max OBs per side",       group=grpOB, minval=1, maxval=15)
obHideMitig = input.bool(true,  "Hide mitigated OBs",     group=grpOB)
obMitigMode = input.string("Close", "Mitigation by",      group=grpOB, options=["Wick","Close"])
obBullColor = input.color(color.new(#2962FF, 75), "Bull OB", group=grpOB)
obBearColor = input.color(color.new(#F23645, 75), "Bear OB", group=grpOB)

var obBullBoxes = array.new_box()
var obBullMitig = array.new_bool()
var obBullHi    = array.new_float()
var obBullLo    = array.new_float()

var obBearBoxes = array.new_box()
var obBearMitig = array.new_bool()
var obBearHi    = array.new_float()
var obBearLo    = array.new_float()

if showOB and bullBOS
    obIdx = 1
    for k = 1 to math.min(internalLen * 2, 50)
        if close[k] < open[k]
            obIdx := k
            break
    oH = high[obIdx]
    oL = low[obIdx]
    oB = bar_index - obIdx
    while array.size(obBullBoxes) >= obMaxBoxes
        box.delete(array.shift(obBullBoxes))
        array.shift(obBullMitig)
        array.shift(obBullHi)
        array.shift(obBullLo)
    b = box.new(oB, oH, bar_index, oL, bgcolor=obBullColor, border_color=obBullColor, extend=extRight)
    array.push(obBullBoxes, b)
    array.push(obBullMitig, false)
    array.push(obBullHi, oH)
    array.push(obBullLo, oL)
    if lblAllowOB
        label.new(oB, oH, "OB", style=label.style_label_down, color=obBullColor, textcolor=color.white, size=size.tiny)

if showOB and bearBOS
    obIdx = 1
    for k = 1 to math.min(internalLen * 2, 50)
        if close[k] > open[k]
            obIdx := k
            break
    oH = high[obIdx]
    oL = low[obIdx]
    oB = bar_index - obIdx
    while array.size(obBearBoxes) >= obMaxBoxes
        box.delete(array.shift(obBearBoxes))
        array.shift(obBearMitig)
        array.shift(obBearHi)
        array.shift(obBearLo)
    b = box.new(oB, oH, bar_index, oL, bgcolor=obBearColor, border_color=obBearColor, extend=extRight)
    array.push(obBearBoxes, b)
    array.push(obBearMitig, false)
    array.push(obBearHi, oH)
    array.push(obBearLo, oL)
    if lblAllowOB
        label.new(oB, oL, "OB", style=label.style_label_up, color=obBearColor, textcolor=color.white, size=size.tiny)

// OB mitigation
if showOB and array.size(obBullBoxes) > 0
    for i = 0 to array.size(obBullBoxes) - 1
        if not array.get(obBullMitig, i)
            mp = obMitigMode == "Wick" ? low : close
            if mp < array.get(obBullLo, i)
                if obHideMitig
                    box.delete(array.get(obBullBoxes, i))
                array.set(obBullMitig, i, true)

if showOB and array.size(obBearBoxes) > 0
    for i = 0 to array.size(obBearBoxes) - 1
        if not array.get(obBearMitig, i)
            mp = obMitigMode == "Wick" ? high : close
            if mp > array.get(obBearHi, i)
                if obHideMitig
                    box.delete(array.get(obBearBoxes, i))
                array.set(obBearMitig, i, true)

// ══════════════════════════════════════════════════════════════════════════════
//  C) BREAKER BLOCKS (mitigated OBs that flip role)
// ══════════════════════════════════════════════════════════════════════════════

grpBB = "🔴 Breaker Blocks"
showBB      = input.bool(true,  "Show Breaker Blocks",  group=grpBB)
bbMaxBoxes  = input.int(4,      "Max BBs per side",     group=grpBB, minval=1, maxval=15)
bbBullColor = input.color(color.new(#26A69A, 70), "Bull BB", group=grpBB)
bbBearColor = input.color(color.new(#EF5350, 70), "Bear BB", group=grpBB)

var bbBullBoxes    = array.new_box()
var bbBullHi       = array.new_float()
var bbBullLo       = array.new_float()
var bbBullMitig    = array.new_bool()
var bbBearBoxes    = array.new_box()
var bbBearHi       = array.new_float()
var bbBearLo       = array.new_float()
var bbBearMitig    = array.new_bool()
var bbBearSpawnedH = array.new_float()
var bbBullSpawnedH = array.new_float()

_alreadySpawned(arr, oH) =>
    found = false
    if array.size(arr) > 0
        for k = 0 to array.size(arr) - 1
            if math.abs(array.get(arr, k) - oH) / oH < 0.0005
                found := true
                break
    found

if showBB and showOB
    if array.size(obBullBoxes) > 0
        for i = 0 to array.size(obBullBoxes) - 1
            if array.get(obBullMitig, i)
                oH = array.get(obBullHi, i)
                oL = array.get(obBullLo, i)
                if not _alreadySpawned(bbBearSpawnedH, oH)
                    while array.size(bbBearBoxes) >= bbMaxBoxes
                        box.delete(array.shift(bbBearBoxes))
                        array.shift(bbBearHi)
                        array.shift(bbBearLo)
                        array.shift(bbBearMitig)
                    bx = box.new(bar_index - 1, oH, bar_index, oL, bgcolor=bbBearColor, border_color=bbBearColor, extend=extRight)
                    array.push(bbBearBoxes, bx)
                    array.push(bbBearHi, oH)
                    array.push(bbBearLo, oL)
                    array.push(bbBearMitig, false)
                    array.push(bbBearSpawnedH, oH)
                    if lblAllowBB
                        label.new(bar_index, oH, "BB", style=label.style_label_down, color=bbBearColor, textcolor=color.white, size=size.tiny)

    if array.size(obBearBoxes) > 0
        for i = 0 to array.size(obBearBoxes) - 1
            if array.get(obBearMitig, i)
                oH = array.get(obBearHi, i)
                oL = array.get(obBearLo, i)
                if not _alreadySpawned(bbBullSpawnedH, oH)
                    while array.size(bbBullBoxes) >= bbMaxBoxes
                        box.delete(array.shift(bbBullBoxes))
                        array.shift(bbBullHi)
                        array.shift(bbBullLo)
                        array.shift(bbBullMitig)
                    bx = box.new(bar_index - 1, oH, bar_index, oL, bgcolor=bbBullColor, border_color=bbBullColor, extend=extRight)
                    array.push(bbBullBoxes, bx)
                    array.push(bbBullHi, oH)
                    array.push(bbBullLo, oL)
                    array.push(bbBullMitig, false)
                    array.push(bbBullSpawnedH, oH)
                    if lblAllowBB
                        label.new(bar_index, oL, "BB", style=label.style_label_up, color=bbBullColor, textcolor=color.white, size=size.tiny)

if showBB and array.size(bbBullBoxes) > 0
    for i = 0 to array.size(bbBullBoxes) - 1
        if not array.get(bbBullMitig, i)
            if close < array.get(bbBullLo, i)
                box.delete(array.get(bbBullBoxes, i))
                array.set(bbBullMitig, i, true)
if showBB and array.size(bbBearBoxes) > 0
    for i = 0 to array.size(bbBearBoxes) - 1
        if not array.get(bbBearMitig, i)
            if close > array.get(bbBearHi, i)
                box.delete(array.get(bbBearBoxes, i))
                array.set(bbBearMitig, i, true)

// ══════════════════════════════════════════════════════════════════════════════
//  D) MITIGATION BLOCKS
//
//  Definition used here: a 3-bar setup where bar[1] is a strong displacement
//  candle (range >= mbDispATR × ATR) AND bar[2] is the OPPOSING-color candle
//  immediately preceding it. The MB is drawn at bar[2]. Unlike OBs we don't
//  require a structure break; this captures pre-displacement reaction zones.
// ══════════════════════════════════════════════════════════════════════════════

grpMB = "🟠 Mitigation Blocks"
showMB     = input.bool(true,  "Show Mitigation Blocks", group=grpMB)
mbDispATR  = input.float(1.5,  "Displacement × ATR",     group=grpMB, minval=0.5, maxval=5.0, step=0.1)
mbMaxBoxes = input.int(3,      "Max MBs per side",       group=grpMB, minval=1, maxval=10)
mbBullColor= input.color(color.new(#FFC107, 75), "Bull MB", group=grpMB)
mbBearColor= input.color(color.new(#9C27B0, 75), "Bear MB", group=grpMB)

var mbBullBoxes = array.new_box()
var mbBullMitig = array.new_bool()
var mbBullHi    = array.new_float()
var mbBullLo    = array.new_float()
var mbBearBoxes = array.new_box()
var mbBearMitig = array.new_bool()
var mbBearHi    = array.new_float()
var mbBearLo    = array.new_float()

dispBull = candleRange[1] >= mbDispATR * atr14[1] and close[1] > open[1]
dispBear = candleRange[1] >= mbDispATR * atr14[1] and close[1] < open[1]
oppBullMB = dispBull and close[2] < open[2]
oppBearMB = dispBear and close[2] > open[2]

if showMB and oppBullMB
    while array.size(mbBullBoxes) >= mbMaxBoxes
        box.delete(array.shift(mbBullBoxes))
        array.shift(mbBullMitig)
        array.shift(mbBullHi)
        array.shift(mbBullLo)
    b = box.new(bar_index - 2, high[2], bar_index, low[2], bgcolor=mbBullColor, border_color=mbBullColor, extend=extRight)
    array.push(mbBullBoxes, b)
    array.push(mbBullMitig, false)
    array.push(mbBullHi, high[2])
    array.push(mbBullLo, low[2])
    if lblAllowMB
        label.new(bar_index - 2, high[2], "MB", style=label.style_label_down, color=mbBullColor, textcolor=color.white, size=size.tiny)

if showMB and oppBearMB
    while array.size(mbBearBoxes) >= mbMaxBoxes
        box.delete(array.shift(mbBearBoxes))
        array.shift(mbBearMitig)
        array.shift(mbBearHi)
        array.shift(mbBearLo)
    b = box.new(bar_index - 2, high[2], bar_index, low[2], bgcolor=mbBearColor, border_color=mbBearColor, extend=extRight)
    array.push(mbBearBoxes, b)
    array.push(mbBearMitig, false)
    array.push(mbBearHi, high[2])
    array.push(mbBearLo, low[2])
    if lblAllowMB
        label.new(bar_index - 2, low[2], "MB", style=label.style_label_up, color=mbBearColor, textcolor=color.white, size=size.tiny)

if showMB and array.size(mbBullBoxes) > 0
    for i = 0 to array.size(mbBullBoxes) - 1
        if not array.get(mbBullMitig, i)
            if close < array.get(mbBullLo, i)
                box.delete(array.get(mbBullBoxes, i))
                array.set(mbBullMitig, i, true)

if showMB and array.size(mbBearBoxes) > 0
    for i = 0 to array.size(mbBearBoxes) - 1
        if not array.get(mbBearMitig, i)
            if close > array.get(mbBearHi, i)
                box.delete(array.get(mbBearBoxes, i))
                array.set(mbBearMitig, i, true)

// ══════════════════════════════════════════════════════════════════════════════
//  E) REJECTION BLOCKS (long-wick rejections at swing pivots)
// ══════════════════════════════════════════════════════════════════════════════

grpRB = "🟣 Rejection Blocks"
showRB      = input.bool(true,  "Show Rejection Blocks",  group=grpRB)
rbWickRatio = input.float(0.6,  "Min wick/range ratio",   group=grpRB, minval=0.4, maxval=0.9, step=0.05)
rbMaxBoxes  = input.int(3,      "Max RBs per side",       group=grpRB, minval=1, maxval=10)
rbHideMitig = input.bool(true,  "Hide mitigated RBs",     group=grpRB)
rbBullColor = input.color(color.new(#00BCD4, 70), "Bull RB", group=grpRB)
rbBearColor = input.color(color.new(#FF6D00, 70), "Bear RB", group=grpRB)

isBullRB = not na(lastPL) and low < lastPL and close > lastPL and candleRange > 0 and (lowerWick / candleRange >= rbWickRatio)
isBearRB = not na(lastPH) and high > lastPH and close < lastPH and candleRange > 0 and (upperWick / candleRange >= rbWickRatio)

var rbBullBoxes = array.new_box()
var rbBullMitig = array.new_bool()
var rbBullHi    = array.new_float()
var rbBullLo    = array.new_float()

var rbBearBoxes = array.new_box()
var rbBearMitig = array.new_bool()
var rbBearHi    = array.new_float()
var rbBearLo    = array.new_float()

if showRB and isBullRB
    while array.size(rbBullBoxes) >= rbMaxBoxes
        box.delete(array.shift(rbBullBoxes))
        array.shift(rbBullMitig)
        array.shift(rbBullHi)
        array.shift(rbBullLo)
    b = box.new(bar_index - 1, high, bar_index, low, bgcolor=rbBullColor, border_color=rbBullColor, extend=extRight)
    array.push(rbBullBoxes, b)
    array.push(rbBullMitig, false)
    array.push(rbBullHi, high)
    array.push(rbBullLo, low)
    if lblAllowRB
        label.new(bar_index, low, "RB", style=label.style_label_up, color=rbBullColor, textcolor=color.white, size=size.tiny)

if showRB and isBearRB
    while array.size(rbBearBoxes) >= rbMaxBoxes
        box.delete(array.shift(rbBearBoxes))
        array.shift(rbBearMitig)
        array.shift(rbBearHi)
        array.shift(rbBearLo)
    b = box.new(bar_index - 1, high, bar_index, low, bgcolor=rbBearColor, border_color=rbBearColor, extend=extRight)
    array.push(rbBearBoxes, b)
    array.push(rbBearMitig, false)
    array.push(rbBearHi, high)
    array.push(rbBearLo, low)
    if lblAllowRB
        label.new(bar_index, high, "RB", style=label.style_label_down, color=rbBearColor, textcolor=color.white, size=size.tiny)

if showRB and array.size(rbBullBoxes) > 0
    for i = 0 to array.size(rbBullBoxes) - 1
        if not array.get(rbBullMitig, i)
            if close < array.get(rbBullLo, i)
                if rbHideMitig
                    box.delete(array.get(rbBullBoxes, i))
                array.set(rbBullMitig, i, true)
if showRB and array.size(rbBearBoxes) > 0
    for i = 0 to array.size(rbBearBoxes) - 1
        if not array.get(rbBearMitig, i)
            if close > array.get(rbBearHi, i)
                if rbHideMitig
                    box.delete(array.get(rbBearBoxes, i))
                array.set(rbBearMitig, i, true)

// ══════════════════════════════════════════════════════════════════════════════
//  F) FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════════════════════

grpFVG = "🟩 Fair Value Gaps"
showFVG     = input.bool(true,  "Show FVGs",              group=grpFVG)
fvgMinSize  = input.float(0.1,  "Min gap % (0=any)",      group=grpFVG, minval=0.0, maxval=2.0, step=0.01,
     tooltip="Gap must be at least this % of price AND meet the ATR filter below. Raised default from 0.05 to 0.1 to cut noise.")
fvgMinATR   = input.float(0.3,  "Min gap size (× ATR14)", group=grpFVG, minval=0.0, maxval=3.0, step=0.1,
     tooltip="Gap must also be at least this multiple of ATR(14). Set 0 to disable. Default 0.3 filters out tiny imbalances.")
fvgMaxBoxes = input.int(3,      "Max FVGs per side",      group=grpFVG, minval=1, maxval=15)
showFVGMid  = input.bool(true,  "Show midline (CE)",      group=grpFVG,
     tooltip="Consequent encroachment line — the FVG midpoint is where ICT-style entries are usually triggered.")
fvgBullColor= input.color(color.new(#00C853, 80), "Bull FVG", group=grpFVG)
fvgBearColor= input.color(color.new(#FF1744, 80), "Bear FVG", group=grpFVG)

minGapVal = close * fvgMinSize / 100.0
minGapATR = fvgMinATR > 0 and not na(atr14) ? fvgMinATR * atr14 : 0.0
isBullFVG = (low - high[2]) > math.max(minGapVal, minGapATR)
isBearFVG = (low[2] - high) > math.max(minGapVal, minGapATR)

var fvgBullBoxes = array.new_box()
var fvgBullLines = array.new_line()
var fvgBullTop   = array.new_float()
var fvgBullBot   = array.new_float()
var fvgBullDead  = array.new_bool()

var fvgBearBoxes = array.new_box()
var fvgBearLines = array.new_line()
var fvgBearTop   = array.new_float()
var fvgBearBot   = array.new_float()
var fvgBearDead  = array.new_bool()

if showFVG and isBullFVG
    while array.size(fvgBullBoxes) >= fvgMaxBoxes
        box.delete(array.shift(fvgBullBoxes))
        if array.size(fvgBullLines) > 0
            line.delete(array.shift(fvgBullLines))
        array.shift(fvgBullTop)
        array.shift(fvgBullBot)
        array.shift(fvgBullDead)
    gT = low
    gB = high[2]
    bx = box.new(bar_index[2], gT, bar_index, gB, bgcolor=fvgBullColor, border_color=fvgBullColor, extend=extRight)
    array.push(fvgBullBoxes, bx)
    array.push(fvgBullTop, gT)
    array.push(fvgBullBot, gB)
    array.push(fvgBullDead, false)
    if showFVGMid
        l = line.new(bar_index[2], math.avg(gT, gB), bar_index, math.avg(gT, gB), color=color.new(color.white, 50), style=line.style_dashed, extend=extRight)
        array.push(fvgBullLines, l)
    if lblAllowFVG
        label.new(bar_index, gB, "FVG", style=label.style_label_up, color=fvgBullColor, textcolor=color.white, size=size.tiny)

if showFVG and isBearFVG
    while array.size(fvgBearBoxes) >= fvgMaxBoxes
        box.delete(array.shift(fvgBearBoxes))
        if array.size(fvgBearLines) > 0
            line.delete(array.shift(fvgBearLines))
        array.shift(fvgBearTop)
        array.shift(fvgBearBot)
        array.shift(fvgBearDead)
    gT = low[2]
    gB = high
    bx = box.new(bar_index[2], gT, bar_index, gB, bgcolor=fvgBearColor, border_color=fvgBearColor, extend=extRight)
    array.push(fvgBearBoxes, bx)
    array.push(fvgBearTop, gT)
    array.push(fvgBearBot, gB)
    array.push(fvgBearDead, false)
    if showFVGMid
        l = line.new(bar_index[2], math.avg(gT, gB), bar_index, math.avg(gT, gB), color=color.new(color.white, 50), style=line.style_dashed, extend=extRight)
        array.push(fvgBearLines, l)
    if lblAllowFVG
        label.new(bar_index, gT, "FVG", style=label.style_label_down, color=fvgBearColor, textcolor=color.white, size=size.tiny)

if showFVG and array.size(fvgBullBoxes) > 0
    idxR = array.size(fvgBullBoxes) - 1
    while idxR >= 0
        if not array.get(fvgBullDead, idxR)
            gB = array.get(fvgBullBot, idxR)
            if close < gB and open < gB
                box.delete(array.get(fvgBullBoxes, idxR))
                if idxR < array.size(fvgBullLines)
                    line.delete(array.get(fvgBullLines, idxR))
                array.set(fvgBullDead, idxR, true)
        idxR -= 1

if showFVG and array.size(fvgBearBoxes) > 0
    idxR = array.size(fvgBearBoxes) - 1
    while idxR >= 0
        if not array.get(fvgBearDead, idxR)
            gT = array.get(fvgBearTop, idxR)
            if close > gT and open > gT
                box.delete(array.get(fvgBearBoxes, idxR))
                if idxR < array.size(fvgBearLines)
                    line.delete(array.get(fvgBearLines, idxR))
                array.set(fvgBearDead, idxR, true)
        idxR -= 1

// ══════════════════════════════════════════════════════════════════════════════
//  G) INVERSE FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════════════════════

grpIFVG = "🟧 Inverse FVGs"
showIFVG     = input.bool(true,  "Show IFVGs",            group=grpIFVG)
ifvgStrict   = input.bool(true,  "Require close inside",  group=grpIFVG)
ifvgMaxBoxes = input.int(2,      "Max IFVGs per side",    group=grpIFVG, minval=1, maxval=10)
ifvgBullColor= input.color(color.new(#FF6D00, 80), "Bull IFVG", group=grpIFVG)
ifvgBearColor= input.color(color.new(#AA00FF, 80), "Bear IFVG", group=grpIFVG)

var pendBullTop = array.new_float()
var pendBullBot = array.new_float()
var pendBullBar = array.new_int()
var pendBearTop = array.new_float()
var pendBearBot = array.new_float()
var pendBearBar = array.new_int()
var ifvgBullBoxes = array.new_box()
var ifvgBullTop   = array.new_float()
var ifvgBullBot   = array.new_float()
var ifvgBearBoxes = array.new_box()
var ifvgBearTop   = array.new_float()
var ifvgBearBot   = array.new_float()

MAX_PEND = ifvgMaxBoxes * 2

if showIFVG
    if isBullFVG
        if array.size(pendBullTop) >= MAX_PEND
            array.shift(pendBullTop)
            array.shift(pendBullBot)
            array.shift(pendBullBar)
        array.push(pendBullTop, low)
        array.push(pendBullBot, high[2])
        array.push(pendBullBar, bar_index[2])
    if isBearFVG
        if array.size(pendBearTop) >= MAX_PEND
            array.shift(pendBearTop)
            array.shift(pendBearBot)
            array.shift(pendBearBar)
        array.push(pendBearTop, low[2])
        array.push(pendBearBot, high)
        array.push(pendBearBar, bar_index[2])

    idx = 0
    while idx < array.size(pendBullTop)
        t  = array.get(pendBullTop, idx)
        b2 = array.get(pendBullBot, idx)
        sB = array.get(pendBullBar, idx)
        hit = ifvgStrict ? (close <= t and close >= b2) : (low <= t and high >= b2)
        if hit
            while array.size(ifvgBullBoxes) >= ifvgMaxBoxes
                box.delete(array.shift(ifvgBullBoxes))
                array.shift(ifvgBullTop)
                array.shift(ifvgBullBot)
            array.push(ifvgBullBoxes, box.new(sB, t, bar_index, b2, bgcolor=ifvgBullColor, border_color=ifvgBullColor, extend=extRight))
            array.push(ifvgBullTop, t)
            array.push(ifvgBullBot, b2)
            if lblAllowIFVG
                label.new(bar_index, b2, "IFVG", style=label.style_label_up, color=ifvgBullColor, textcolor=color.white, size=size.tiny)
            array.remove(pendBullTop, idx)
            array.remove(pendBullBot, idx)
            array.remove(pendBullBar, idx)
        else
            idx += 1

    idx2 = 0
    while idx2 < array.size(pendBearTop)
        t  = array.get(pendBearTop, idx2)
        b2 = array.get(pendBearBot, idx2)
        sB = array.get(pendBearBar, idx2)
        hit = ifvgStrict ? (close <= t and close >= b2) : (low <= t and high >= b2)
        if hit
            while array.size(ifvgBearBoxes) >= ifvgMaxBoxes
                box.delete(array.shift(ifvgBearBoxes))
                array.shift(ifvgBearTop)
                array.shift(ifvgBearBot)
            array.push(ifvgBearBoxes, box.new(sB, t, bar_index, b2, bgcolor=ifvgBearColor, border_color=ifvgBearColor, extend=extRight))
            array.push(ifvgBearTop, t)
            array.push(ifvgBearBot, b2)
            if lblAllowIFVG
                label.new(bar_index, t, "IFVG", style=label.style_label_down, color=ifvgBearColor, textcolor=color.white, size=size.tiny)
            array.remove(pendBearTop, idx2)
            array.remove(pendBearBot, idx2)
            array.remove(pendBearBar, idx2)
        else
            idx2 += 1

// IFVG mitigation
if showIFVG and array.size(ifvgBullBoxes) > 0
    idxR = array.size(ifvgBullBoxes) - 1
    while idxR >= 0
        gB = array.get(ifvgBullBot, idxR)
        if close < gB and open < gB
            box.delete(array.get(ifvgBullBoxes, idxR))
            array.remove(ifvgBullBoxes, idxR)
            array.remove(ifvgBullTop, idxR)
            array.remove(ifvgBullBot, idxR)
        idxR -= 1
if showIFVG and array.size(ifvgBearBoxes) > 0
    idxR = array.size(ifvgBearBoxes) - 1
    while idxR >= 0
        gT = array.get(ifvgBearTop, idxR)
        if close > gT and open > gT
            box.delete(array.get(ifvgBearBoxes, idxR))
            array.remove(ifvgBearBoxes, idxR)
            array.remove(ifvgBearTop, idxR)
            array.remove(ifvgBearBot, idxR)
        idxR -= 1

// ══════════════════════════════════════════════════════════════════════════════
//  H) VOLUME IMBALANCES
//
//  A volume imbalance is an open/close gap between two consecutive candles
//  in the SAME direction — i.e. close[1] doesn't quite reach open[0] (bull)
//  or vice versa for bear. It's a smaller, "wickless" gap, often filled
//  before a true FVG.
// ══════════════════════════════════════════════════════════════════════════════

grpVI = "🟦 Volume Imbalances"
showVI    = input.bool(true,  "Show Volume Imbalances", group=grpVI)
viMaxBoxes= input.int(4,      "Max VIs per side",       group=grpVI, minval=1, maxval=12)
viBullColor= input.color(color.new(#80DEEA, 75), "Bull VI", group=grpVI)
viBearColor= input.color(color.new(#FFAB91, 75), "Bear VI", group=grpVI)

isBullVI = close[1] > open[1] and close > open and open > close[1] and (open - close[1]) > 0
isBearVI = close[1] < open[1] and close < open and open < close[1] and (close[1] - open) > 0

var viBullBoxes = array.new_box()
var viBullTop   = array.new_float()
var viBullBot   = array.new_float()
var viBullDead  = array.new_bool()
var viBearBoxes = array.new_box()
var viBearTop   = array.new_float()
var viBearBot   = array.new_float()
var viBearDead  = array.new_bool()

if showVI and isBullVI
    while array.size(viBullBoxes) >= viMaxBoxes
        box.delete(array.shift(viBullBoxes))
        array.shift(viBullTop)
        array.shift(viBullBot)
        array.shift(viBullDead)
    bx = box.new(bar_index - 1, open, bar_index, close[1], bgcolor=viBullColor, border_color=viBullColor, extend=extRight)
    array.push(viBullBoxes, bx)
    array.push(viBullTop, open)
    array.push(viBullBot, close[1])
    array.push(viBullDead, false)

if showVI and isBearVI
    while array.size(viBearBoxes) >= viMaxBoxes
        box.delete(array.shift(viBearBoxes))
        array.shift(viBearTop)
        array.shift(viBearBot)
        array.shift(viBearDead)
    bx = box.new(bar_index - 1, close[1], bar_index, open, bgcolor=viBearColor, border_color=viBearColor, extend=extRight)
    array.push(viBearBoxes, bx)
    array.push(viBearTop, close[1])
    array.push(viBearBot, open)
    array.push(viBearDead, false)

if showVI and array.size(viBullBoxes) > 0
    idxR = array.size(viBullBoxes) - 1
    while idxR >= 0
        if not array.get(viBullDead, idxR)
            if close < array.get(viBullBot, idxR)
                box.delete(array.get(viBullBoxes, idxR))
                array.set(viBullDead, idxR, true)
        idxR -= 1
if showVI and array.size(viBearBoxes) > 0
    idxR = array.size(viBearBoxes) - 1
    while idxR >= 0
        if not array.get(viBearDead, idxR)
            if close > array.get(viBearTop, idxR)
                box.delete(array.get(viBearBoxes, idxR))
                array.set(viBearDead, idxR, true)
        idxR -= 1

// ══════════════════════════════════════════════════════════════════════════════
//  I) LIQUIDITY (EQH / EQL) + sweep markers
// ══════════════════════════════════════════════════════════════════════════════

grpLIQ = "💧 Liquidity (EQH/EQL)"
showLIQ      = input.bool(true,  "Show EQH/EQL",            group=grpLIQ)
liqLookback  = input.int(10,     "Pivot lookback",          group=grpLIQ, minval=3, maxval=50)
liqTolerance = input.float(0.05, "Equal level tolerance %", group=grpLIQ, minval=0.01, maxval=1.0, step=0.01)
liqMinTouch  = input.int(2,      "Min pivots to confirm",   group=grpLIQ, minval=2, maxval=5)
liqMaxLines  = input.int(5,      "Max levels per side",     group=grpLIQ, minval=1, maxval=12)
liqEQHColor  = input.color(color.new(#FF5252, 50), "EQH (BSL)", group=grpLIQ)
liqEQLColor  = input.color(color.new(#69F0AE, 50), "EQL (SSL)", group=grpLIQ)
liqSweptHide = input.bool(false, "Hide swept lines",        group=grpLIQ)
showSweepLbl = input.bool(true,  "Show sweep markers",      group=grpLIQ)
showBSLSSLLbl= input.bool(true,  "Tag BSL / SSL on EQH/EQL",group=grpLIQ)

liqPH = ta.pivothigh(high, liqLookback, liqLookback)
liqPL = ta.pivotlow(low,   liqLookback, liqLookback)

var pendHighLvl = array.new_float()
var pendHighBar = array.new_int()
var pendLowLvl  = array.new_float()
var pendLowBar  = array.new_int()

var liqHighLines  = array.new_line()
var liqHighLevels = array.new_float()
var liqHighSwept  = array.new_bool()
var liqLowLines   = array.new_line()
var liqLowLevels  = array.new_float()
var liqLowSwept   = array.new_bool()

PEND_KEEP = 12

if showLIQ and not na(liqPH)
    if array.size(pendHighLvl) >= PEND_KEEP
        array.shift(pendHighLvl)
        array.shift(pendHighBar)
    array.push(pendHighLvl, liqPH)
    array.push(pendHighBar, bar_index - liqLookback)
    tolVal = liqPH * liqTolerance / 100.0
    matched = false
    if array.size(liqHighLevels) > 0
        for i = 0 to array.size(liqHighLevels) - 1
            if not array.get(liqHighSwept, i)
                if math.abs(array.get(liqHighLevels, i) - liqPH) <= tolVal
                    matched := true
                    break
    cluster = 0
    earliestBar = bar_index
    if array.size(pendHighLvl) > 0
        for i = 0 to array.size(pendHighLvl) - 1
            if math.abs(array.get(pendHighLvl, i) - liqPH) <= tolVal
                cluster += 1
                pb = array.get(pendHighBar, i)
                if pb < earliestBar
                    earliestBar := pb
    if not matched and cluster >= liqMinTouch
        while array.size(liqHighLevels) >= liqMaxLines
            line.delete(array.shift(liqHighLines))
            array.shift(liqHighLevels)
            array.shift(liqHighSwept)
        l = line.new(earliestBar, liqPH, bar_index, liqPH,
             color=liqEQHColor, style=line.style_dashed, width=1, extend=extend.right)
        array.push(liqHighLines, l)
        array.push(liqHighLevels, liqPH)
        array.push(liqHighSwept, false)
        if lblAllowPD
            tag = showBSLSSLLbl ? "BSL" : "EQH"
            label.new(bar_index - liqLookback, liqPH, tag,
                 style=label.style_label_down, color=liqEQHColor,
                 textcolor=color.white, size=size.tiny)

if showLIQ and not na(liqPL)
    if array.size(pendLowLvl) >= PEND_KEEP
        array.shift(pendLowLvl)
        array.shift(pendLowBar)
    array.push(pendLowLvl, liqPL)
    array.push(pendLowBar, bar_index - liqLookback)
    tolVal = liqPL * liqTolerance / 100.0
    matched = false
    if array.size(liqLowLevels) > 0
        for i = 0 to array.size(liqLowLevels) - 1
            if not array.get(liqLowSwept, i)
                if math.abs(array.get(liqLowLevels, i) - liqPL) <= tolVal
                    matched := true
                    break
    cluster = 0
    earliestBar = bar_index
    if array.size(pendLowLvl) > 0
        for i = 0 to array.size(pendLowLvl) - 1
            if math.abs(array.get(pendLowLvl, i) - liqPL) <= tolVal
                cluster += 1
                pb = array.get(pendLowBar, i)
                if pb < earliestBar
                    earliestBar := pb
    if not matched and cluster >= liqMinTouch
        while array.size(liqLowLevels) >= liqMaxLines
            line.delete(array.shift(liqLowLines))
            array.shift(liqLowLevels)
            array.shift(liqLowSwept)
        l = line.new(earliestBar, liqPL, bar_index, liqPL,
             color=liqEQLColor, style=line.style_dashed, width=1, extend=extend.right)
        array.push(liqLowLines, l)
        array.push(liqLowLevels, liqPL)
        array.push(liqLowSwept, false)
        if lblAllowPD
            tag = showBSLSSLLbl ? "SSL" : "EQL"
            label.new(bar_index - liqLookback, liqPL, tag,
                 style=label.style_label_up, color=liqEQLColor,
                 textcolor=color.white, size=size.tiny)

var int lastEQLSweepBar = -9999
var int lastEQHSweepBar = -9999

// Track BREAKS (close-throughs) — fade the line, no sweep marker.
if showLIQ and array.size(liqHighLevels) > 0
    for i = 0 to array.size(liqHighLevels) - 1
        if not array.get(liqHighSwept, i)
            if close > array.get(liqHighLevels, i)
                if liqSweptHide
                    line.delete(array.get(liqHighLines, i))
                else
                    line.set_color(array.get(liqHighLines, i), color.new(liqEQHColor, 85))
                array.set(liqHighSwept, i, true)
if showLIQ and array.size(liqLowLevels) > 0
    for i = 0 to array.size(liqLowLevels) - 1
        if not array.get(liqLowSwept, i)
            if close < array.get(liqLowLevels, i)
                if liqSweptHide
                    line.delete(array.get(liqLowLines, i))
                else
                    line.set_color(array.get(liqLowLines, i), color.new(liqEQLColor, 85))
                array.set(liqLowSwept, i, true)

// REAL SWEEPS — wick beyond, close back inside. Drop a marker.
sweepEQL = false
sweepEQH = false
if showLIQ and array.size(liqLowLevels) > 0
    for i = 0 to array.size(liqLowLevels) - 1
        if not array.get(liqLowSwept, i)
            lvl = array.get(liqLowLevels, i)
            if low < lvl and close > lvl
                lastEQLSweepBar := bar_index
                array.set(liqLowSwept, i, true)
                sweepEQL := true
                if liqSweptHide
                    line.delete(array.get(liqLowLines, i))
                else
                    line.set_color(array.get(liqLowLines, i), color.new(liqEQLColor, 75))
if showLIQ and array.size(liqHighLevels) > 0
    for i = 0 to array.size(liqHighLevels) - 1
        if not array.get(liqHighSwept, i)
            lvl = array.get(liqHighLevels, i)
            if high > lvl and close < lvl
                lastEQHSweepBar := bar_index
                array.set(liqHighSwept, i, true)
                sweepEQH := true
                if liqSweptHide
                    line.delete(array.get(liqHighLines, i))
                else
                    line.set_color(array.get(liqHighLines, i), color.new(liqEQHColor, 75))

plotshape(showSweepLbl and sweepEQL, title="EQL sweep", location=location.belowbar, style=shape.triangleup,   color=liqEQLColor, size=size.tiny, text="×")
plotshape(showSweepLbl and sweepEQH, title="EQH sweep", location=location.abovebar, style=shape.triangledown, color=liqEQHColor, size=size.tiny, text="×")

// ══════════════════════════════════════════════════════════════════════════════
//  J) PREMIUM / DISCOUNT / OTE
// ══════════════════════════════════════════════════════════════════════════════

grpPD = "🎯 Premium / Discount / OTE"
showPD       = input.bool(true,  "Show PD range",      group=grpPD)
pdLookback   = input.int(50,     "Range lookback",     group=grpPD, minval=10, maxval=400)
showOTE      = input.bool(true,  "Show OTE 62-79%",    group=grpPD)
pdPremColor  = input.color(color.new(#F23645, 85), "Premium",   group=grpPD)
pdDiscColor  = input.color(color.new(#26A69A, 85), "Discount",  group=grpPD)
pdEqColor    = input.color(color.new(color.gray, 30), "Equilibrium line", group=grpPD)
pdOTEColor   = input.color(color.new(#FFD600, 75), "OTE", group=grpPD)

rngHi  = ta.highest(high, pdLookback)
rngLo  = ta.lowest(low,   pdLookback)
rngMid = math.avg(rngHi, rngLo)

var box pdBoxPrem  = na
var box pdBoxDisc  = na
var line pdEqLine  = na
var box pdOTEBull  = na
var box pdOTEBear  = na

if showPD and barstate.islast
    if not na(pdBoxPrem)
        box.delete(pdBoxPrem)
    if not na(pdBoxDisc)
        box.delete(pdBoxDisc)
    if not na(pdEqLine)
        line.delete(pdEqLine)
    pdBoxPrem := box.new(bar_index - pdLookback, rngHi, bar_index, rngMid, bgcolor=pdPremColor, border_color=pdPremColor, extend=extend.right)
    pdBoxDisc := box.new(bar_index - pdLookback, rngMid, bar_index, rngLo, bgcolor=pdDiscColor, border_color=pdDiscColor, extend=extend.right)
    pdEqLine  := line.new(bar_index - pdLookback, rngMid, bar_index, rngMid, color=pdEqColor, style=line.style_dashed, extend=extend.right)
    if lblAllowHTF
        label.new(bar_index, rngHi, "PREMIUM",  style=label.style_label_left, color=color.new(pdPremColor, 30), textcolor=color.white, size=size.tiny)
        label.new(bar_index, rngLo, "DISCOUNT", style=label.style_label_left, color=color.new(pdDiscColor, 30), textcolor=color.white, size=size.tiny)
        label.new(bar_index, rngMid, "EQ",       style=label.style_label_left, color=color.new(color.gray, 60), textcolor=color.white, size=size.tiny)

// OTE (Optimal Trade Entry): 62-79% retracement of the most recent leg.
// Determine "leg direction" by comparing last two external swings.
if showPD and showOTE and barstate.islast
    if not na(pdOTEBull)
        box.delete(pdOTEBull)
    if not na(pdOTEBear)
        box.delete(pdOTEBear)
    if extTrend == 1 and not na(extLastPL) and not na(prevExtPH)
        leg = rngHi - rngLo
        ote62 = rngHi - leg * 0.62
        ote79 = rngHi - leg * 0.79
        pdOTEBull := box.new(bar_index - pdLookback, ote62, bar_index, ote79, bgcolor=pdOTEColor, border_color=pdOTEColor, extend=extend.right)
        if lblAllowHTF
            label.new(bar_index, math.avg(ote62, ote79), "OTE", style=label.style_label_left, color=color.new(pdOTEColor, 30), textcolor=color.black, size=size.tiny)
    else if extTrend == -1 and not na(extLastPH) and not na(prevExtPL)
        leg = rngHi - rngLo
        ote62 = rngLo + leg * 0.62
        ote79 = rngLo + leg * 0.79
        pdOTEBear := box.new(bar_index - pdLookback, ote79, bar_index, ote62, bgcolor=pdOTEColor, border_color=pdOTEColor, extend=extend.right)
        if lblAllowHTF
            label.new(bar_index, math.avg(ote62, ote79), "OTE", style=label.style_label_left, color=color.new(pdOTEColor, 30), textcolor=color.black, size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
//  K) SESSIONS / KILLZONES
// ══════════════════════════════════════════════════════════════════════════════

grpKZ = "🕒 Sessions / Killzones"
showKZ        = input.bool(true,  "Show session highlights", group=grpKZ)
asiaSess      = input.session("0000-0800", "Asia (UTC)",     group=grpKZ)
londonSess    = input.session("0700-1100", "London (UTC)",   group=grpKZ)
nySess        = input.session("1230-1600", "New York (UTC)", group=grpKZ)
asiaColor     = input.color(color.new(#FFA726, 85), "Asia bg",   group=grpKZ)
londonColor   = input.color(color.new(#26A69A, 85), "London bg", group=grpKZ)
nyColor       = input.color(color.new(#42A5F5, 85), "NY bg",     group=grpKZ)

inAsia   = not na(time(timeframe.period, asiaSess,   "UTC"))
inLondon = not na(time(timeframe.period, londonSess, "UTC"))
inNY     = not na(time(timeframe.period, nySess,     "UTC"))

bgcolor(showKZ and inAsia   ? asiaColor   : na, title="Asia")
bgcolor(showKZ and inLondon ? londonColor : na, title="London")
bgcolor(showKZ and inNY     ? nyColor     : na, title="New York")

sessTxt = inLondon and inNY ? "LDN+NY" : inLondon ? "LONDON" : inNY ? "NY" : inAsia ? "ASIA" : "OFF"

// ══════════════════════════════════════════════════════════════════════════════
//  L) PERIODIC LEVELS — D / W / M opens + previous H/L
// ══════════════════════════════════════════════════════════════════════════════

grpLVL = "📍 Periodic Levels"
showOpens     = input.bool(true,  "Show D / W / M opens",     group=grpLVL)
showPrevHL    = input.bool(true,  "Show previous D / W / M H&L", group=grpLVL)
dOpenColor    = input.color(color.new(#FFEE58, 20), "Daily open",   group=grpLVL)
wOpenColor    = input.color(color.new(#FFA726, 20), "Weekly open",  group=grpLVL)
mOpenColor    = input.color(color.new(#EF5350, 20), "Monthly open", group=grpLVL)
prevDColor    = input.color(color.new(#90CAF9, 30), "Previous D H/L", group=grpLVL)
prevWColor    = input.color(color.new(#CE93D8, 30), "Previous W H/L", group=grpLVL)
prevMColor    = input.color(color.new(#FFAB91, 30), "Previous M H/L", group=grpLVL)

dOpen = request.security(syminfo.tickerid, "D", open,  lookahead=barmerge.lookahead_on)
wOpen = request.security(syminfo.tickerid, "W", open,  lookahead=barmerge.lookahead_on)
mOpen = request.security(syminfo.tickerid, "M", open,  lookahead=barmerge.lookahead_on)

prevDH = request.security(syminfo.tickerid, "D", high[1], lookahead=barmerge.lookahead_on)
prevDL = request.security(syminfo.tickerid, "D", low[1],  lookahead=barmerge.lookahead_on)
prevWH = request.security(syminfo.tickerid, "W", high[1], lookahead=barmerge.lookahead_on)
prevWL = request.security(syminfo.tickerid, "W", low[1],  lookahead=barmerge.lookahead_on)
prevMH = request.security(syminfo.tickerid, "M", high[1], lookahead=barmerge.lookahead_on)
prevML = request.security(syminfo.tickerid, "M", low[1],  lookahead=barmerge.lookahead_on)

plot(showOpens  ? dOpen : na, "Daily open",   color=dOpenColor, style=plot.style_linebr, linewidth=1)
plot(showOpens  ? wOpen : na, "Weekly open",  color=wOpenColor, style=plot.style_linebr, linewidth=1)
plot(showOpens  ? mOpen : na, "Monthly open", color=mOpenColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevDH : na, "PDH", color=prevDColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevDL : na, "PDL", color=prevDColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevWH : na, "PWH", color=prevWColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevWL : na, "PWL", color=prevWColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevMH : na, "PMH", color=prevMColor, style=plot.style_linebr, linewidth=1)
plot(showPrevHL ? prevML : na, "PML", color=prevMColor, style=plot.style_linebr, linewidth=1)

// Right-edge labels for periodic levels (only on last bar)
if barstate.islast and lblAllowLevels
    if showOpens
        label.new(bar_index, dOpen, "dO",  style=label.style_label_left, color=color.new(dOpenColor, 30), textcolor=color.black, size=size.tiny)
        label.new(bar_index, wOpen, "wO",  style=label.style_label_left, color=color.new(wOpenColor, 30), textcolor=color.black, size=size.tiny)
        label.new(bar_index, mOpen, "mO",  style=label.style_label_left, color=color.new(mOpenColor, 30), textcolor=color.white, size=size.tiny)
    if showPrevHL
        label.new(bar_index, prevDH, "PDH", style=label.style_label_left, color=color.new(prevDColor, 30), textcolor=color.black, size=size.tiny)
        label.new(bar_index, prevDL, "PDL", style=label.style_label_left, color=color.new(prevDColor, 30), textcolor=color.black, size=size.tiny)
        label.new(bar_index, prevWH, "PWH", style=label.style_label_left, color=color.new(prevWColor, 30), textcolor=color.white, size=size.tiny)
        label.new(bar_index, prevWL, "PWL", style=label.style_label_left, color=color.new(prevWColor, 30), textcolor=color.white, size=size.tiny)
        label.new(bar_index, prevMH, "PMH", style=label.style_label_left, color=color.new(prevMColor, 30), textcolor=color.white, size=size.tiny)
        label.new(bar_index, prevML, "PML", style=label.style_label_left, color=color.new(prevMColor, 30), textcolor=color.white, size=size.tiny)

// ══════════════════════════════════════════════════════════════════════════════
//  M) HTF ORDER BLOCKS
// ══════════════════════════════════════════════════════════════════════════════

grpHTFOB = "🔷 HTF Order Blocks"
showHTFOB    = input.bool(true,  "Show HTF OBs",        group=grpHTFOB)
htfOBTF      = input.timeframe("240", "HTF timeframe",  group=grpHTFOB)
htfOBLen     = input.int(5,      "HTF swing lookback",  group=grpHTFOB, minval=2, maxval=20)
htfOBMax     = input.int(2,      "Max HTF OBs / side",  group=grpHTFOB, minval=1, maxval=5)
htfOBBullCol = input.color(color.new(#1565C0, 60), "HTF Bull OB", group=grpHTFOB)
htfOBBearCol = input.color(color.new(#B71C1C, 60), "HTF Bear OB", group=grpHTFOB)

[htfH, htfL, htfC, htfO] = request.security(syminfo.tickerid, htfOBTF, [high, low, close, open], lookahead=barmerge.lookahead_off)
htfPivH = request.security(syminfo.tickerid, htfOBTF, ta.pivothigh(high, htfOBLen, htfOBLen), lookahead=barmerge.lookahead_off)
htfPivL = request.security(syminfo.tickerid, htfOBTF, ta.pivotlow(low,  htfOBLen, htfOBLen), lookahead=barmerge.lookahead_off)

var float htfLastPH = na
var float htfLastPL = na
if not na(htfPivH)
    htfLastPH := htfPivH
if not na(htfPivL)
    htfLastPL := htfPivL

htfBullBOS = not na(htfLastPH) and htfC > htfLastPH and htfC[1] <= htfLastPH
htfBearBOS = not na(htfLastPL) and htfC < htfLastPL and htfC[1] >= htfLastPL
if htfBullBOS
    htfLastPH := na
if htfBearBOS
    htfLastPL := na

var htfOBBullBoxes = array.new_box()
var htfOBBullHi    = array.new_float()
var htfOBBullLo    = array.new_float()
var htfOBBullMitig = array.new_bool()
var htfOBBearBoxes = array.new_box()
var htfOBBearHi    = array.new_float()
var htfOBBearLo    = array.new_float()
var htfOBBearMitig = array.new_bool()

chartBelowHTF = timeframe.in_seconds() < timeframe.in_seconds(htfOBTF)

if showHTFOB and chartBelowHTF and htfBullBOS
    obIdx = 1
    for k = 1 to math.min(htfOBLen * 2, 50)
        if htfC[k] < htfO[k]
            obIdx := k
            break
    oH = htfH[obIdx]
    oL = htfL[obIdx]
    while array.size(htfOBBullBoxes) >= htfOBMax
        box.delete(array.shift(htfOBBullBoxes))
        array.shift(htfOBBullHi)
        array.shift(htfOBBullLo)
        array.shift(htfOBBullMitig)
    b = box.new(bar_index - obIdx, oH, bar_index, oL, bgcolor=htfOBBullCol, border_color=color.new(htfOBBullCol, 20), border_width=2, extend=extend.right)
    array.push(htfOBBullBoxes, b)
    array.push(htfOBBullHi, oH)
    array.push(htfOBBullLo, oL)
    array.push(htfOBBullMitig, false)
    if lblAllowSwing
        label.new(bar_index, oH, htfOBTF + "OB", style=label.style_label_down, color=color.new(htfOBBullCol, 20), textcolor=color.white, size=size.tiny)

if showHTFOB and chartBelowHTF and htfBearBOS
    obIdx = 1
    for k = 1 to math.min(htfOBLen * 2, 50)
        if htfC[k] > htfO[k]
            obIdx := k
            break
    oH = htfH[obIdx]
    oL = htfL[obIdx]
    while array.size(htfOBBearBoxes) >= htfOBMax
        box.delete(array.shift(htfOBBearBoxes))
        array.shift(htfOBBearHi)
        array.shift(htfOBBearLo)
        array.shift(htfOBBearMitig)
    b = box.new(bar_index - obIdx, oH, bar_index, oL, bgcolor=htfOBBearCol, border_color=color.new(htfOBBearCol, 20), border_width=2, extend=extend.right)
    array.push(htfOBBearBoxes, b)
    array.push(htfOBBearHi, oH)
    array.push(htfOBBearLo, oL)
    array.push(htfOBBearMitig, false)
    if lblAllowSwing
        label.new(bar_index, oL, htfOBTF + "OB", style=label.style_label_up, color=color.new(htfOBBearCol, 20), textcolor=color.white, size=size.tiny)

if showHTFOB and chartBelowHTF
    if array.size(htfOBBullBoxes) > 0
        for i = 0 to array.size(htfOBBullBoxes) - 1
            if not array.get(htfOBBullMitig, i)
                if close < array.get(htfOBBullLo, i)
                    box.delete(array.get(htfOBBullBoxes, i))
                    array.set(htfOBBullMitig, i, true)
    if array.size(htfOBBearBoxes) > 0
        for i = 0 to array.size(htfOBBearBoxes) - 1
            if not array.get(htfOBBearMitig, i)
                if close > array.get(htfOBBearHi, i)
                    box.delete(array.get(htfOBBearBoxes, i))
                    array.set(htfOBBearMitig, i, true)

inHTFBullOB = false
inHTFBearOB = false
if showHTFOB and array.size(htfOBBullBoxes) > 0
    for i = 0 to array.size(htfOBBullBoxes) - 1
        if not array.get(htfOBBullMitig, i)
            if close >= array.get(htfOBBullLo, i) and close <= array.get(htfOBBullHi, i)
                inHTFBullOB := true
                break
if showHTFOB and array.size(htfOBBearBoxes) > 0
    for i = 0 to array.size(htfOBBearBoxes) - 1
        if not array.get(htfOBBearMitig, i)
            if close >= array.get(htfOBBearLo, i) and close <= array.get(htfOBBearHi, i)
                inHTFBearOB := true
                break

// ══════════════════════════════════════════════════════════════════════════════
//  N) HTF FAIR VALUE GAPS
// ══════════════════════════════════════════════════════════════════════════════

grpHTFFVG = "🟫 HTF Fair Value Gaps"
showHTFFVG = input.bool(true,  "Show HTF FVGs", group=grpHTFFVG)
htfFVGTF   = input.timeframe("240", "HTF FVG timeframe", group=grpHTFFVG)
htfFVGBull = input.color(color.new(#00C853, 75), "HTF Bull FVG", group=grpHTFFVG)
htfFVGBear = input.color(color.new(#FF1744, 75), "HTF Bear FVG", group=grpHTFFVG)

[htfH2, htfL2, htfH0, htfL0] = request.security(syminfo.tickerid, htfFVGTF, [high[2], low[2], high, low], lookahead=barmerge.lookahead_off)
htfBullFVG = not na(htfH2) and not na(htfL0) and (htfL0 - htfH2) > 0
htfBearFVG = not na(htfL2) and not na(htfH0) and (htfL2 - htfH0) > 0
inHTFBullFVG = showHTFFVG and htfBullFVG and close >= htfH2 and close <= htfL0
inHTFBearFVG = showHTFFVG and htfBearFVG and close >= htfH0 and close <= htfL2

bgcolor(showHTFFVG and inHTFBullFVG ? color.new(htfFVGBull, 92) : na, title="HTF Bull FVG bg")
bgcolor(showHTFFVG and inHTFBearFVG ? color.new(htfFVGBear, 92) : na, title="HTF Bear FVG bg")

// ══════════════════════════════════════════════════════════════════════════════
//  O) DISPLACEMENT (large-range, FVG-creating candles)
// ══════════════════════════════════════════════════════════════════════════════

grpDISP2 = "⚡ Displacement"
showDisp = input.bool(true,  "Highlight displacement candles",  group=grpDISP2)
dispMul  = input.float(1.7,  "Min × ATR(14)",                   group=grpDISP2, minval=1.0, maxval=5.0, step=0.1)
dispBullCol = input.color(color.new(#69F0AE, 0), "Bull displacement", group=grpDISP2)
dispBearCol = input.color(color.new(#FF5252, 0), "Bear displacement", group=grpDISP2)

isDispBull = candleRange >= dispMul * atr14 and close > open
isDispBear = candleRange >= dispMul * atr14 and close < open

plotshape(showDisp and isDispBull, title="Displacement bull", location=location.belowbar, style=shape.arrowup,   color=dispBullCol, size=size.tiny)
plotshape(showDisp and isDispBear, title="Displacement bear", location=location.abovebar, style=shape.arrowdown, color=dispBearCol, size=size.tiny)
barcolor(showDisp and isDispBull ? color.new(dispBullCol, 50) : showDisp and isDispBear ? color.new(dispBearCol, 50) : na, title="Displacement bar color")

// ══════════════════════════════════════════════════════════════════════════════
//  P) PROXIMITY VISIBILITY (auto-fade far zones)
// ══════════════════════════════════════════════════════════════════════════════

if proxEnable and barstate.isconfirmed
    if showOB and array.size(obBullBoxes) > 0
        for i = 0 to array.size(obBullBoxes) - 1
            if not array.get(obBullMitig, i)
                near = zoneNear(array.get(obBullHi, i), array.get(obBullLo, i))
                box.set_bgcolor(array.get(obBullBoxes, i), near ? obBullColor : fadeColor(obBullColor))
                box.set_border_color(array.get(obBullBoxes, i), near ? obBullColor : fadeColor(obBullColor))
    if showOB and array.size(obBearBoxes) > 0
        for i = 0 to array.size(obBearBoxes) - 1
            if not array.get(obBearMitig, i)
                near = zoneNear(array.get(obBearHi, i), array.get(obBearLo, i))
                box.set_bgcolor(array.get(obBearBoxes, i), near ? obBearColor : fadeColor(obBearColor))
                box.set_border_color(array.get(obBearBoxes, i), near ? obBearColor : fadeColor(obBearColor))
    if showBB and array.size(bbBullBoxes) > 0
        for i = 0 to array.size(bbBullBoxes) - 1
            near = zoneNear(array.get(bbBullHi, i), array.get(bbBullLo, i))
            box.set_bgcolor(array.get(bbBullBoxes, i), near ? bbBullColor : fadeColor(bbBullColor))
            box.set_border_color(array.get(bbBullBoxes, i), near ? bbBullColor : fadeColor(bbBullColor))
    if showBB and array.size(bbBearBoxes) > 0
        for i = 0 to array.size(bbBearBoxes) - 1
            near = zoneNear(array.get(bbBearHi, i), array.get(bbBearLo, i))
            box.set_bgcolor(array.get(bbBearBoxes, i), near ? bbBearColor : fadeColor(bbBearColor))
            box.set_border_color(array.get(bbBearBoxes, i), near ? bbBearColor : fadeColor(bbBearColor))
    if showRB and array.size(rbBullBoxes) > 0
        for i = 0 to array.size(rbBullBoxes) - 1
            if not array.get(rbBullMitig, i)
                near = zoneNear(array.get(rbBullHi, i), array.get(rbBullLo, i))
                box.set_bgcolor(array.get(rbBullBoxes, i), near ? rbBullColor : fadeColor(rbBullColor))
                box.set_border_color(array.get(rbBullBoxes, i), near ? rbBullColor : fadeColor(rbBullColor))
    if showRB and array.size(rbBearBoxes) > 0
        for i = 0 to array.size(rbBearBoxes) - 1
            if not array.get(rbBearMitig, i)
                near = zoneNear(array.get(rbBearHi, i), array.get(rbBearLo, i))
                box.set_bgcolor(array.get(rbBearBoxes, i), near ? rbBearColor : fadeColor(rbBearColor))
                box.set_border_color(array.get(rbBearBoxes, i), near ? rbBearColor : fadeColor(rbBearColor))
    if showFVG and array.size(fvgBullBoxes) > 0
        for i = 0 to array.size(fvgBullBoxes) - 1
            if not array.get(fvgBullDead, i)
                near = zoneNear(array.get(fvgBullTop, i), array.get(fvgBullBot, i))
                box.set_bgcolor(array.get(fvgBullBoxes, i), near ? fvgBullColor : fadeColor(fvgBullColor))
                box.set_border_color(array.get(fvgBullBoxes, i), near ? fvgBullColor : fadeColor(fvgBullColor))
    if showFVG and array.size(fvgBearBoxes) > 0
        for i = 0 to array.size(fvgBearBoxes) - 1
            if not array.get(fvgBearDead, i)
                near = zoneNear(array.get(fvgBearTop, i), array.get(fvgBearBot, i))
                box.set_bgcolor(array.get(fvgBearBoxes, i), near ? fvgBearColor : fadeColor(fvgBearColor))
                box.set_border_color(array.get(fvgBearBoxes, i), near ? fvgBearColor : fadeColor(fvgBearColor))
    if showVI and array.size(viBullBoxes) > 0
        for i = 0 to array.size(viBullBoxes) - 1
            if not array.get(viBullDead, i)
                near = zoneNear(array.get(viBullTop, i), array.get(viBullBot, i))
                box.set_bgcolor(array.get(viBullBoxes, i), near ? viBullColor : fadeColor(viBullColor))
                box.set_border_color(array.get(viBullBoxes, i), near ? viBullColor : fadeColor(viBullColor))
    if showVI and array.size(viBearBoxes) > 0
        for i = 0 to array.size(viBearBoxes) - 1
            if not array.get(viBearDead, i)
                near = zoneNear(array.get(viBearTop, i), array.get(viBearBot, i))
                box.set_bgcolor(array.get(viBearBoxes, i), near ? viBearColor : fadeColor(viBearColor))
                box.set_border_color(array.get(viBearBoxes, i), near ? viBearColor : fadeColor(viBearColor))

// ══════════════════════════════════════════════════════════════════════════════
//  Q) DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

grpDASH = "📊 Dashboard"
showDashboard = input.bool(true, "Show Dashboard", group=grpDASH)
dashPosIn     = input.string("top_right", "Position", group=grpDASH,
     options=["top_right","top_left","middle_right","middle_left","bottom_right","bottom_left"])
dashSizeIn    = input.string("small", "Text size", group=grpDASH, options=["tiny","small","normal","large"])

dashPos = dashPosIn == "top_right"     ? position.top_right     :
          dashPosIn == "top_left"      ? position.top_left      :
          dashPosIn == "middle_right"  ? position.middle_right  :
          dashPosIn == "middle_left"   ? position.middle_left   :
          dashPosIn == "bottom_right"  ? position.bottom_right  :
          position.bottom_left

dashSz = dashSizeIn == "tiny"   ? size.tiny   :
         dashSizeIn == "small"  ? size.small  :
         dashSizeIn == "large"  ? size.large  :
         size.normal

// Premium / discount classification of current close
inPremium  = close > rngMid
inDiscount = close < rngMid
priceLoc   = math.abs(close - rngMid) / (rngHi - rngLo) * 100.0  // % from EQ

// Find nearest unmitigated OB
nearestBullOBdist = 1e10
nearestBearOBdist = 1e10
if array.size(obBullBoxes) > 0
    for i = 0 to array.size(obBullBoxes) - 1
        if not array.get(obBullMitig, i)
            mid = math.avg(array.get(obBullHi, i), array.get(obBullLo, i))
            d   = math.abs(close - mid)
            if d < nearestBullOBdist
                nearestBullOBdist := d
if array.size(obBearBoxes) > 0
    for i = 0 to array.size(obBearBoxes) - 1
        if not array.get(obBearMitig, i)
            mid = math.avg(array.get(obBearHi, i), array.get(obBearLo, i))
            d   = math.abs(close - mid)
            if d < nearestBearOBdist
                nearestBearOBdist := d

// Sweep recency (in bars)
eqlAge = bar_index - lastEQLSweepBar
eqhAge = bar_index - lastEQHSweepBar

// Counts
countOBBull  = 0
countOBBear  = 0
countFVGBull = 0
countFVGBear = 0
countBBBull  = 0
countBBBear  = 0
if array.size(obBullBoxes) > 0
    for i = 0 to array.size(obBullBoxes) - 1
        if not array.get(obBullMitig, i)
            countOBBull += 1
if array.size(obBearBoxes) > 0
    for i = 0 to array.size(obBearBoxes) - 1
        if not array.get(obBearMitig, i)
            countOBBear += 1
if array.size(fvgBullBoxes) > 0
    for i = 0 to array.size(fvgBullBoxes) - 1
        if not array.get(fvgBullDead, i)
            countFVGBull += 1
if array.size(fvgBearBoxes) > 0
    for i = 0 to array.size(fvgBearBoxes) - 1
        if not array.get(fvgBearDead, i)
            countFVGBear += 1
if array.size(bbBullBoxes) > 0
    for i = 0 to array.size(bbBullBoxes) - 1
        if not array.get(bbBullMitig, i)
            countBBBull += 1
if array.size(bbBearBoxes) > 0
    for i = 0 to array.size(bbBearBoxes) - 1
        if not array.get(bbBearMitig, i)
            countBBBear += 1

var table dash = table.new(dashPos, 2, 14,
     bgcolor=color.new(#0A0A0A, 10),
     border_width=1, frame_color=color.new(color.gray, 50), frame_width=1,
     border_color=color.new(color.gray, 70))

if showDashboard and barstate.islast
    headerBg = color.new(#1A1A2E, 0)
    table.cell(dash, 0, 0, "SMC v18", text_color=color.white, bgcolor=headerBg, text_size=dashSz)
    table.cell(dash, 1, 0, "Complete suite", text_color=color.gray, bgcolor=headerBg, text_size=size.tiny)

    // Internal trend
    intTrTxt = intTrend == 1 ? "▲ BULL" : intTrend == -1 ? "▼ BEAR" : "—"
    intTrCol = intTrend == 1 ? bullStructColor : intTrend == -1 ? bearStructColor : color.gray
    table.cell(dash, 0, 1, "Internal trend", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 1, intTrTxt,         text_color=intTrCol,    text_size=dashSz)

    // External trend
    extTrTxt = extTrend == 1 ? "▲ BULL" : extTrend == -1 ? "▼ BEAR" : "—"
    extTrCol = extTrend == 1 ? bullStructColor : extTrend == -1 ? bearStructColor : color.gray
    table.cell(dash, 0, 2, "External trend", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 2, extTrTxt,         text_color=extTrCol,    text_size=dashSz)

    // PD location
    pdTxt = inPremium ? ("PREMIUM " + str.tostring(priceLoc, "#.0") + "%") : inDiscount ? ("DISCOUNT " + str.tostring(priceLoc, "#.0") + "%") : "EQUILIBRIUM"
    pdCol = inPremium ? pdPremColor : inDiscount ? pdDiscColor : color.gray
    table.cell(dash, 0, 3, "PD location", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 3, pdTxt,         text_color=color.new(pdCol, 0), text_size=dashSz)

    // Session
    sessCol = inLondon and inNY ? color.new(#00E676, 0) : inLondon ? londonColor : inNY ? nyColor : inAsia ? asiaColor : color.gray
    table.cell(dash, 0, 4, "Session",  text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 4, sessTxt,    text_color=color.new(sessCol, 0), text_size=dashSz)

    // OB count
    obTxt = "▲" + str.tostring(countOBBull) + "  ▼" + str.tostring(countOBBear)
    table.cell(dash, 0, 5, "Active OBs", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 5, obTxt,        text_color=color.new(color.yellow, 0), text_size=dashSz)

    // FVG count
    fvgTxt = "▲" + str.tostring(countFVGBull) + "  ▼" + str.tostring(countFVGBear)
    table.cell(dash, 0, 6, "Active FVGs", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 6, fvgTxt,         text_color=color.new(color.yellow, 0), text_size=dashSz)

    // BB count
    bbTxt = "▲" + str.tostring(countBBBull) + "  ▼" + str.tostring(countBBBear)
    table.cell(dash, 0, 7, "Active BBs", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 7, bbTxt,        text_color=color.new(color.yellow, 0), text_size=dashSz)

    // Sweep status
    sweepTxt = ""
    if eqlAge <= 30
        sweepTxt := "💧EQL " + str.tostring(eqlAge) + "b"
    if eqhAge <= 30
        sweepTxt := sweepTxt == "" ? "💧EQH " + str.tostring(eqhAge) + "b" : sweepTxt + " | EQH " + str.tostring(eqhAge) + "b"
    if sweepTxt == ""
        sweepTxt := "—"
    table.cell(dash, 0, 8, "Recent sweep", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 8, sweepTxt,        text_color=color.new(#00BCD4, 0), text_size=dashSz)

    // HTF context
    htfTxt = inHTFBullOB ? "in BULL OB" : inHTFBearOB ? "in BEAR OB" : inHTFBullFVG ? "in BULL FVG" : inHTFBearFVG ? "in BEAR FVG" : "—"
    htfCol = inHTFBullOB or inHTFBullFVG ? color.new(#00C853, 0) : inHTFBearOB or inHTFBearFVG ? color.new(#F23645, 0) : color.gray
    table.cell(dash, 0, 9, "HTF (" + htfOBTF + ")", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 9, htfTxt,                  text_color=color.new(htfCol, 0), text_size=dashSz)

    // Displacement
    dispTxt = isDispBull ? "▲ bull disp" : isDispBear ? "▼ bear disp" : "—"
    dispCol = isDispBull ? color.new(#00E676, 0) : isDispBear ? color.new(#FF5252, 0) : color.gray
    table.cell(dash, 0, 10, "Displacement", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 10, dispTxt,         text_color=color.new(dispCol, 0), text_size=dashSz)

    // Nearest OB distance (% from close)
    nearOBTxt = ""
    if nearestBullOBdist < 1e10 and (nearestBullOBdist <= nearestBearOBdist)
        nearOBTxt := "Bull " + str.tostring(nearestBullOBdist / close * 100.0, "#.00") + "%"
    else if nearestBearOBdist < 1e10
        nearOBTxt := "Bear " + str.tostring(nearestBearOBdist / close * 100.0, "#.00") + "%"
    else
        nearOBTxt := "—"
    table.cell(dash, 0, 11, "Nearest OB", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 11, nearOBTxt,     text_color=color.new(color.gray, 0), text_size=dashSz)

    // Killzones countdown style — simple state
    table.cell(dash, 0, 12, "Range", text_color=color.white, text_size=dashSz)
    rngTxt = "H " + str.tostring(rngHi, format.mintick) + "  L " + str.tostring(rngLo, format.mintick)
    table.cell(dash, 1, 12, rngTxt, text_color=color.new(color.gray, 0), text_size=size.tiny)

    table.cell(dash, 0, 13, "ATR(14)", text_color=color.white, text_size=dashSz)
    table.cell(dash, 1, 13, str.tostring(atr14, format.mintick), text_color=color.new(color.gray, 0), text_size=dashSz)

// ══════════════════════════════════════════════════════════════════════════════
//  ALERTS
// ══════════════════════════════════════════════════════════════════════════════

alertcondition(intBullBOS,    "Internal Bull BOS",   "Internal Bullish BOS")
alertcondition(intBearBOS,    "Internal Bear BOS",   "Internal Bearish BOS")
alertcondition(intBullCHoCH,  "Internal Bull CHoCH", "Internal Bullish CHoCH")
alertcondition(intBearCHoCH,  "Internal Bear CHoCH", "Internal Bearish CHoCH")
alertcondition(extBullBOS,    "External Bull BOS",   "External Bullish BOS")
alertcondition(extBearBOS,    "External Bear BOS",   "External Bearish BOS")
alertcondition(extBullCHoCH,  "External Bull CHoCH", "External Bullish CHoCH")
alertcondition(extBearCHoCH,  "External Bear CHoCH", "External Bearish CHoCH")
alertcondition(isBullFVG,     "Bull FVG",            "Bullish Fair Value Gap")
alertcondition(isBearFVG,     "Bear FVG",            "Bearish Fair Value Gap")
alertcondition(sweepEQL,      "EQL sweep",           "Sell-side liquidity swept")
alertcondition(sweepEQH,      "EQH sweep",           "Buy-side liquidity swept")
alertcondition(isDispBull,    "Bull displacement",   "Bullish displacement candle")
alertcondition(isDispBear,    "Bear displacement",   "Bearish displacement candle")
