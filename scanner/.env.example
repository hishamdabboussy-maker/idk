# Copy to .env and edit. The app reads these on startup.

# Login (single-user MVP). CHANGE THESE.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=please-change-this-to-a-long-random-string

# Scanner behaviour
SCAN_INTERVAL_SECONDS=120          # how often the background scanner refreshes
DEX_QUERIES=SOL/USDC,WETH/USDC,bonk,pepe   # comma-sep DexScreener search terms to crawl
CHAINS=solana,ethereum,base        # only keep pairs on these chains (comma-sep, blank = all)
MIN_LIQUIDITY_USD=15000            # ignore pairs with less liquidity than this
MAX_PAIR_AGE_HOURS=720             # ignore pairs older than this (30d). 0 = no limit

# Hyperliquid whale wallets to track (comma-sep 0x addresses, optional)
HL_WHALE_ADDRESSES=

# Optional external rug-check enrichment (best-effort, off by default)
USE_RUGCHECK=false
