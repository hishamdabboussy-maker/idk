# Copy to .env and edit. The app reads these on startup.

# Login (single-user MVP). CHANGE THESE.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=please-change-this-to-a-long-random-string

# Scanner behaviour (Binance-listed USDT spot pairs only)
SCAN_INTERVAL_SECONDS=120       # how often the background scanner refreshes
MIN_QUOTE_VOL_USD=2000000       # ignore pairs with < this 24h USDT volume
ENRICH_TOP_N=120                # how many top-volume symbols to pull klines for
MAX_RESULTS=100                 # max rows kept after scoring
KLINE_INTERVAL=1h               # candle interval for volume-surge / momentum (e.g. 15m,1h,4h)
BIAS_MODE=reversion             # direction logic: "reversion" (near low=LONG, near high=SHORT) or "momentum" (near high=LONG, near low=SHORT)

# --- Funded / prop account risk model (each idea is sized to these rules) ---
ACCOUNT_SIZE_USD=100000         # your funded account size
RISK_PER_TRADE_PCT=0.5          # % of account risked per trade (stop-out loss)
MAX_DAILY_LOSS_PCT=4            # firm's max daily loss limit
MAX_TOTAL_DD_PCT=8              # firm's max total drawdown
MAX_LEVERAGE=5                  # firm's leverage cap
MIN_RR=1.5                      # reject setups below this reward:risk
MAX_HOLD_HOURS=0                # flag setups whose ETA exceeds this (0=off; e.g. no-overnight rules)

# Hyperliquid whale wallets to track (comma-sep 0x addresses, optional)
HL_WHALE_ADDRESSES=
# If no addresses above, auto-discover whales from Hyperliquid's public leaderboard
WHALE_AUTODISCOVER=true
WHALE_TOP_N=25                  # how many top leaderboard wallets to scan
WHALE_MIN_USD=250000            # ignore whale positions smaller than this
WHALE_RECENT_DAYS=2             # only count positions opened/added within N days (0 = any age)
