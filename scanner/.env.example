# Copy to .env and edit. The app reads these on startup.

# Login (single-user MVP). CHANGE THESE.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
SESSION_SECRET=please-change-this-to-a-long-random-string

# Scanner behaviour (Binance-listed USDT spot pairs only)
SCAN_INTERVAL_SECONDS=120       # how often the background scanner refreshes
MIN_QUOTE_VOL_USD=2000000       # ignore pairs with < this 24h USDT volume
ENRICH_TOP_N=120                # how many top-volume symbols to pull klines for
MAX_RESULTS=100                 # max rows kept after scoring
KLINE_INTERVAL=1h               # candle interval for volume-surge / momentum (e.g. 15m,1h,4h)
BIAS_MODE=reversion             # direction logic: "reversion" (near low=LONG, near high=SHORT) or "momentum" (near high=LONG, near low=SHORT)

# Hyperliquid whale wallets to track (comma-sep 0x addresses, optional)
HL_WHALE_ADDRESSES=
